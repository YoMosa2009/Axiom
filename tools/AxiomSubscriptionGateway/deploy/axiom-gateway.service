[Unit]
Description=Axiom Managed Subscription & Inference Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=axiom
Group=axiom
WorkingDirectory=/opt/axiom-gateway
EnvironmentFile=/etc/axiom-gateway/gateway.env
ExecStart=/opt/axiom-gateway/AxiomSubscriptionGateway --serve-accounts
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/axiom-gateway

[Install]
WantedBy=multi-user.target
