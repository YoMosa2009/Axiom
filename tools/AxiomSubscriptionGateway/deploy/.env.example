# Axiom Cloud Subscription Gateway — Production Environment Template
# Copy to `.env` on your server (mode 0600, owned by the gateway service user). NEVER commit `.env`.

# Network & Public Origin
AXIOM_PORT=5198
AXIOM_ACCOUNTS_PUBLIC_ORIGIN=https://api.example.com

# Persistent SQLite DB & Verified Backups
AXIOM_ACCOUNTS_DB=/var/lib/axiom-gateway/axiom-accounts.sqlite
AXIOM_BACKUP_DIR=/var/lib/axiom-gateway/backups
AXIOM_BACKUP_INTERVAL_HOURS=6

# Stripe Live Billing (auto-generated by `AxiomSubscriptionGateway --provision-live <origin> --write-env`)
AXIOM_STRIPE_SECRET_KEY=sk_live_REPLACE_ME
AXIOM_STRIPE_PRICE=price_REPLACE_ME
AXIOM_STRIPE_PORTAL_CONFIGURATION=bpc_REPLACE_ME
AXIOM_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Monthly Credit Allowance ($5.25 = 5250000 micro-USD out of $9.00 subscription)
AXIOM_MONTHLY_ALLOWANCE_MICROS=5250000

# Upstream AI Inference Provider
# Default routes DeepSeek 4.1F-1017 via OpenRouter (verify commercial terms / enterprise clearance with OpenRouter).
# Optional direct alternatives: `digitalocean` or `deepseek`
AXIOM_UPSTREAM_PROVIDER=openrouter
AXIOM_UPSTREAM_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
# Optional overrides (defaults are preconfigured per provider):
# AXIOM_UPSTREAM_MODEL=deepseek/deepseek-v4.1-flash-1017
# AXIOM_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1/

# Sign-In Verification Email (SMTP)
AXIOM_SMTP_HOST=smtp.example.com
AXIOM_SMTP_PORT=587
AXIOM_SMTP_USERNAME=postmaster@example.com
AXIOM_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
AXIOM_SMTP_FROM=Axiom Cloud <noreply@example.com>
