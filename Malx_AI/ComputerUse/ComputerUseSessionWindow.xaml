<Window x:Class="Malx_AI.ComputerUse.ComputerUseSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computer Use"
        Icon="pack://application:,,,/Malx_AI;component/Assets/AxiomLogo.ico"
        Width="336"
        Height="432"
        MinWidth="288"
        MinHeight="320"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="False">
    <Window.Resources>
        <!-- Axiom's own palette. This panel previously used a cool blue-grey scheme of its own,
             which read as a different product floating over the app it belongs to. -->
        <SolidColorBrush x:Key="HudShell" Color="#1A1917"/>
        <SolidColorBrush x:Key="HudSurface" Color="#131211"/>
        <SolidColorBrush x:Key="HudBorder" Color="#302D2A"/>
        <SolidColorBrush x:Key="HudText" Color="#EDE8E3"/>
        <SolidColorBrush x:Key="HudMuted" Color="#B0A89F"/>
        <SolidColorBrush x:Key="HudFaint" Color="#8C857C"/>
        <SolidColorBrush x:Key="HudAccent" Color="#B8924A"/>
        <SolidColorBrush x:Key="HudStop" Color="#A8443A"/>
        <SolidColorBrush x:Key="HudStopBorder" Color="#C2564A"/>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource HudText}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{StaticResource HudFaint}" StrokeThickness="1.5" Fill="{StaticResource HudSurface}"/>
                                <Ellipse x:Name="CheckMark"
                                         Width="6"
                                         Height="6"
                                         Fill="{StaticResource HudAccent}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One activity line: a short status word, then the sentence. The controller's own
             "[TAG] text" strings are unchanged — this only decides how they are shown. -->
        <DataTemplate x:Key="LogEntryTemplate">
            <StackPanel Margin="0,0,0,9">
                <Border Background="{Binding BadgeBackground}"
                        CornerRadius="4"
                        Padding="5,1"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBadge}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Badge}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{Binding BadgeForeground}"/>
                </Border>
                <TextBlock Text="{Binding Body}"
                           FontSize="11"
                           Foreground="{StaticResource HudMuted}"
                           TextWrapping="Wrap"
                           LineHeight="16"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource HudShell}"
            BorderBrush="{StaticResource HudBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="11">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.42"/>
        </Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="1,0,1,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button x:Name="StopButton"
                        DockPanel.Dock="Right"
                        Content="Stop"
                        Width="58"
                        Height="24"
                        Click="StopButton_Click"
                        Background="{StaticResource HudStop}"
                        Foreground="#FFFFFF"
                        BorderBrush="{StaticResource HudStopBorder}"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource HudAccent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Computer Use"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HudText}"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText"
                               Text="Idle"
                               FontSize="10"
                               Foreground="{StaticResource HudFaint}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="1,0,1,8">
                <TextBlock Text="MODE"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HudFaint}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <RadioButton x:Name="AskModeRadio"
                             Content="Ask"
                             GroupName="ComputerUseMode"
                             IsChecked="True"
                             Checked="ModeRadio_Checked"
                             Margin="0,0,10,0"/>
                <RadioButton x:Name="AutopilotModeRadio"
                             Content="Autopilot"
                             GroupName="ComputerUseMode"
                             Checked="ModeRadio_Checked"/>
            </StackPanel>

            <Border DockPanel.Dock="Bottom"
                    x:Name="PermissionPanel"
                    Background="{StaticResource HudSurface}"
                    BorderBrush="{StaticResource HudAccent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="9"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="PermissionHeading" Text="Permission needed"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource HudAccent}"/>
                    <TextBlock x:Name="PendingActionText"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource HudText}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,7"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DenyActionButton" Content="Deny"
                                Width="62"
                                Height="24"
                                Margin="0,0,6,0"
                                Click="DenyButton_Click"
                                Background="#211F1D"
                                Foreground="{StaticResource HudText}"
                                BorderBrush="{StaticResource HudBorder}"/>
                        <Button x:Name="AllowActionButton" Content="Allow"
                                Width="68"
                                Height="24"
                                Click="AllowButton_Click"
                                Background="{StaticResource HudAccent}"
                                Foreground="#1A1917"
                                BorderBrush="#D2A85C"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource HudSurface}"
                    BorderBrush="{StaticResource HudBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="9">
                <ScrollViewer x:Name="LogScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <TextBlock x:Name="EmptyLogHint"
                                   Text="Waiting for the first screenshot…"
                                   FontSize="11"
                                   Foreground="{StaticResource HudFaint}"
                                   TextWrapping="Wrap"/>
                        <ItemsControl x:Name="LogEntries"
                                      ItemTemplate="{StaticResource LogEntryTemplate}"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</Window>
