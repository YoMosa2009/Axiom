<Window x:Class="Malx_AI.ChatRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename chat" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" ShowInTaskbar="False"
        Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}">
    <Border Margin="18" Padding="20" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Rename chat" FontSize="24" FontFamily="Georgia"/>
            <TextBlock Grid.Row="1" Text="Use a short name that will be easy to search later." TextWrapping="Wrap" Margin="0,5,0,12" FontSize="11" Foreground="{DynamicResource DarkSecondaryBrush}"/>
            <TextBox x:Name="ChatNameBox" Grid.Row="2" Height="34" MaxLength="80" Padding="9,6"
                     Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"
                     KeyDown="ChatNameBox_KeyDown"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Click="Cancel_Click" MinWidth="82" Padding="12,7" Margin="0,0,8,0"
                        Background="{DynamicResource NotebookSurfaceBrush}" Foreground="{DynamicResource DarkSecondaryBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}"/>
                <Button Content="Rename" Click="Rename_Click" MinWidth="88" Padding="12,7"
                        Background="{DynamicResource PrimaryAccentBrush}" Foreground="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
