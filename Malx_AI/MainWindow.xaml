                                                         <Button x:Name="Edios15ModelButton" Content="Edios 1.5" Click="Edios15ModelButton_Click" Style="{StaticResource ModeSelectorPillButtonStyle}" ToolTip="Use Google Gemma 4 31B (free)" Margin="0,0,2,0"/>
                                                         <Button x:Name="Hepha25CoderModelButton" Content="Hepha 2.5 Coder" Click="Hepha25CoderModelButton_Click" Style="{StaticResource ModeSelectorPillButtonStyle}" ToolTip="Use NVIDIA Nemotron 3 Ultra (free)" Margin="0,0,2,0"/>
                                                         <Button x:Name="Threnody10ModelButton" Content="Threnody 1.0" Click="Threnody10ModelButton_Click" Style="{StaticResource ModeSelectorPillButtonStyle}" ToolTip="Use DeepSeek: DeepSeek V4.1 Flash"/>
                                                         <Button x:Name="CustomEndpointModelButton" Content="Hybrid Local" Click="CustomEndpointModelButton_Click" Style="{StaticResource ModeSelectorPillButtonStyle}" ToolTip="Your local inference server" Visibility="Collapsed"/>
                                                     </StackPanel>
                                                 </Border>
                                                <StackPanel x:Name="ComposerRunActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
