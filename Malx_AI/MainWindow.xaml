<Window x:Class="Malx_AI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Malx_AI"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Axiom - Chat" FontFamily="{DynamicResource AppUiFont}" Height="900" Width="1600" MinWidth="1040" MinHeight="640" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AxiomLogo.ico"
        AllowsTransparency="False" Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <QuadraticEase x:Key="FastEaseOut" EasingMode="EaseOut"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ActiveNavigationTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="CodeBlockToggleButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InactiveNavigationTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="NavigationGlyphStyle" TargetType="Path">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.45"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- ═══ Sidebar ═══
             One visual language for the Chat and Workplace sidebars: flat icon rows, a quiet search
             field, and list items that show their actions (⋯) on hover. Icons come from the Windows
             icon font, so they recolour with the theme like text. -->
        <FontFamily x:Key="AxiomIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="SidebarIconTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AxiomIconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="Auto"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <!-- Text inside a sidebar button. Content set in XAML or code takes its implicit style from
             the logical tree, not the button template, so the colour binding has to be explicit. -->
        <Style x:Key="SidebarRowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="LineHeight" Value="Auto"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <Style x:Key="SidebarRowButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="LineHeight" Value="Auto"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "New chat" / "New workplace": the one emphasised row at the top of the sidebar. -->
        <Style x:Key="SidebarPrimaryRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarRowButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- Chat and workplace list items. The left rail shows the BorderBrush, which code sets to
             the accent on the active item and leaves transparent otherwise. -->
        <Style x:Key="SidebarListItemButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,0,4,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border Width="3" Height="16" HorizontalAlignment="Left" Margin="1,0,0,0" CornerRadius="2"
                                    Background="{TemplateBinding BorderBrush}"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="LineHeight" Value="Auto"/>
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The ⋯ button inside a list item: hidden until the item is hovered or focused. -->
        <Style x:Key="SidebarItemMoreButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="ToolTip" Value="More actions"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="&#xE712;" FontFamily="{StaticResource AxiomIconFont}" FontSize="13" LineHeight="Auto"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="Auto"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="12,14,0,4"/>
        </Style>

        <Style x:Key="SidebarSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSearchFieldStyle" TargetType="Border">
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChatInputIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal line-icon buttons under chat messages. Icons are 16x16 stroked paths drawn
             from the button's foreground, so hover/disabled states recolour them with no extra art. -->
        <Style x:Key="MessageActionIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MessageActionIconPathStyle" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <Style x:Key="ChatInputUtilityButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1B19"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TokenMeterProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot"
                              Height="{TemplateBinding Height}"
                              SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="2"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatInputToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource ChatInputIconButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="Opacity" Value="1">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Opacity" Value="1"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Composer tool toggle (Web). Matches the Skills/Plugins pills when off and takes a
             gold tint when on, instead of dimming the whole control so its label greys out. -->
        <Style x:Key="ChatComposerToggleStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter Property="Foreground" Value="#E8C67C"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#453A2B"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop generation. A quiet round button while idle; it gains a ring and lifts to the
             accent on hover once a response is actually running. -->
        <Style x:Key="ChatInputStopButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#332F2B"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <!-- Still a disc, just a quiet one: a bare glyph on the background
                                     reads as a stray mark rather than an unavailable button. -->
                                <Setter Property="Background" Value="#201E1C"/>
                                <Setter Property="BorderBrush" Value="#2E2B28"/>
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatInputSendButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C79F52"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#A8823F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <!-- Nothing typed yet: the button recedes instead of inviting a click. -->
                            <DataTrigger Binding="{Binding ElementName=InputBox, Path=Text}" Value="">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3328"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource NotebookBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Path x:Name="DropDownArrow"
                                                      Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Fill="{DynamicResource MutedTextBrush}"
                                                      Stretch="Uniform"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                                <Setter TargetName="DropDownArrow" Property="Fill" Value="{DynamicResource NotebookTextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                <Setter TargetName="DropDownArrow" Property="Fill" Value="{DynamicResource AccentBrightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              Margin="10,0,30,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource NotebookBackgroundBrush}"
                                        BorderBrush="{DynamicResource NotebookBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatModeSelectorButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4,6,3"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,1"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource NotebookBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="UnifiedTitleBar" Grid.Row="0" Grid.ColumnSpan="2" MinHeight="48" Padding="0,4"
                Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="TitleBarNavigationHost" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="8,0" FontSize="12">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=WorkplaceViewControl}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ContentControl x:Name="WorkplaceTitleBarHost" Grid.Column="1" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch"
                                Visibility="{Binding Visibility, ElementName=WorkplaceViewControl}"/>
                <!-- Project Canvas toggle for Normal Chat (Workplace hosts its own canvas toggle in WorkplaceTitleBarHost). -->
                <Border Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=WorkplaceViewControl}" Value="Visible">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ToggleButton x:Name="ProjectCanvasToggleButton"
                                  Width="32" Height="32" VerticalAlignment="Center"
                                  Checked="ProjectCanvasToggle_Changed"
                                  Unchecked="ProjectCanvasToggle_Changed"
                                  ToolTip="Show Project Canvas"
                                  AutomationProperties.Name="Toggle Project Canvas">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.84"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                        <!-- Panel-right glyph: window outline with the canvas column on its right edge. -->
                        <Grid Width="16" Height="14">
                            <Border CornerRadius="3" BorderThickness="1.4"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            <Border Width="5" HorizontalAlignment="Right" Margin="0,1.4,1.4,1.4" CornerRadius="0,1.6,1.6,0"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0.35"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </ToggleButton>
                </Border>
            </Grid>
        </Border>

        <!-- MODE TABS (relocated into SidebarBorder top header; kept collapsed so UI expands to top edge) -->
        <Border x:Name="NavigationBar" Grid.Row="0" Grid.ColumnSpan="2" Visibility="Collapsed" Height="0" Padding="0" Margin="0" BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">

                    <!-- Sidebar collapse, Workplace only: hides the Axiom / Workplace Chats column
                         so the council gets the extra width. Other tabs always show the sidebar. -->
                    <Button x:Name="SidebarCollapseButton" Width="28" Height="28" Margin="10,0,0,0" VerticalAlignment="Center"
                            Click="SidebarCollapseButton_Click" Visibility="Collapsed"
                            ToolTip="Hide sidebar (Ctrl+B)" AutomationProperties.Name="Toggle sidebar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.84"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <!-- Chevron points left while the sidebar is open; flipped when collapsed. -->
                        <Path x:Name="SidebarCollapseGlyph" Width="8" Height="12" Stretch="Uniform"
                              Data="M6,1 L1.5,6 L6,11" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1"/>
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LEFT SIDEBAR
             Same layout on every tab: wordmark, one "New …" row, search, the list, and a short
             footer. Chat and Workplace each own their row, search field and list; the tab switch
             only flips which set is visible. Per-item actions (rename, pin, delete) live in the
             item's ⋯ menu, so there are no separate Delete buttons. -->
        <Border x:Name="SidebarBorder" Grid.Row="1" Grid.Column="0" Background="{DynamicResource NotebookSurfaceBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource NotebookBorderBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,14">
                    <Rectangle Height="1" Fill="{DynamicResource NotebookBorderBrush}" Margin="4,0,4,8"/>
                    <Button x:Name="DownloadDefaultModelSidebarButton" Click="DownloadDefaultModel_Click" Style="{StaticResource SidebarRowButtonStyle}"
                            ToolTip="See which local models fit this computer and download one" AutomationProperties.Name="Download a model">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource SidebarIconTextStyle}"/>
                            <TextBlock Text="Download a model" Style="{StaticResource SidebarRowLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportModelSidebarButton" Click="ImportModel_Click" Style="{StaticResource SidebarRowButtonStyle}"
                            ToolTip="Load a GGUF model file you already have" AutomationProperties.Name="Import a model file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" Style="{StaticResource SidebarIconTextStyle}"/>
                            <TextBlock Text="Import a model file" Style="{StaticResource SidebarRowLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsSidebarButton" Click="Settings_Click" Style="{StaticResource SidebarRowButtonStyle}" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource SidebarIconTextStyle}"/>
                            <TextBlock Text="Settings" Style="{StaticResource SidebarRowLabelStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="8,12,8,0">
                    <Grid x:Name="SidebarNavigationHeader" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="2"
                                CornerRadius="8" Background="{DynamicResource NotebookSurfaceBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ChatTabButton" Width="28" Height="24" Click="SwitchToChat_Click"
                                        Style="{StaticResource ActiveNavigationTabButtonStyle}" ToolTip="Chat" AutomationProperties.Name="Chat">
                                    <Path Style="{StaticResource NavigationGlyphStyle}" Data="M9,11 H5 L2,14 V7 A5,5 0 0 1 7,2 H9 A5,5 0 0 1 13,5 M16,14 L18,16 V10 A4,4 0 0 0 10,10 A4,4 0 0 0 14,14 Z"/>
                                </Button>
                                <Button x:Name="WorkplaceTabButton" Width="28" Height="24" Click="SwitchToWorkplace_Click"
                                        Style="{StaticResource InactiveNavigationTabButtonStyle}" ToolTip="Workplace" AutomationProperties.Name="Workplace">
                                    <Path Style="{StaticResource NavigationGlyphStyle}" Data="M5,5 L1,9 L5,13 M13,5 L17,9 L13,13 M11,2 L7,16"/>
                                </Button>
                                <Button x:Name="PersonaTabButton" Width="28" Height="24" Click="SwitchToPersona_Click"
                                        Style="{StaticResource InactiveNavigationTabButtonStyle}" ToolTip="Persona Memory" AutomationProperties.Name="Persona Memory">
                                    <Path Style="{StaticResource NavigationGlyphStyle}" Data="M8,8 A3,3 0 1 0 8,2 A3,3 0 1 0 8,8 M2,16 V14 A4,4 0 0 1 6,10 H9 M12,13 H17 M14.5,10.5 V15.5"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button x:Name="SidebarHideButton" Grid.Column="1" Width="24" Height="24" Margin="6,0,0,0"
                                Click="SidebarCollapseButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="0"
                                Background="Transparent" BorderBrush="Transparent"
                                ToolTip="Hide sidebar (Ctrl+B)" AutomationProperties.Name="Hide sidebar">
                            <Path x:Name="SidebarNavigationToggleGlyph" Width="6" Height="10" Stretch="Uniform" Data="M5.5,1 L1.5,5 L5.5,9" RenderTransformOrigin="0.5,0.5"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.RenderTransform><ScaleTransform ScaleX="1"/></Path.RenderTransform>
                            </Path>
                        </Button>
                    </Grid>

                    <Button x:Name="NewChatButton" Click="NewChat_Click" Style="{StaticResource SidebarPrimaryRowButtonStyle}"
                            ToolTip="Start a new chat" AutomationProperties.Name="New chat">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource SidebarIconTextStyle}" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            <TextBlock Text="New chat" Style="{StaticResource SidebarRowLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewWorkplaceButton" Click="NewWorkplace_Click" Style="{StaticResource SidebarPrimaryRowButtonStyle}" Visibility="Collapsed"
                            ToolTip="Start a new workplace" AutomationProperties.Name="New workplace">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource SidebarIconTextStyle}" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            <TextBlock Text="New workplace" Style="{StaticResource SidebarRowLabelStyle}"/>
                        </StackPanel>
                    </Button>

                    <Border x:Name="ChatHistorySearchPanel" Style="{StaticResource SidebarSearchFieldStyle}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource AxiomIconFont}" FontSize="12" LineHeight="Auto"
                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="11,0,8,0"/>
                            <TextBox x:Name="ChatHistorySearchBox" Grid.Column="1" Style="{StaticResource SidebarSearchBoxStyle}"
                                     TextChanged="ChatHistorySearchBox_TextChanged" ToolTip="Search chat titles and messages"
                                     AutomationProperties.Name="Search chats"/>
                            <TextBlock Grid.Column="1" Text="Search chats" FontSize="12" LineHeight="Auto" Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ChatHistorySearchBox, Path=Text}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Click="ClearChatHistorySearch_Click" Width="24" Height="24" Margin="0,0,5,0"
                                    ToolTip="Clear search" AutomationProperties.Name="Clear search">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="Transparent" CornerRadius="6">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource AxiomIconFont}" FontSize="10" LineHeight="Auto"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ChatHistorySearchBox, Path=Text}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="WorkplaceSearchPanel" Style="{StaticResource SidebarSearchFieldStyle}" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource AxiomIconFont}" FontSize="12" LineHeight="Auto"
                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="11,0,8,0"/>
                            <TextBox x:Name="WorkplaceSearchBox" Grid.Column="1" Style="{StaticResource SidebarSearchBoxStyle}" Margin="0,0,8,0"
                                     TextChanged="WorkplaceSearchBox_TextChanged" ToolTip="Filter workplaces by name"
                                     AutomationProperties.Name="Search workplaces"/>
                            <TextBlock Grid.Column="1" Text="Search workplaces" FontSize="12" LineHeight="Auto" Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=WorkplaceSearchBox, Path=Text}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Margin="0,6,0,0">
                    <ScrollViewer x:Name="ChatHistorySectionContainer" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,0,12,8">
                            <TextBlock x:Name="ChatHistorySearchStatusText" Visibility="Collapsed" Style="{StaticResource SidebarGroupHeaderStyle}" TextWrapping="Wrap"/>
                            <StackPanel x:Name="ChatHistoryStack"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="WorkplaceHistorySectionContainer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="10,0,10,8">
                            <!-- Projects section header (Image 5 layout) -->
                            <Grid Margin="6,4,4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WorkplaceListHeaderText" Text="Projects" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0"/>
                                <Button x:Name="WorkplaceFilterProjectsButton" Grid.Column="1" Width="22" Height="22" Margin="2,0"
                                        Click="WorkplaceFilterProjects_Click" ToolTip="Toggle filter: hide projects with no conversations"
                                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" AutomationProperties.Name="Filter projects">
                                    <TextBlock Text="&#xE71C;" FontFamily="{StaticResource AxiomIconFont}" FontSize="11" LineHeight="Auto"
                                               Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="WorkplaceAddProjectFolderButton" Grid.Column="2" Width="22" Height="22"
                                        Click="WorkplaceAddProjectFolder_Click" ToolTip="Add project folder"
                                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" AutomationProperties.Name="Add project folder">
                                    <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource AxiomIconFont}" FontSize="11" LineHeight="Auto"
                                               Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <StackPanel x:Name="WorkplaceProjectsStack" Margin="0,0,0,10"/>

                            <!-- Unscoped conversations section header -->
                            <Grid Margin="6,4,4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WorkplaceConversationsHeaderText" Text="Conversations" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="WorkplaceNewUnscopedButton" Grid.Column="1" Width="22" Height="22"
                                        Click="NewWorkplace_Click" ToolTip="New conversation"
                                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" AutomationProperties.Name="New conversation">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource AxiomIconFont}" FontSize="10.5" LineHeight="Auto"
                                               Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="WorkplaceHistoryStack"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- CONTENT CONTAINER -->
        <Grid x:Name="ContentContainer" Grid.Row="1" Grid.Column="1" Background="{DynamicResource NotebookBackgroundBrush}">
            <!-- CHAT VIEW (default) -->
            <DockPanel x:Name="ChatView" Background="{DynamicResource NotebookBackgroundBrush}">
                <!-- Docked first so the canvas runs the full height of the chat view, beside the
                     model/context header instead of underneath it. -->
                <Border x:Name="NormalProjectCanvasPane"
                        DockPanel.Dock="Right"
                        Width="0" MaxWidth="680"
                        Visibility="Collapsed"
                        Background="{DynamicResource NotebookSurfaceBrush}"
                        BorderBrush="{DynamicResource NotebookBorderBrush}"
                        BorderThickness="1,0,0,0"
                        ClipToBounds="True">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                            <Grid x:Name="NormalProjectCanvasHeaderGrid" SizeChanged="NormalProjectCanvasHeaderGrid_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Project Canvas" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="NormalProjectCanvasStatusText" Text="Use @ProjectCanvas to render an artifact." FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </StackPanel>
                                <StackPanel x:Name="NormalProjectCanvasHeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button x:Name="NormalProjectCanvasPreviewButton" Content="Preview" Click="NormalProjectCanvasPreview_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" Height="30" MinWidth="66" Padding="10,0" Margin="0,0,5,0" IsEnabled="False"/>
                                    <Button x:Name="NormalProjectCanvasSourceButton" Content="Source" Click="NormalProjectCanvasSource_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" Height="30" MinWidth="58" Padding="10,0" Margin="0,0,7,0" IsEnabled="False"/>
                                    <Button Width="30" Height="30" Click="NormalProjectCanvasClose_Click" Style="{StaticResource ChatInputIconButtonStyle}" ToolTip="Hide Project Canvas">
                                        <TextBlock Text="&#x203A;" FontSize="18" Foreground="{DynamicResource DarkSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                            <Grid>
                                <wv2:WebView2 x:Name="NormalProjectCanvasWebView" DefaultBackgroundColor="#00000000" Visibility="Collapsed"/>
                                <TextBox x:Name="NormalProjectCanvasSourceView"
                                         Visibility="Collapsed"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="12"
                                         Background="{DynamicResource NotebookBackgroundBrush}"
                                         Foreground="{DynamicResource NotebookTextBrush}"
                                         BorderThickness="0"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"/>
                                <StackPanel x:Name="NormalProjectCanvasEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280" Margin="24">
                                    <Border Width="46" Height="46" CornerRadius="12" Background="#262321" BorderBrush="#3A3632" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <TextBlock Text="&#x25C7;" FontSize="23" Foreground="{DynamicResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Project Canvas is ready" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add @ProjectCanvas to a prompt. Axiom will render the completed HTML, SVG, interactive JavaScript, chart, or document here." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="16"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="NormalProjectCanvasCopyButton" Content="Copy source" Click="NormalProjectCanvasCopy_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" Height="30" Padding="10,0" Margin="0,0,6,0" IsEnabled="False"/>
                            <Button x:Name="NormalProjectCanvasSaveButton" Content="Save" Click="NormalProjectCanvasSave_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" Height="30" Padding="12,0" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Header -->
                <Border x:Name="ChatHeaderBorder" DockPanel.Dock="Top" BorderThickness="0" Padding="28,14,28,4" Background="Transparent">
                    <StackPanel>
                        <TextBlock x:Name="HeaderModelName" Text="No Model Loaded" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" 
                                   FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,0"/>
                        <Border x:Name="CloudContextNoticeBorder"
                                Visibility="Collapsed"
                                 Margin="0,8,0,0"
                                Padding="10,6"
                                Background="{DynamicResource NotebookSurfaceBrush}"
                                BorderBrush="{DynamicResource NotebookBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="CloudContextNoticeText"
                                       Text=""
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontFamily="{DynamicResource AppUiFont}"/>
                        </Border>
                        <Border x:Name="TokenUsagePanel"
                                Margin="0,8,0,0"
                                Padding="10,8"
                                Width="360"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderBrush="{DynamicResource NotebookBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,5">
                                    <TextBlock Text="Context"
                                               DockPanel.Dock="Left"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DarkSecondaryBrush}"
                                               FontFamily="{DynamicResource AppUiFont}"/>
                                    <TextBlock x:Name="TokenUsageLabel"
                                               Text="0 / 0 tok"
                                               DockPanel.Dock="Right"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontFamily="{DynamicResource AppUiFont}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <ProgressBar x:Name="TokenUsageProgressBar"
                                             Grid.Row="1"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Style="{StaticResource TokenMeterProgressBarStyle}"/>

                                <StackPanel x:Name="CompactionHealthGrid" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,5">
                                        <TextBlock Text="Compaction"
                                                   DockPanel.Dock="Left"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DarkSecondaryBrush}"
                                                   FontFamily="{DynamicResource AppUiFont}"/>
                                        <TextBlock x:Name="CompactionHealthLabel"
                                                   Text=""
                                                   DockPanel.Dock="Right"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontFamily="{DynamicResource AppUiFont}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="CompactionThresholdBar"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 FlowDirection="LeftToRight"
                                                 Style="{StaticResource TokenMeterProgressBarStyle}"/>
                                </StackPanel>

                                <TextBlock x:Name="CompactionStatusLabel"
                                           Grid.Row="3"
                                           Text=""
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Visibility="Collapsed"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Speed of the reply in progress, or the last one. Same readout in
                                     Local, Cloud and Hybrid Local, and in the Workplace header. -->
                                <DockPanel x:Name="GenerationStatsRow" Grid.Row="4" LastChildFill="False" Margin="0,7,0,0"
                                           Visibility="Collapsed" Background="Transparent" ToolTipService.InitialShowDelay="250">
                                    <TextBlock x:Name="GenerationStatsTitle" Text="Last reply" DockPanel.Dock="Left" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DarkSecondaryBrush}" FontFamily="{DynamicResource AppUiFont}"/>
                                    <TextBlock x:Name="GenerationStatsLabel" Text="" DockPanel.Dock="Right" FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource AppUiFont}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorNotificationBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="32,8" Background="{DynamicResource NotebookSurfaceBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource NotebookBorderBrush}">
                    <TextBlock x:Name="ErrorNotificationText" Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="12" FontFamily="{DynamicResource AppUiFont}"/>
                </Border>

                <!-- Settings panel is now rendered as a global overlay in ContentContainer -->

                <!-- Chat Area -->
                <Grid x:Name="NormalChatWorkspaceGrid" SizeChanged="NormalChatWorkspaceGrid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat Display -->
                    <Grid Grid.Row="0">
                        <ListBox x:Name="ChatDisplay"
                                 SizeChanged="ChatDisplay_SizeChanged"
                                 Margin="0"
                                  Padding="32,18,32,6"
                                 HorizontalAlignment="Stretch"
                                 Background="{DynamicResource NotebookBackgroundBrush}"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                  PreviewMouseWheel="ChatDisplay_PreviewMouseWheel"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLength="1,2"
                                  VirtualizingPanel.CacheLengthUnit="Page">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding ActualWidth, ElementName=InputContainerBorder}" HorizontalAlignment="Center">
                                        <Border x:Name="BubbleBorder" CornerRadius="12" Padding="16,10" Margin="0,4"
                                                MaxWidth="720">
                                            <StackPanel>
                                                <TextBlock x:Name="ModelLabelBlock" Text="{Binding ModelLabel}" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,0,4" Visibility="Collapsed"/>
                                                <Border x:Name="CodeBlockContainer"
                                                        Margin="0,0,0,10"
                                                        Padding="0"
                                                        Background="{DynamicResource NotebookSurfaceBrush}"
                                                        BorderBrush="{DynamicResource NotebookBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="Collapsed">
                                                    <StackPanel>
                                                        <DockPanel Margin="10,8,10,0">
                                                            <TextBlock Text="{Binding CodeBlockHeaderText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Content="Copy"
                                                                        Click="CopyCodeBlock_Click"
                                                                        Tag="{Binding}"
                                                                        Style="{StaticResource CodeBlockToggleButtonStyle}"
                                                                        Margin="0,0,4,0"/>
                                                                <Button Content="{Binding CodeBlockToggleText}"
                                                                        Click="CodeBlockToggle_Click"
                                                                        Tag="{Binding}"
                                                                        Style="{StaticResource CodeBlockToggleButtonStyle}"/>
                            </StackPanel>
                                                        </DockPanel>
                                                        <ItemsControl x:Name="CodeBlockItemsControl" ItemsSource="{Binding CodeBlocks}" Margin="10,8,10,10">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,8"
                                                                            Padding="10,8"
                                                                            Background="{DynamicResource NotebookBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Language}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasLanguage}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBox Text="{Binding Code, Mode=OneWay}"
                                                                                     TextWrapping="NoWrap"
                                                                                     HorizontalScrollBarVisibility="Auto"
                                                                                     VerticalScrollBarVisibility="Auto"
                                                                                     Background="Transparent"
                                                                                     BorderThickness="0"
                                                                                     Padding="0"
                                                                                     FontFamily="Consolas"
                                                                                     FontSize="13"
                                                                                     Foreground="{DynamicResource NotebookTextBrush}"
                                                                                     IsReadOnly="True"
                                                                                     IsReadOnlyCaretVisible="False"
                                                                                     Cursor="Arrow"
                                                                                     SelectionBrush="{DynamicResource PrimaryAccentBrush}"
                                                                                     SelectionOpacity="0.3">
                                                                                <TextBox.Style>
                                                                                    <Style TargetType="TextBox">
                                                                                        <Setter Property="Template">
                                                                                            <Setter.Value>
                                                                                                <ControlTemplate TargetType="TextBox">
                                                                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"/>
                                                                                                </ControlTemplate>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                    </Style>
                                                                                </TextBox.Style>
                                                                            </TextBox>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel x:Name="ThinkingPanel" Margin="0,0,0,10" Visibility="Collapsed">
                                                    <Border Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                        <StackPanel>
                                                            <Button x:Name="ThinkingToggleButton" Click="ThinkingToggle_Click" Tag="{Binding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Cursor="Hand" IsEnabled="False" Visibility="Collapsed">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock x:Name="ThinkingChevron" Text="▸" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding ThinkingHeaderText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" VerticalAlignment="Center"/>
                                                                    <TextBlock x:Name="ThinkingDots" Text="" FontSize="11" Foreground="#FF9A3D" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsThinkingInProgress}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                        <TextBlock.Triggers>
                                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                                <BeginStoryboard>
                                                                                    <Storyboard RepeatBehavior="Forever">
                                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Text">
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value=" ✦"/>
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value=" ✦ ✦"/>
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.7" Value=" ✦ ✦ ✦"/>
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:1.05" Value=" ✦ ✦"/>
                                                                                        </ObjectAnimationUsingKeyFrames>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever"/>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </EventTrigger>
                                                                        </TextBlock.Triggers>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Button>
                                                            <Border x:Name="ThinkingContentBorder" Margin="0,8,0,0" Padding="10,8" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                                                                <Grid>
                                                                    <TextBox x:Name="ThinkingText"
                                                                             Text="{Binding FormattedThinkingContent, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" FontFamily="{DynamicResource AppUiFont}"
                                                                             Foreground="{DynamicResource NotebookTextBrush}" Background="Transparent" BorderThickness="0" Padding="0"
                                                                             IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow"
                                                                             SelectionBrush="{DynamicResource PrimaryAccentBrush}" SelectionOpacity="0.3">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox">
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="TextBox">
                                                                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"/>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                    <local:RenderedMessageView x:Name="RenderedThinkingBubble"
                                                                                               RawText="{Binding RichThinkingContent, Mode=OneWay}"
                                                                                               PlainText="{Binding FormattedThinkingContent, Mode=OneWay}"
                                                                                               IsHtmlRenderingEnabled="False"
                                                                                               HorizontalAlignment="Stretch"
                                                                                               Visibility="Collapsed"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <local:ShimmerTextBlock x:Name="AssistantGenerationStatusText"
                                                                        Text="{Binding GenerationStatusText}"
                                                                        Margin="0,0,0,8"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        BaseColor="#71717A"
                                                                        HighlightColor="#EDE8E3"
                                                                        ShimmerDurationSeconds="2"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        Visibility="Collapsed"/>
                                                <ItemsControl ItemsSource="{Binding AttachedImages}"
                                                              Visibility="{Binding HasAttachedImages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              Margin="0,0,0,6">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="8" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" Margin="0,0,6,6" ClipToBounds="True">
                                                                <Image Source="{Binding}" MaxWidth="220" MaxHeight="160" Stretch="Uniform"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBox x:Name="BubbleText" Text="{Binding DisplayFormattedContent, Mode=OneWay}" TextWrapping="Wrap" FontSize="14.5" FontFamily="{DynamicResource AppUiFont}"
                                                         ContextMenuOpening="ReplyText_ContextMenuOpening"
                                                         Foreground="{DynamicResource NotebookTextBrush}" Background="Transparent" BorderThickness="0" Padding="0"
                                                         IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow"
                                                         SelectionBrush="{DynamicResource PrimaryAccentBrush}" SelectionOpacity="0.3">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDisplayContent}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <local:RenderedMessageView x:Name="RenderedBubble"
                                                                           ContextMenuOpening="ReplyText_ContextMenuOpening"
                                                                           Background="Transparent"
                                                                           RawText="{Binding RichRenderContent, Mode=OneWay}"
                                                                            PlainText="{Binding DisplayFormattedContent, Mode=OneWay}"
                                                                           IsHtmlRenderingEnabled="False"
                                                                           HorizontalAlignment="Stretch"
                                                                           Visibility="Collapsed"/>
                                                <WrapPanel x:Name="ActionButtonPanel" HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="Collapsed">
                                                    <Button x:Name="EditResendActionButton" Click="EditResendMessage_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Edit &amp; Resend" AutomationProperties.Name="Edit &amp; Resend" Visibility="Collapsed">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M10.8,2.7 L13.3,5.2 L5.6,12.9 L2.6,13.4 L3.1,10.4 Z M9.2,4.3 L11.7,6.8"/>
                                                    </Button>
                                                    <Button x:Name="RegenerateActionButton" Click="RegenerateMessage_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Regenerate" AutomationProperties.Name="Regenerate" Visibility="Collapsed">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M13.2,8 A5.2,5.2 0 1 1 11.7,4.3 M12.2,1.6 L12.2,4.6 L9.2,4.6"/>
                                                    </Button>
                                                    <Button x:Name="PinActionButton" Click="PinMessage_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Pin" AutomationProperties.Name="Pin">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M5.8,2.3 L10.2,2.3 M7,2.3 L7,6.4 L4.6,9 L11.4,9 L9,6.4 L9,2.3 M8,9 L8,13.8"/>
                                                    </Button>
                                                    <Button Click="BranchMessage_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Branch from here" AutomationProperties.Name="Branch from here">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M3.6,3.4 A1.4,1.4 0 1 0 6.4,3.4 A1.4,1.4 0 1 0 3.6,3.4 Z M3.6,12.6 A1.4,1.4 0 1 0 6.4,12.6 A1.4,1.4 0 1 0 3.6,12.6 Z M9.6,4.6 A1.4,1.4 0 1 0 12.4,4.6 A1.4,1.4 0 1 0 9.6,4.6 Z M5,4.8 L5,11.2 M11,6 C11,9.2 5,8.4 5,11.2"/>
                                                    </Button>
                                                    <Button Click="CopyMessage_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Copy" AutomationProperties.Name="Copy">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M5.6,5.6 L13.2,5.6 L13.2,13.4 L5.6,13.4 Z M2.8,10.4 L2.8,2.8 L10.4,2.8"/>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="BubbleBorder" Property="Margin" Value="80,4,8,4"/>
                                                <Setter TargetName="BubbleBorder" Property="Padding" Value="13,7"/>
                                                <Setter TargetName="BubbleBorder" Property="CornerRadius" Value="12"/>
                                                <Setter TargetName="BubbleBorder" Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="ActionButtonPanel" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="EditResendActionButton" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="PinActionButton" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Left"/>
                                                <Setter TargetName="BubbleBorder" Property="Margin" Value="8,2,48,2"/>
                                                <Setter TargetName="BubbleBorder" Property="Padding" Value="4,6"/>
                                                <Setter TargetName="BubbleBorder" Property="MinWidth" Value="300"/>
                                                <Setter TargetName="BubbleBorder" Property="MaxWidth" Value="780"/>
                                                <Setter TargetName="BubbleBorder" Property="Background" Value="Transparent"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="Transparent"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderThickness" Value="0"/>
                                                <Setter TargetName="ModelLabelBlock" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ActionButtonPanel" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="RegenerateActionButton" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShouldShowGenerationStatus}" Value="True">
                                                <Setter TargetName="AssistantGenerationStatusText" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                                <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                             <MultiDataTrigger>
                                                 <MultiDataTrigger.Conditions>
                                                     <Condition Binding="{Binding Role}" Value="assistant"/>
                                                     <Condition Binding="{Binding IsStreaming}" Value="False"/>
                                                    <Condition Binding="{Binding PreferPlainTextRendering}" Value="False"/>
                                                    <Condition Binding="{Binding SupportsRichRendering}" Value="True"/>
                                                    <Condition Binding="{Binding HasCodeBlocks}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="BubbleText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="RenderedBubble" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="RenderedBubble" Property="IsHtmlRenderingEnabled" Value="True"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="user"/>
                                                    <Condition Binding="{Binding SupportsRichRendering}" Value="True"/>
                                                    <Condition Binding="{Binding HasCodeBlocks}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="BubbleText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="RenderedBubble" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="RenderedBubble" Property="IsHtmlRenderingEnabled" Value="True"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                    <Condition Binding="{Binding HasCodeBlocks}" Value="True"/>
                                                    <Condition Binding="{Binding IsStreaming}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="CodeBlockContainer" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                    <Condition Binding="{Binding HasCodeBlocks}" Value="True"/>
                                                    <Condition Binding="{Binding IsCodeBlockCollapsed}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="CodeBlockItemsControl" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                    <Condition Binding="{Binding ShouldShowThinkingHeader}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="ThinkingPanel" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ThinkingToggleButton" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ThinkingToggleButton" Property="IsEnabled" Value="True"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                    <Condition Binding="{Binding IsThinkingExpanded}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="ThinkingContentBorder" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ThinkingChevron" Property="Text" Value="▾"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="system">
                                                <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Center"/>
                                                <Setter TargetName="BubbleBorder" Property="Background" Value="Transparent"/>
                                                <Setter TargetName="BubbleBorder" Property="Padding" Value="8,6"/>
                                                <Setter TargetName="BubbleBorder" Property="MaxWidth" Value="900"/>
                                                <Setter TargetName="BubbleText" Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
                                                <Setter TargetName="BubbleText" Property="FontSize" Value="11"/>
                                                <Setter TargetName="BubbleText" Property="TextAlignment" Value="Center"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="context-summary">
                                                <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Center"/>
                                                <Setter TargetName="BubbleBorder" Property="Background" Value="Transparent"/>
                                                <Setter TargetName="BubbleBorder" Property="Padding" Value="8,6"/>
                                                <Setter TargetName="BubbleBorder" Property="MaxWidth" Value="900"/>
                                                <Setter TargetName="BubbleText" Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
                                                <Setter TargetName="BubbleText" Property="FontSize" Value="11"/>
                                                <Setter TargetName="BubbleText" Property="TextAlignment" Value="Center"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                <Setter TargetName="RenderedBubble" Property="Margin" Value="0"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptyChatGreetingPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Margin="24" IsHitTestVisible="False">
                            <Image x:Name="EmptyChatLogoImage"
                                   Width="58"
                                   Height="58"
                                   Margin="0,0,0,24"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="EmptyChatGreetingText"
                                        Text="Ready when you are"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                        FontSize="26" FontFamily="Georgia"
                                       FontWeight="Normal"
                                         Foreground="{DynamicResource NotebookTextBrush}"
                                       TextAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="Visible"/>
                            <TextBlock Text="A little space to think, explore, and build." Foreground="{DynamicResource DarkSecondaryBrush}" FontSize="11.5" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Input Area -->
                    <Border Grid.Row="1" BorderThickness="0" Padding="0,6,0,0" Background="Transparent">
                        <StackPanel>
                            <Border x:Name="BranchNavigatorBorder" Visibility="Collapsed" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="32,0,32,6">
                                <DockPanel>
                                    <TextBlock Text="Branch:" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BranchNavigatorCombo" SelectionChanged="BranchNavigatorCombo_SelectionChanged" Margin="8,0,0,0" MinWidth="220" Height="24"/>
                                </DockPanel>
                            </Border>

                            <!-- Contextual Axiom Cloud suggestion (shown only on slow local, exhausted BYOK, or missing vision; never while paid) -->
                            <Border x:Name="AxiomCloudSuggestionBanner"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Stretch"
                                    MaxWidth="900"
                                    Margin="32,0,32,8"
                                    Padding="12,8"
                                    Background="{DynamicResource NotebookSurfaceBrush}"
                                    BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="AxiomCloudSuggestionHeadline"
                                                   Text="Axiom Cloud · DeepSeek 4.1F-1017"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NotebookTextBrush}"/>
                                        <TextBlock x:Name="AxiomCloudSuggestionDetail"
                                                   Text=""
                                                   FontSize="11"
                                                   Foreground="{DynamicResource DarkSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="AxiomCloudSuggestionActionButton"
                                            Grid.Column="1"
                                            Content="Explore Axiom Cloud"
                                            Click="AxiomCloudSuggestionAction_Click"
                                            Height="28"
                                            Padding="12,0"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource SubtleButtonStyle}"/>
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            Click="DismissAxiomCloudSuggestion_Click"
                                            Width="24"
                                            Height="24"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Foreground="{DynamicResource MutedTextBrush}"
                                            Cursor="Hand"
                                            ToolTip="Dismiss for this session"/>
                                </Grid>
                            </Border>

                            <!-- Borderless concise status line above composer (Image 6 blue circle) -->
                            <Border x:Name="ToolActivityIndicatorHost"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Stretch"
                                    MaxWidth="900"
                                    Margin="36,0,36,4"
                                    Padding="4,2"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ToolActivityIndicatorGlyph"
                                               Visibility="Collapsed"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontFamily="{DynamicResource AppUiFont}"
                                               Margin="0,0,4,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock x:Name="ToolActivityIndicatorText"
                                               Text=""
                                               FontSize="11.5"
                                               Foreground="{DynamicResource DarkSecondaryBrush}"
                                               FontFamily="{DynamicResource AppUiFont}"
                                               LineHeight="16"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Input Container -->
                            <Border x:Name="InputContainerBorder" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="0" Margin="32,0,32,18" Opacity="1" HorizontalAlignment="Stretch" MaxWidth="900" MinWidth="0"
                                    AllowDrop="True" PreviewDragOver="InputContainer_PreviewDragOver" PreviewDrop="InputContainer_PreviewDrop">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Attachment preview tray: thumbnail chips built in code-behind,
                                         sitting above the prompt text so the user sees what they attached. -->
                                    <StackPanel Grid.Row="0">
                                        <Border x:Name="ReplyContextHost" Margin="10,10,10,0" Visibility="Collapsed"/>
                                        <WrapPanel x:Name="AttachmentTrayPanel" Orientation="Horizontal"
                                                   Margin="14,12,14,0" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" MinHeight="56" MaxHeight="160">
                                        <!-- Underlay: gold @MCP mentions (PrimaryAccent) while InputBox ink is transparent -->
                                        <TextBlock x:Name="InputBoxMentionOverlay"
                                                   VerticalAlignment="Top"
                                                   Padding="16,12,16,8"
                                                   Margin="0"
                                                   Background="Transparent"
                                                   FontFamily="{DynamicResource AppUiFont}"
                                                   FontSize="14"
                                                   LineHeight="20"
                                                   TextWrapping="Wrap"
                                                   IsHitTestVisible="False"
                                                   Visibility="Collapsed"/>
                                        <TextBox x:Name="InputBox" VerticalContentAlignment="Top" Padding="16,12,16,8"
                                              Background="Transparent" Foreground="{DynamicResource NotebookTextBrush}" BorderThickness="0" CaretBrush="{DynamicResource NotebookTextBrush}"
                                              FontFamily="{DynamicResource AppUiFont}" FontSize="14" PreviewKeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged" GotFocus="InputBox_GotFocus" LostFocus="InputBox_LostFocus"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="160"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              SelectionBrush="#66B8924A" SelectionOpacity="1"/>
                                        <TextBlock Text="Ask anything" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource AppUiFont}" FontSize="14"
                                                   Margin="16,12,16,8" IsHitTestVisible="False" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=InputBox, Path=Text}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- @ connector picker (Cloud Mode only; shown from code-behind) -->
                                        <Popup x:Name="McpMentionPopup"
                                               Placement="Top"
                                               PlacementTarget="{Binding ElementName=InputBox}"
                                               StaysOpen="True"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               HorizontalOffset="18"
                                               VerticalOffset="-6">
                                            <Border Background="{DynamicResource NotebookSurfaceBrush}"
                                                    BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="6"
                                                    MinWidth="260"
                                                    MaxWidth="360"
                                                    MaxHeight="220"
                                                    Effect="{StaticResource SoftShadow}">
                                                <ListBox x:Name="McpMentionList"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         FontFamily="{DynamicResource AppUiFont}"
                                                         FontSize="13"
                                                         Foreground="{DynamicResource NotebookTextBrush}"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         MouseLeftButtonUp="McpMentionList_MouseLeftButtonUp">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding" Value="10,8"/>
                                                            <Setter Property="Margin" Value="0,1"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#2A2724"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding LogoGlyph}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                                    <TextBlock FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}">
                                                                        <Run Text="@"/><Run Text="{Binding Handle}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding AccountLabel}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>


                                    <Grid Grid.Row="2" MinHeight="56" Background="Transparent">
                                        <Grid x:Name="ComposerToolbarGrid" Margin="0,0,0,0" SizeChanged="ComposerToolbarGrid_SizeChanged">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel x:Name="ComposerLeftTools" SizeChanged="ComposerToolbarGrid_SizeChanged" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,10,0,10">
                                                <Button Width="34" Height="34" Margin="0,0,4,0" Click="ImportChatDocument_Click" Style="{StaticResource ChatInputIconButtonStyle}" AutomationProperties.Name="Attach files" ToolTip="Attach files (documents, spreadsheets, presentations, e-books, code, images)">
                                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M6,0 L8,0 L8,6 L14,6 L14,8 L8,8 L8,14 L6,14 L6,8 L0,8 L0,6 L6,6 Z"/>
                                                </Button>
                                                <Button x:Name="SkillsButton" AutomationProperties.Name="Skills" MinWidth="90" Margin="6,0,6,0" Click="OpenSkills_Click" Style="{StaticResource ChatInputUtilityButtonStyle}" ToolTip="Attach reusable Skills to every Axiom model and mode">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path x:Name="SkillsButtonIcon" Width="13" Height="13" Margin="0,0,7,0" Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Data="M7,1 L8.3,4.7 L12,3.4 L9.8,6.7 L13,9 L9,9 L9,13 L6.7,9.8 L3.4,12 L4.7,8.3 L1,7 L4.7,5.7 L3.4,2.2 L6.7,4.2 Z"/>
                                                        <TextBlock x:Name="SkillsButtonLabel" Text="Skills" VerticalAlignment="Center"/>
                                                        <Border x:Name="SkillsButtonBadge" Margin="7,0,0,0" Padding="5,1" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed">
                                                            <TextBlock x:Name="SkillsButtonCountText" Text="0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentMutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="PluginsButton" AutomationProperties.Name="Plugins" MinWidth="96" Click="OpenPlugins_Click" Style="{StaticResource ChatInputUtilityButtonStyle}" ToolTip="Attach Axiom-native capability Plugins">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path x:Name="PluginsButtonIcon" Width="13" Height="13" Margin="0,0,7,0" Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Data="M5,1 L9,1 L9,5 L13,5 L13,9 L9,9 L9,13 L5,13 L5,9 L1,9 L1,5 L5,5 Z"/>
                                                        <TextBlock x:Name="PluginsButtonLabel" Text="Plugins" VerticalAlignment="Center"/>
                                                        <Border x:Name="PluginsButtonBadge" Margin="7,0,0,0" Padding="5,1" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed">
                                                            <TextBlock x:Name="PluginsButtonCountText" Text="0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentMutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <Popup x:Name="SkillsPopup"
                                                   Placement="Top"
                                                   PlacementTarget="{Binding ElementName=SkillsButton}"
                                                   AllowsTransparency="True"
                                                   StaysOpen="False"
                                                   PopupAnimation="Fade"
                                                   HorizontalOffset="0"
                                                   VerticalOffset="-10"
                                                   Opened="SkillsPopup_Opened">
                                                <Border x:Name="SkillsFlyoutCard" Width="316" MaxHeight="330" Padding="10" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Effect="{StaticResource SoftShadow}" Opacity="1">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform Y="0"/>
                                                    </Border.RenderTransform>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Skills" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                                <TextBlock x:Name="SkillsFlyoutSummaryText" Text="Reusable procedures for specialized work" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Width="23" Height="23" Click="CloseSkills_Click" Style="{StaticResource ChatInputIconButtonStyle}" ToolTip="Close">
                                                                <TextBlock Text="×" FontSize="14" VerticalAlignment="Center"/>
                                                            </Button>
