                <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="32,20" Background="{DynamicResource NotebookSurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Persona Memory" FontSize="28" FontWeight="Normal" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Georgia"/>
                        <TextBlock Text="Tell Axiom about yourself and how you like replies. Chat and Workplace apply preferences like “no emojis,” “use hyphen bullets,” and “plain headings.” Notes are saved on this device."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,6,0,0"/>
                        <CheckBox IsChecked="{Binding ShareWithModel}" Margin="0,10,0,0" Foreground="{DynamicResource NotebookTextBrush}" FontSize="12"
                                  AutomationProperties.Name="Let Normal Chat use these notes">
                            <TextBlock TextWrapping="Wrap" LineHeight="Auto" FontSize="12" Foreground="{DynamicResource NotebookTextBrush}"
                                       Text="Let Normal Chat use these notes as background about you. With a Cloud or Hybrid Local model, they are sent along with your message."/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Grid Margin="32,20,32,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox Text="{Binding PersonaText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource AppUiFont}" FontSize="13" Padding="12"
                                 Background="{DynamicResource NotebookSurfaceBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"/>
                        <TextBlock IsHitTestVisible="False" TextWrapping="Wrap" FontFamily="{DynamicResource AppUiFont}" FontSize="13" Padding="14,14,14,0"
                                   Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Top"
                                   Visibility="{Binding IsPersonaEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Run Text="Example: I prefer plain headings, hyphen bullets, and no emojis in replies."/>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" Width="90" Height="34" Style="{StaticResource PremiumButtonStyle}"/>
                        <TextBlock Text="{Binding WordCountLabel}" Margin="12,8,0,0" Foreground="{DynamicResource DarkSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Status}" Margin="12,8,0,0" Foreground="{DynamicResource DarkSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Global Settings Panel Overlay (spans entire client area so titlebar/sidebar buttons stay behind modal) -->
        <Border x:Name="SettingsPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                Panel.ZIndex="1000" Visibility="Collapsed" Background="#CC171615" Opacity="0"
                KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True">
            <Grid>
                <Border x:Name="SettingsPanelCard" CornerRadius="16" MaxWidth="980" BorderThickness="1" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="24,18" Margin="28,26,28,26" Background="{DynamicResource NotebookSurfaceBrush}" Effect="{StaticResource SoftShadow}">
                    <Border.RenderTransform>
                        <TranslateTransform X="28"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
