<Window x:Class="Malx_AI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Malx_AI"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Axiom - Chat" Height="900" Width="1600" MinWidth="1040" MinHeight="640" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AxiomLogo.ico"
        AllowsTransparency="False" Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <QuadraticEase x:Key="FastEaseOut" EasingMode="EaseOut"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ActiveNavigationTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,2"/>
        </Style>

        <Style x:Key="CodeBlockToggleButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InactiveNavigationTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,2"/>
        </Style>

        <Style x:Key="SidebarFlatButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,2"/>
        </Style>

        <Style x:Key="SidebarOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarFlatButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
        </Style>

        <Style x:Key="ChatHistoryItemButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkplaceActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkplaceDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkplaceActionButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="#231C1C"/>
            <Setter Property="Foreground" Value="#D9A29A"/>
            <Setter Property="BorderBrush" Value="#5A3631"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="WorkplaceHistoryItemButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
            <Setter Property="Foreground" Value="#DCD5CB"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="accentRail"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding BorderBrush}"
                                        CornerRadius="8,0,0,8"
                                        Opacity="0.45"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatInputIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal line-icon buttons under chat messages. Icons are 16x16 stroked paths drawn
             from the button's foreground, so hover/disabled states recolour them with no extra art. -->
        <Style x:Key="MessageActionIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MessageActionIconPathStyle" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <Style x:Key="ChatInputUtilityButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1B19"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TokenMeterProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot"
                              Height="{TemplateBinding Height}"
                              SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="2"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatInputToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource ChatInputIconButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="Opacity" Value="1">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Opacity" Value="1"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Composer tool toggle (Web). Matches the Skills/Plugins pills when off and takes a
             gold tint when on, instead of dimming the whole control so its label greys out. -->
        <Style x:Key="ChatComposerToggleStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter Property="Foreground" Value="#E8C67C"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#453A2B"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop generation. A quiet round button while idle; it gains a ring and lifts to the
             accent on hover once a response is actually running. -->
        <Style x:Key="ChatInputStopButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#332F2B"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <!-- Still a disc, just a quiet one: a bare glyph on the background
                                     reads as a stray mark rather than an unavailable button. -->
                                <Setter Property="Background" Value="#201E1C"/>
                                <Setter Property="BorderBrush" Value="#2E2B28"/>
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatInputSendButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C79F52"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#A8823F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <!-- Nothing typed yet: the button recedes instead of inviting a click. -->
                            <DataTrigger Binding="{Binding ElementName=InputBox, Path=Text}" Value="">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3328"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource NotebookBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Path x:Name="DropDownArrow"
                                                      Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Fill="{DynamicResource MutedTextBrush}"
                                                      Stretch="Uniform"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                                <Setter TargetName="DropDownArrow" Property="Fill" Value="{DynamicResource NotebookTextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                <Setter TargetName="DropDownArrow" Property="Fill" Value="{DynamicResource AccentBrightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              Margin="10,0,30,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource NotebookBackgroundBrush}"
                                        BorderBrush="{DynamicResource NotebookBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatModeSelectorButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4,6,3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,1"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource NotebookBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="304"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MODE TABS -->
        <Border x:Name="NavigationBar" Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource DarkSidebarBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ChatTabButton" Content="Chat" Click="SwitchToChat_Click" Height="32" Width="120"
                            Style="{StaticResource ActiveNavigationTabButtonStyle}" Margin="0,0,8,0"/>
                    <Button x:Name="WorkplaceTabButton" Content="Workplace" Click="SwitchToWorkplace_Click" Height="32" Width="120"
                            Style="{StaticResource InactiveNavigationTabButtonStyle}" Margin="0,0,8,0"/>
                    <Button x:Name="PersonaTabButton" Content="Persona" Click="SwitchToPersona_Click" Height="32" Width="120"
                            Style="{StaticResource InactiveNavigationTabButtonStyle}" Margin="0,0,0,0"/>
                    <Button x:Name="NeuronTabButton" Content="Neuron" Click="SwitchToNeuron_Click" Height="32" Width="120"
                            Style="{StaticResource InactiveNavigationTabButtonStyle}" Margin="8,0,0,0"/>

                    <!-- Sidebar collapse, Workplace only: hides the Axiom / Workplace Chats column
                         so the council gets the extra width. Other tabs always show the sidebar. -->
                    <Button x:Name="SidebarCollapseButton" Width="32" Height="32" Margin="12,0,0,0" VerticalAlignment="Center"
                            Click="SidebarCollapseButton_Click" Visibility="Collapsed"
                            ToolTip="Hide sidebar (Ctrl+B)" AutomationProperties.Name="Toggle sidebar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.84"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <!-- Chevron points left while the sidebar is open; flipped when collapsed. -->
                        <Path x:Name="SidebarCollapseGlyph" Width="8" Height="12" Stretch="Uniform"
                              Data="M6,1 L1.5,6 L6,11" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1"/>
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                </StackPanel>

                <!-- Project Canvas toggle shared by Chat and Workplace: it drives whichever tab is
                     active. Lives in the tab bar instead of a full-height rail so the content
                     column keeps the whole window width. -->
                <ToggleButton x:Name="ProjectCanvasToggleButton" Grid.Column="1"
                              Width="32" Height="32" VerticalAlignment="Center"
                              Checked="ProjectCanvasToggle_Changed"
                              Unchecked="ProjectCanvasToggle_Changed"
                              ToolTip="Show Project Canvas"
                              AutomationProperties.Name="Toggle Project Canvas">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.84"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                    <!-- Panel-right glyph: window outline with the canvas column on its right edge. -->
                    <Grid Width="16" Height="14">
                        <Border CornerRadius="3" BorderThickness="1.4"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        <Border Width="5" HorizontalAlignment="Right" Margin="0,1.4,1.4,1.4" CornerRadius="0,1.6,1.6,0"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- LEFT SIDEBAR -->
        <Border x:Name="SidebarBorder" Grid.Row="1" Grid.Column="0" Background="{DynamicResource NotebookBackgroundBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource NotebookBorderBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,12,20,20">
                    <Rectangle Height="1" Fill="{DynamicResource NotebookBorderBrush}" Margin="0,0,0,14"/>
                    <Button x:Name="ImportModelSidebarButton" Content="+ Import AI Model" Click="ImportModel_Click" Height="40"
                            Margin="0,0,0,8" Style="{StaticResource PremiumButtonStyle}" FontSize="12" Background="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" Foreground="{DynamicResource NotebookBackgroundBrush}"/>
                    <Button x:Name="DownloadDefaultModelSidebarButton" Content="↓ Download recommended model" Click="DownloadDefaultModel_Click" Height="36"
                            Margin="0,0,0,8" Style="{StaticResource SidebarOutlineButtonStyle}" FontSize="12"/>
                    <Button Content="⚙ Settings" Click="Settings_Click" Height="36" Margin="0,0,0,8"
                            Style="{StaticResource SidebarOutlineButtonStyle}" FontSize="12"/>
                    <Button x:Name="DeleteChatSidebarButton" Content="Delete chat" Click="DeleteChat_Click" Height="34"
                            Style="{StaticResource SidebarFlatButtonStyle}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,0">
                    <TextBlock Text="Axiom" FontSize="28" FontWeight="Normal" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Georgia"/>
                    <Button x:Name="NewChatButton" DockPanel.Dock="Top" Content="+ New chat" Click="NewChat_Click" Height="40" Margin="0,20,0,0"
                            Style="{StaticResource SidebarOutlineButtonStyle}" FontSize="14" Padding="14,2"/>
                    <Grid x:Name="ChatHistorySearchPanel" Margin="0,12,0,0">
                        <TextBox x:Name="ChatHistorySearchBox" Height="34" Padding="10,6,30,6"
                                 Background="{DynamicResource NotebookSurfaceBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"
                                 FontSize="12" TextChanged="ChatHistorySearchBox_TextChanged" ToolTip="Search chat titles and messages"/>
                        <TextBlock Text="Search chats" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="11,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ChatHistorySearchBox, Path=Text}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="x" Click="ClearChatHistorySearch_Click" Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,5,0"
                                Style="{StaticResource SidebarFlatButtonStyle}" Foreground="{DynamicResource MutedTextBrush}" ToolTip="Clear search"/>
                    </Grid>
                </StackPanel>

                <Button x:Name="WorkplaceHistorySectionToggle" DockPanel.Dock="Top" Content="▾ Workplace Chats" Click="WorkplaceSidebarHistoryToggle_Click" Height="34"
                        Margin="14,10,14,0" Style="{StaticResource SidebarFlatButtonStyle}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Padding="0,6" Visibility="Collapsed"/>

                <!-- Chat history is always shown and fills the space between search and the
                     bottom actions; no collapsible "Recents" header above it. -->
                <Border x:Name="ChatHistorySectionContainer" DockPanel.Dock="Top" Opacity="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <StackPanel Margin="14,0,14,0">
                            <TextBlock x:Name="ChatHistorySearchStatusText" Visibility="Collapsed" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,2,6" TextWrapping="Wrap"/>
                            <StackPanel x:Name="ChatHistoryStack"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="WorkplaceHistorySectionContainer" DockPanel.Dock="Top" Opacity="1" MaxHeight="420" Visibility="Collapsed">
                    <StackPanel Margin="14,8,14,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="NewWorkplaceButton" Click="NewWorkplace_Click" Height="36" Margin="0,0,8,0" Style="{StaticResource WorkplaceActionButtonStyle}" ToolTip="Create a new workplace chat">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="New Workplace" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteWorkplaceButton" Grid.Column="1" Click="DeleteWorkplace_Click" Height="36" Style="{StaticResource WorkplaceDeleteButtonStyle}" ToolTip="Delete the current workplace chat">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="x" FontSize="12" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                            <StackPanel x:Name="WorkplaceHistoryStack"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- CONTENT CONTAINER -->
        <Grid x:Name="ContentContainer" Grid.Row="1" Grid.Column="1" Background="{DynamicResource NotebookBackgroundBrush}">
            <!-- CHAT VIEW (default) -->
            <DockPanel x:Name="ChatView" Background="{DynamicResource NotebookBackgroundBrush}">
                <!-- Docked first so the canvas runs the full height of the chat view, beside the
                     model/context header instead of underneath it. -->
                <Border x:Name="NormalProjectCanvasPane"
                        DockPanel.Dock="Right"
                        Width="0" MaxWidth="680"
                        Visibility="Collapsed"
                        Background="{DynamicResource NotebookSurfaceBrush}"
                        BorderBrush="{DynamicResource NotebookBorderBrush}"
                        BorderThickness="1,0,0,0"
                        ClipToBounds="True">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                            <Grid x:Name="NormalProjectCanvasHeaderGrid" SizeChanged="NormalProjectCanvasHeaderGrid_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Project Canvas" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="NormalProjectCanvasStatusText" Text="Use @ProjectCanvas to render an artifact." FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </StackPanel>
                                <StackPanel x:Name="NormalProjectCanvasHeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button x:Name="NormalProjectCanvasPreviewButton" Content="Preview" Click="NormalProjectCanvasPreview_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" Height="30" MinWidth="66" Padding="10,0" Margin="0,0,5,0" IsEnabled="False"/>
                                    <Button x:Name="NormalProjectCanvasSourceButton" Content="Source" Click="NormalProjectCanvasSource_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" Height="30" MinWidth="58" Padding="10,0" Margin="0,0,7,0" IsEnabled="False"/>
                                    <Button Width="30" Height="30" Click="NormalProjectCanvasClose_Click" Style="{StaticResource ChatInputIconButtonStyle}" ToolTip="Hide Project Canvas">
                                        <TextBlock Text="&#x203A;" FontSize="18" Foreground="{DynamicResource DarkSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                            <Grid>
                                <wv2:WebView2 x:Name="NormalProjectCanvasWebView" DefaultBackgroundColor="#00000000" Visibility="Collapsed"/>
                                <TextBox x:Name="NormalProjectCanvasSourceView"
                                         Visibility="Collapsed"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="12"
                                         Background="{DynamicResource NotebookBackgroundBrush}"
                                         Foreground="{DynamicResource NotebookTextBrush}"
                                         BorderThickness="0"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"/>
                                <StackPanel x:Name="NormalProjectCanvasEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280" Margin="24">
                                    <Border Width="46" Height="46" CornerRadius="12" Background="#262321" BorderBrush="#3A3632" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <TextBlock Text="&#x25C7;" FontSize="23" Foreground="{DynamicResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Project Canvas is ready" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add @ProjectCanvas to a prompt. Axiom will render the completed HTML, SVG, interactive JavaScript, chart, or document here." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="16"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="NormalProjectCanvasCopyButton" Content="Copy source" Click="NormalProjectCanvasCopy_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" Height="30" Padding="10,0" Margin="0,0,6,0" IsEnabled="False"/>
                            <Button x:Name="NormalProjectCanvasSaveButton" Content="Save" Click="NormalProjectCanvasSave_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" Height="30" Padding="12,0" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Header -->
                <Border x:Name="ChatHeaderBorder" DockPanel.Dock="Top" BorderThickness="0" Padding="28,14,28,4" Background="Transparent">
                    <StackPanel>
                        <TextBlock x:Name="HeaderModelName" Text="No Model Loaded" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" 
                                   FontFamily="Segoe UI" Margin="0,0,0,0"/>
                        <Border x:Name="CloudContextNoticeBorder"
                                Visibility="Collapsed"
                                 Margin="0,8,0,0"
                                Padding="10,6"
                                Background="{DynamicResource NotebookSurfaceBrush}"
                                BorderBrush="{DynamicResource NotebookBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="CloudContextNoticeText"
                                       Text=""
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontFamily="Segoe UI"/>
                        </Border>
                        <Border x:Name="TokenUsagePanel"
                                Margin="0,8,0,0"
                                Padding="10,8"
                                Width="360"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderBrush="{DynamicResource NotebookBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,5">
                                    <TextBlock Text="Context"
                                               DockPanel.Dock="Left"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DarkSecondaryBrush}"
                                               FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="TokenUsageLabel"
                                               Text="0 / 0 tok"
                                               DockPanel.Dock="Right"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontFamily="Segoe UI"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <ProgressBar x:Name="TokenUsageProgressBar"
                                             Grid.Row="1"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Style="{StaticResource TokenMeterProgressBarStyle}"/>

                                <StackPanel x:Name="CompactionHealthGrid" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,5">
                                        <TextBlock Text="Compaction"
                                                   DockPanel.Dock="Left"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DarkSecondaryBrush}"
                                                   FontFamily="Segoe UI"/>
                                        <TextBlock x:Name="CompactionHealthLabel"
                                                   Text=""
                                                   DockPanel.Dock="Right"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontFamily="Segoe UI"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="CompactionThresholdBar"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 FlowDirection="LeftToRight"
                                                 Style="{StaticResource TokenMeterProgressBarStyle}"/>
                                </StackPanel>

                                <TextBlock x:Name="CompactionStatusLabel"
                                           Grid.Row="3"
                                           Text=""
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Visibility="Collapsed"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorNotificationBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="32,8" Background="{DynamicResource NotebookSurfaceBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource NotebookBorderBrush}">
                    <TextBlock x:Name="ErrorNotificationText" Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="12" FontFamily="Segoe UI"/>
                </Border>

                <!-- Settings panel is now rendered as a global overlay in ContentContainer -->

                <!-- Chat Area -->
                <Grid x:Name="NormalChatWorkspaceGrid" SizeChanged="NormalChatWorkspaceGrid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat Display -->
                    <Grid Grid.Row="0">
                        <ListBox x:Name="ChatDisplay"
                                 Margin="0"
                                  Padding="32,18,32,6"
                                 HorizontalAlignment="Stretch"
                                 Background="{DynamicResource NotebookBackgroundBrush}"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                  PreviewMouseWheel="ChatDisplay_PreviewMouseWheel"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLength="1,2"
                                  VirtualizingPanel.CacheLengthUnit="Page">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="BubbleBorder" CornerRadius="12" Padding="16,10" Margin="0,4"
                                                MaxWidth="720">
                                            <StackPanel>
                                                <TextBlock x:Name="ModelLabelBlock" Text="{Binding ModelLabel}" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,0,4" Visibility="Collapsed"/>
                                                <Border x:Name="CodeBlockContainer"
                                                        Margin="0,0,0,10"
                                                        Padding="0"
                                                        Background="{DynamicResource NotebookSurfaceBrush}"
                                                        BorderBrush="{DynamicResource NotebookBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Visibility="Collapsed">
                                                    <StackPanel>
                                                        <DockPanel Margin="10,8,10,0">
                                                            <TextBlock Text="{Binding CodeBlockHeaderText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Content="Copy"
                                                                        Click="CopyCodeBlock_Click"
                                                                        Tag="{Binding}"
                                                                        Style="{StaticResource CodeBlockToggleButtonStyle}"
                                                                        Margin="0,0,4,0"/>
                                                                <Button Content="{Binding CodeBlockToggleText}"
                                                                        Click="CodeBlockToggle_Click"
                                                                        Tag="{Binding}"
                                                                        Style="{StaticResource CodeBlockToggleButtonStyle}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <ItemsControl x:Name="CodeBlockItemsControl" ItemsSource="{Binding CodeBlocks}" Margin="10,8,10,10">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,8"
                                                                            Padding="10,8"
                                                                            Background="{DynamicResource NotebookBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Language}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasLanguage}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBox Text="{Binding Code, Mode=OneWay}"
                                                                                     TextWrapping="NoWrap"
                                                                                     HorizontalScrollBarVisibility="Auto"
                                                                                     VerticalScrollBarVisibility="Auto"
                                                                                     Background="Transparent"
                                                                                     BorderThickness="0"
                                                                                     Padding="0"
                                                                                     FontFamily="Consolas"
                                                                                     FontSize="12"
                                                                                     Foreground="{DynamicResource NotebookTextBrush}"
                                                                                     IsReadOnly="True"
                                                                                     IsReadOnlyCaretVisible="False"
                                                                                     Cursor="Arrow"
                                                                                     SelectionBrush="{DynamicResource PrimaryAccentBrush}"
                                                                                     SelectionOpacity="0.3">
                                                                                <TextBox.Style>
                                                                                    <Style TargetType="TextBox">
                                                                                        <Setter Property="Template">
                                                                                            <Setter.Value>
                                                                                                <ControlTemplate TargetType="TextBox">
                                                                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"/>
                                                                                                </ControlTemplate>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                    </Style>
                                                                                </TextBox.Style>
                                                                            </TextBox>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel x:Name="ThinkingPanel" Margin="0,0,0,10" Visibility="Collapsed">
                                                    <Border Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                        <StackPanel>
                                                            <Button x:Name="ThinkingToggleButton" Click="ThinkingToggle_Click" Tag="{Binding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Cursor="Hand" IsEnabled="False" Visibility="Collapsed">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock x:Name="ThinkingChevron" Text="▸" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding ThinkingHeaderText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" VerticalAlignment="Center"/>
                                                                    <TextBlock x:Name="ThinkingDots" Text="" FontSize="11" Foreground="#FF9A3D" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsThinkingInProgress}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                        <TextBlock.Triggers>
                                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                                <BeginStoryboard>
                                                                                    <Storyboard RepeatBehavior="Forever">
                                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Text">
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value=" ✦"/>
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value=" ✦ ✦"/>
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.7" Value=" ✦ ✦ ✦"/>
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:1.05" Value=" ✦ ✦"/>
                                                                                        </ObjectAnimationUsingKeyFrames>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever"/>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </EventTrigger>
                                                                        </TextBlock.Triggers>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Button>
                                                            <Border x:Name="ThinkingContentBorder" Margin="0,8,0,0" Padding="10,8" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                                                                <Grid>
                                                                    <TextBox x:Name="ThinkingText"
                                                                             Text="{Binding FormattedThinkingContent, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" FontFamily="Segoe UI"
                                                                             Foreground="{DynamicResource NotebookTextBrush}" Background="Transparent" BorderThickness="0" Padding="0"
                                                                             IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow"
                                                                             SelectionBrush="{DynamicResource PrimaryAccentBrush}" SelectionOpacity="0.3">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox">
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="TextBox">
                                                                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"/>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                    <local:RenderedMessageView x:Name="RenderedThinkingBubble"
                                                                                               RawText="{Binding RichThinkingContent, Mode=OneWay}"
                                                                                               PlainText="{Binding FormattedThinkingContent, Mode=OneWay}"
                                                                                               IsHtmlRenderingEnabled="False"
                                                                                               HorizontalAlignment="Stretch"
                                                                                               Visibility="Collapsed"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <local:ShimmerTextBlock x:Name="AssistantGenerationStatusText"
                                                                        Text="{Binding GenerationStatusText}"
                                                                        Margin="0,0,0,8"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        BaseColor="#71717A"
                                                                        HighlightColor="#EDE8E3"
                                                                        ShimmerDurationSeconds="2"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        Visibility="Collapsed"/>
                                                <TextBox x:Name="BubbleText" Text="{Binding DisplayFormattedContent, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" FontFamily="Segoe UI"
                                                         Foreground="{DynamicResource NotebookTextBrush}" Background="Transparent" BorderThickness="0" Padding="0"
                                                         IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow"
                                                         SelectionBrush="{DynamicResource PrimaryAccentBrush}" SelectionOpacity="0.3">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDisplayContent}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <local:RenderedMessageView x:Name="RenderedBubble"
                                                                           RawText="{Binding RichRenderContent, Mode=OneWay}"
                                                                            PlainText="{Binding DisplayFormattedContent, Mode=OneWay}"
                                                                           IsHtmlRenderingEnabled="False"
                                                                           HorizontalAlignment="Stretch"
                                                                           Visibility="Collapsed"/>
                                                <WrapPanel x:Name="ActionButtonPanel" HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="Collapsed">
                                                    <Button x:Name="EditResendActionButton" Click="EditResendMessage_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Edit &amp; Resend" AutomationProperties.Name="Edit &amp; Resend" Visibility="Collapsed">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M10.8,2.7 L13.3,5.2 L5.6,12.9 L2.6,13.4 L3.1,10.4 Z M9.2,4.3 L11.7,6.8"/>
                                                    </Button>
                                                    <Button x:Name="RegenerateActionButton" Click="RegenerateMessage_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Regenerate" AutomationProperties.Name="Regenerate" Visibility="Collapsed">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M13.2,8 A5.2,5.2 0 1 1 11.7,4.3 M12.2,1.6 L12.2,4.6 L9.2,4.6"/>
                                                    </Button>
                                                    <Button x:Name="RetryCloudActionButton" Click="RetryOtherCloudModel_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Retry with another model" AutomationProperties.Name="Retry with another model" Visibility="Collapsed">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M2.5,5.2 L12.5,5.2 M10,2.7 L12.5,5.2 L10,7.7 M13.5,10.8 L3.5,10.8 M6,8.3 L3.5,10.8 L6,13.3"/>
                                                    </Button>
                                                    <Button x:Name="OpenCanvasActionButton" Click="OpenMessageInProjectCanvas_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Open in Canvas" AutomationProperties.Name="Open in Canvas" Visibility="Collapsed">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M2.5,3.2 L13.5,3.2 L13.5,12.8 L2.5,12.8 Z M9.3,3.2 L9.3,12.8 M10.9,6 L12,6 M10.9,8 L12,8"/>
                                                    </Button>
                                                    <Button x:Name="PinActionButton" Click="PinMessage_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Pin" AutomationProperties.Name="Pin">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M5.8,2.3 L10.2,2.3 M7,2.3 L7,6.4 L4.6,9 L11.4,9 L9,6.4 L9,2.3 M8,9 L8,13.8"/>
                                                    </Button>
                                                    <Button Click="BranchMessage_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Branch from here" AutomationProperties.Name="Branch from here">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M3.6,3.4 A1.4,1.4 0 1 0 6.4,3.4 A1.4,1.4 0 1 0 3.6,3.4 Z M3.6,12.6 A1.4,1.4 0 1 0 6.4,12.6 A1.4,1.4 0 1 0 3.6,12.6 Z M9.6,4.6 A1.4,1.4 0 1 0 12.4,4.6 A1.4,1.4 0 1 0 9.6,4.6 Z M5,4.8 L5,11.2 M11,6 C11,9.2 5,8.4 5,11.2"/>
                                                    </Button>
                                                    <Button Click="CopyMessage_Click" Tag="{Binding}" Style="{StaticResource MessageActionIconButtonStyle}" ToolTip="Copy" AutomationProperties.Name="Copy">
                                                        <Path Style="{StaticResource MessageActionIconPathStyle}" Data="M5.6,5.6 L13.2,5.6 L13.2,13.4 L5.6,13.4 Z M2.8,10.4 L2.8,2.8 L10.4,2.8"/>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="BubbleBorder" Property="Margin" Value="80,4,8,4"/>
                                                <Setter TargetName="BubbleBorder" Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="ActionButtonPanel" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="EditResendActionButton" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="PinActionButton" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Left"/>
                                                <Setter TargetName="BubbleBorder" Property="Margin" Value="8,4,80,4"/>
                                                <Setter TargetName="BubbleBorder" Property="MinWidth" Value="300"/>
                                                <Setter TargetName="BubbleBorder" Property="MaxWidth" Value="780"/>
                                                <Setter TargetName="BubbleBorder" Property="Background" Value="{DynamicResource AiMessageBrush}"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="ModelLabelBlock" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ActionButtonPanel" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="RegenerateActionButton" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="RetryCloudActionButton" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShouldShowGenerationStatus}" Value="True">
                                                <Setter TargetName="AssistantGenerationStatusText" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                    <Condition Binding="{Binding HasCanvasArtifact}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="OpenCanvasActionButton" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                                <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                             <MultiDataTrigger>
                                                 <MultiDataTrigger.Conditions>
                                                     <Condition Binding="{Binding Role}" Value="assistant"/>
                                                     <Condition Binding="{Binding IsStreaming}" Value="False"/>
                                                    <Condition Binding="{Binding PreferPlainTextRendering}" Value="False"/>
                                                    <Condition Binding="{Binding SupportsRichRendering}" Value="True"/>
                                                    <Condition Binding="{Binding HasCodeBlocks}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="BubbleText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="RenderedBubble" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="RenderedBubble" Property="IsHtmlRenderingEnabled" Value="True"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="user"/>
                                                    <Condition Binding="{Binding SupportsRichRendering}" Value="True"/>
                                                    <Condition Binding="{Binding HasCodeBlocks}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="BubbleText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="RenderedBubble" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="RenderedBubble" Property="IsHtmlRenderingEnabled" Value="True"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                    <Condition Binding="{Binding HasCodeBlocks}" Value="True"/>
                                                    <Condition Binding="{Binding IsStreaming}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="CodeBlockContainer" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                    <Condition Binding="{Binding HasCodeBlocks}" Value="True"/>
                                                    <Condition Binding="{Binding IsCodeBlockCollapsed}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="CodeBlockItemsControl" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                    <Condition Binding="{Binding ShouldShowThinkingHeader}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="ThinkingPanel" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ThinkingToggleButton" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ThinkingToggleButton" Property="IsEnabled" Value="True"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                    <Condition Binding="{Binding IsThinkingExpanded}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="ThinkingContentBorder" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ThinkingChevron" Property="Text" Value="▾"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="system">
                                                <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Center"/>
                                                <Setter TargetName="BubbleBorder" Property="Background" Value="Transparent"/>
                                                <Setter TargetName="BubbleBorder" Property="Padding" Value="8,6"/>
                                                <Setter TargetName="BubbleBorder" Property="MaxWidth" Value="900"/>
                                                <Setter TargetName="BubbleText" Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
                                                <Setter TargetName="BubbleText" Property="FontSize" Value="11"/>
                                                <Setter TargetName="BubbleText" Property="TextAlignment" Value="Center"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="context-summary">
                                                <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Center"/>
                                                <Setter TargetName="BubbleBorder" Property="Background" Value="Transparent"/>
                                                <Setter TargetName="BubbleBorder" Property="Padding" Value="8,6"/>
                                                <Setter TargetName="BubbleBorder" Property="MaxWidth" Value="900"/>
                                                <Setter TargetName="BubbleText" Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
                                                <Setter TargetName="BubbleText" Property="FontSize" Value="11"/>
                                                <Setter TargetName="BubbleText" Property="TextAlignment" Value="Center"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                <Setter TargetName="RenderedBubble" Property="Margin" Value="0"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptyChatGreetingPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Margin="24" IsHitTestVisible="False">
                            <Image x:Name="EmptyChatLogoImage"
                                   Width="58"
                                   Height="58"
                                   Margin="0,0,0,24"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="EmptyChatGreetingText"
                                        Text="Ready when you are"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                        FontSize="34" FontFamily="Georgia"
                                       FontWeight="Normal"
                                         Foreground="{DynamicResource NotebookTextBrush}"
                                       TextAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="Visible"/>
                            <TextBlock Text="A little space to think, explore, and build." Foreground="{DynamicResource DarkSecondaryBrush}" FontSize="13" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Input Area -->
                    <Border Grid.Row="1" BorderThickness="0" Padding="0,8,0,0" Background="Transparent">
                        <StackPanel>
                            <Border x:Name="BranchNavigatorBorder" Visibility="Collapsed" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="32,0,32,8">
                                <DockPanel>
                                    <TextBlock Text="Branch:" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BranchNavigatorCombo" SelectionChanged="BranchNavigatorCombo_SelectionChanged" Margin="8,0,0,0" MinWidth="220" Height="24"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ToolActivityIndicatorHost"
                                    Visibility="Collapsed"
                                     HorizontalAlignment="Center"
                                     Margin="24,0,24,8"
                                    Padding="8,4"
                                       Background="{DynamicResource NotebookSurfaceBrush}"
                                       BorderBrush="{DynamicResource NotebookBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Opacity="0.96">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ToolActivityIndicatorGlyph"
                                               Text="◌"
                                               FontSize="12"
                                                Foreground="{DynamicResource MutedTextBrush}"
                                               FontFamily="Segoe UI"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock x:Name="ToolActivityIndicatorText"
                                               Text=""
                                               FontSize="11"
                                                Foreground="{DynamicResource MutedTextBrush}"
                                               FontFamily="Segoe UI"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Input Container -->
                            <Border x:Name="InputContainerBorder" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0" Margin="32,0,32,24" Opacity="1" HorizontalAlignment="Stretch" MaxWidth="900" MinWidth="320"
                                    AllowDrop="True" PreviewDragOver="InputContainer_PreviewDragOver" PreviewDrop="InputContainer_PreviewDrop">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Attachment preview tray: thumbnail chips built in code-behind,
                                         sitting above the prompt text so the user sees what they attached. -->
                                    <WrapPanel x:Name="AttachmentTrayPanel" Grid.Row="0" Orientation="Horizontal"
                                               Margin="18,16,18,0" Visibility="Collapsed"/>

                                    <Grid Grid.Row="1" MinHeight="78" MaxHeight="180">
                                        <!-- Underlay: gold @MCP mentions (PrimaryAccent) while InputBox ink is transparent -->
                                        <TextBlock x:Name="InputBoxMentionOverlay"
                                                   VerticalAlignment="Top"
                                                   Padding="22,20,22,10"
                                                   Margin="0"
                                                   Background="Transparent"
                                                   FontFamily="Segoe UI"
                                                   FontSize="16"
                                                   TextWrapping="Wrap"
                                                   IsHitTestVisible="False"
                                                   Visibility="Collapsed"/>
                                        <TextBox x:Name="InputBox" VerticalContentAlignment="Top" Padding="22,20,22,10"
                                              Background="Transparent" Foreground="{DynamicResource NotebookTextBrush}" BorderThickness="0" CaretBrush="{DynamicResource NotebookTextBrush}"
                                              FontFamily="Segoe UI" FontSize="16" PreviewKeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged" GotFocus="InputBox_GotFocus" LostFocus="InputBox_LostFocus"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78" MaxHeight="180"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              SelectionBrush="#66B8924A" SelectionOpacity="1"/>
                                        <TextBlock Text="Ask anything" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Segoe UI" FontSize="15"
                                                   Margin="22,20,22,10" IsHitTestVisible="False" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=InputBox, Path=Text}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- @ connector picker (Cloud Mode only; shown from code-behind) -->
                                        <Popup x:Name="McpMentionPopup"
                                               Placement="Top"
                                               PlacementTarget="{Binding ElementName=InputBox}"
                                               StaysOpen="True"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               HorizontalOffset="18"
                                               VerticalOffset="-6">
                                            <Border Background="{DynamicResource NotebookSurfaceBrush}"
                                                    BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="6"
                                                    MinWidth="260"
                                                    MaxWidth="360"
                                                    MaxHeight="220"
                                                    Effect="{StaticResource SoftShadow}">
                                                <ListBox x:Name="McpMentionList"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         FontFamily="Segoe UI"
                                                         FontSize="13"
                                                         Foreground="{DynamicResource NotebookTextBrush}"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         MouseLeftButtonUp="McpMentionList_MouseLeftButtonUp">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding" Value="10,8"/>
                                                            <Setter Property="Margin" Value="0,1"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#2A2724"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding LogoGlyph}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                                    <TextBlock FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}">
                                                                        <Run Text="@"/><Run Text="{Binding Handle}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding AccountLabel}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>


                                    <Grid Grid.Row="2" MinHeight="56" Background="Transparent">
                                        <Grid x:Name="ComposerToolbarGrid" Margin="0,0,0,0" SizeChanged="ComposerToolbarGrid_SizeChanged">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel x:Name="ComposerLeftTools" SizeChanged="ComposerToolbarGrid_SizeChanged" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,10,0,10">
                                                <Button Width="34" Height="34" Margin="0,0,4,0" Click="ImportChatDocument_Click" Style="{StaticResource ChatInputIconButtonStyle}" AutomationProperties.Name="Attach files" ToolTip="Attach files (documents, spreadsheets, presentations, e-books, code, images)">
                                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M6,0 L8,0 L8,6 L14,6 L14,8 L8,8 L8,14 L6,14 L6,8 L0,8 L0,6 L6,6 Z"/>
                                                </Button>
                                                <Button x:Name="SkillsButton" MinWidth="90" Margin="6,0,6,0" Click="OpenSkills_Click" Style="{StaticResource ChatInputUtilityButtonStyle}" ToolTip="Attach reusable Skills to every Axiom model and mode">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path x:Name="SkillsButtonIcon" Width="13" Height="13" Margin="0,0,7,0" Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Data="M7,1 L8.3,4.7 L12,3.4 L9.8,6.7 L13,9 L9,9 L9,13 L6.7,9.8 L3.4,12 L4.7,8.3 L1,7 L4.7,5.7 L3.4,2.2 L6.7,4.2 Z"/>
                                                        <TextBlock x:Name="SkillsButtonLabel" Text="Skills" VerticalAlignment="Center"/>
                                                        <Border x:Name="SkillsButtonBadge" Margin="7,0,0,0" Padding="5,1" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed">
                                                            <TextBlock x:Name="SkillsButtonCountText" Text="0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentMutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="PluginsButton" MinWidth="96" Click="OpenPlugins_Click" Style="{StaticResource ChatInputUtilityButtonStyle}" ToolTip="Attach Axiom-native capability Plugins">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path x:Name="PluginsButtonIcon" Width="13" Height="13" Margin="0,0,7,0" Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Data="M5,1 L9,1 L9,5 L13,5 L13,9 L9,9 L9,13 L5,13 L5,9 L1,9 L1,5 L5,5 Z"/>
                                                        <TextBlock x:Name="PluginsButtonLabel" Text="Plugins" VerticalAlignment="Center"/>
                                                        <Border x:Name="PluginsButtonBadge" Margin="7,0,0,0" Padding="5,1" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed">
                                                            <TextBlock x:Name="PluginsButtonCountText" Text="0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentMutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <Popup x:Name="SkillsPopup"
                                                   Placement="Top"
                                                   PlacementTarget="{Binding ElementName=SkillsButton}"
                                                   AllowsTransparency="True"
                                                   StaysOpen="False"
                                                   PopupAnimation="Fade"
                                                   HorizontalOffset="0"
                                                   VerticalOffset="-10"
                                                   Opened="SkillsPopup_Opened">
                                                <Border x:Name="SkillsFlyoutCard" Width="500" MaxHeight="520" Padding="18" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16" Effect="{StaticResource SoftShadow}" Opacity="1">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform Y="0"/>
                                                    </Border.RenderTransform>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Skills" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                                <TextBlock x:Name="SkillsFlyoutSummaryText" Text="Reusable procedures for specialized work" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Width="28" Height="28" Click="CloseSkills_Click" Style="{StaticResource ChatInputIconButtonStyle}" ToolTip="Close">
                                                                <TextBlock Text="×" FontSize="18" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Margin="0,12,0,12" Text="Attach once and the Skill becomes available to Local, Cloud, Hybrid Local, Council, and Single Model modes. Axiom loads detailed instructions only when the request matches." TextWrapping="Wrap" FontSize="11" LineHeight="16" Foreground="{DynamicResource MutedTextBrush}"/>
                                                        <ScrollViewer Grid.Row="2" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <StackPanel x:Name="SkillsListPanel"/>
                                                        </ScrollViewer>
                                                        <Button Grid.Row="3" Margin="0,14,0,0" Height="38" Click="CreateCustomSkill_Click" Background="{DynamicResource PrimaryAccentBrush}" Foreground="{DynamicResource NotebookBackgroundBrush}" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Content="＋  Create custom Skill"/>
                                                    </Grid>
                                                </Border>
                                            </Popup>

                                            <Popup x:Name="PluginsPopup"
                                                   Placement="Top"
                                                   PlacementTarget="{Binding ElementName=PluginsButton}"
                                                   AllowsTransparency="True"
                                                   StaysOpen="False"
                                                   PopupAnimation="Fade"
                                                   HorizontalOffset="0"
                                                   VerticalOffset="-10"
                                                   Opened="PluginsPopup_Opened">
                                                <Border x:Name="PluginsFlyoutCard" Width="500" MaxHeight="520" Padding="18" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16" Effect="{StaticResource SoftShadow}" Opacity="1">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform Y="0"/>
                                                    </Border.RenderTransform>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Plugins" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                                <TextBlock x:Name="PluginsFlyoutSummaryText" Text="Capability packages built from Axiom's native tools" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Width="28" Height="28" Click="ClosePlugins_Click" Style="{StaticResource ChatInputIconButtonStyle}" ToolTip="Close">
                                                                <TextBlock Text="×" FontSize="18" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Margin="0,12,0,12" Text="Plugins package operating instructions with tools Axiom already owns. Actual availability still follows the selected mode, web setting, and connector configuration." TextWrapping="Wrap" FontSize="11" LineHeight="16" Foreground="{DynamicResource MutedTextBrush}"/>
                                                        <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <StackPanel x:Name="PluginsListPanel"/>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>
                                            </Popup>

                                            <StackPanel x:Name="ComposerRightTools" SizeChanged="ComposerToolbarGrid_SizeChanged" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                                                     <TextBlock Text="{Binding ElementName=HeaderModelName, Path=Text}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                 <Border x:Name="CloudModelSelectorBorder" Height="30" Margin="0,0,8,0" Padding="2" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                                                     <Border.Resources>
                                                         <Style x:Key="ModeSelectorPillButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
                                                             <Setter Property="Height" Value="26"/>
                                                             <Setter Property="Padding" Value="10,0,10,0"/>
                                                             <Setter Property="FontSize" Value="12"/>
                                                             <Setter Property="FontWeight" Value="Medium"/>
                                                               <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                             <Setter Property="Background" Value="Transparent"/>
                                                             <Setter Property="BorderBrush" Value="Transparent"/>
                                                             <Setter Property="BorderThickness" Value="0"/>
                                                             <Setter Property="Cursor" Value="Hand"/>
                                                             <Setter Property="Template">
                                                                 <Setter.Value>
                                                                     <ControlTemplate TargetType="Button">
                                                                         <Border x:Name="border"
                                                                                 Background="{TemplateBinding Background}"
                                                                                 BorderBrush="{TemplateBinding BorderBrush}"
                                                                                 BorderThickness="{TemplateBinding BorderThickness}"
                                                                                 CornerRadius="6">
                                                                             <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                         </Border>
                                                                         <ControlTemplate.Triggers>
                                                                             <Trigger Property="IsPressed" Value="True">
                                                                                 <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                                                             </Trigger>
                                                                             <Trigger Property="IsEnabled" Value="False">
                                                                                 <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                                                             </Trigger>
                                                                         </ControlTemplate.Triggers>
                                                                     </ControlTemplate>
                                                                 </Setter.Value>
                                                             </Setter>
                                                         </Style>
                                                     </Border.Resources>
                                                     <StackPanel Orientation="Horizontal">
                                                         <Button x:Name="Edios15ModelButton" Content="Edios 1.5" Click="Edios15ModelButton_Click" Style="{StaticResource ModeSelectorPillButtonStyle}" ToolTip="Use Google Gemma 4 31B (free)" Margin="0,0,2,0"/>
                                                         <Button x:Name="Hepha25CoderModelButton" Content="Hepha 2.5 Coder" Click="Hepha25CoderModelButton_Click" Style="{StaticResource ModeSelectorPillButtonStyle}" ToolTip="Use NVIDIA Nemotron 3 Ultra (free)"/>
                                                         <Button x:Name="CustomEndpointModelButton" Content="Kestral 1" Click="CustomEndpointModelButton_Click" Style="{StaticResource ModeSelectorPillButtonStyle}" ToolTip="Your local inference server" Visibility="Collapsed"/>
                                                     </StackPanel>
                                                 </Border>
                                                <local:EffortSelector x:Name="NormalEffortSelector" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Button x:Name="NormalThinkingToggleButton" Width="Auto" Height="32" Margin="0,0,8,0" Click="NormalThinkingToggle_Click"
                                                        Style="{StaticResource ChatInputToggleButtonStyle}" ToolTip="Thinking mode disabled" Visibility="Collapsed">
                                                    <TextBlock Text="Think" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                                <ToggleButton x:Name="NormalWebSearchToggleButton" Margin="0,0,8,0" Click="NormalWebSearchToggle_Click"
                                                              Style="{StaticResource ChatComposerToggleStyle}" ToolTip="Normal chat web search enabled"
                                                              AutomationProperties.Name="Web search">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Globe: outline, equator and meridian, stroked from the button foreground
                                                             so it follows the on/off/hover states with the label. -->
                                                        <Grid x:Name="WebToggleIcon" Width="13" Height="13" Margin="0,0,7,0">
                                                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.3"/>
                                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.3"
                                                                  Data="M0.6,6.5 H12.4"/>
                                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.3"
                                                                  Data="M6.5,0.4 C3.7,2.8 3.7,10.2 6.5,12.6 C9.3,10.2 9.3,2.8 6.5,0.4"/>
                                                        </Grid>
                                                        <TextBlock x:Name="WebToggleLabel" Text="Web" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                                <Border x:Name="InlineLoadingIndicator" Visibility="Collapsed" Width="34" Height="34" Margin="0,0,8,0" Background="#00FFFFFF">
                                                    <Canvas x:Name="InlineLoadingSpinnerCanvas" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                        <Canvas.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Canvas.RenderTransform>
                                                         <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="2.2" Opacity="0.24"/>
                                                         <Path Data="M12,2 A10,10 0 0 1 21.2,8" Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Canvas>
                                                </Border>
                                                <Button x:Name="StopButton" Width="34" Height="34" Margin="0,0,8,0" Click="Stop_Click"
                                                        Style="{StaticResource ChatInputStopButtonStyle}" IsEnabled="False"
                                                        ToolTip="Stop generating" AutomationProperties.Name="Stop generating">
                                                    <Border Width="10" Height="10" CornerRadius="2.5"
                                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Button>
                                                <Button x:Name="SendButton" Width="36" Height="36" Click="Send_Click" Style="{StaticResource ChatInputSendButtonStyle}"
                                                        ToolTip="Press Enter to send and Shift+Enter for new line">
                                                    <!-- Thin stroked arrow: lighter than the old solid block glyph and legible
                                                         against the gold fill at 36px. -->
                                                    <Path Width="15" Height="15" Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M7.5,13.2 V2.6 M2.6,7.5 L7.5,2.4 L12.4,7.5"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                </Grid>
            </DockPanel>

            <!-- WORKPLACE VIEW (hidden by default) -->
            <local:WorkplaceView x:Name="WorkplaceViewControl" Visibility="Collapsed" Opacity="0"/>

            <!-- PERSONA MEMORY VIEW -->
            <DockPanel x:Name="PersonaMemoryView" Visibility="Collapsed" Opacity="0" Background="{DynamicResource NotebookBackgroundBrush}">
                <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="32,20" Background="{DynamicResource NotebookSurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Persona Memory" FontSize="28" FontWeight="Normal" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Georgia"/>
                        <TextBlock Text="Dump everything about yourself here — your role, preferences, habits, ongoing projects, and how you like responses. Injected as context in Normal Chat (local and cloud)." FontSize="12" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Margin="32,20,32,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox Text="{Binding PersonaText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" FontSize="13" Padding="12"
                                 Background="{DynamicResource NotebookSurfaceBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"/>
                        <TextBlock IsHitTestVisible="False" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="13" Padding="14,14,14,0"
                                   Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Top"
                                   Visibility="{Binding IsPersonaEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Run Text="Example:&#x0a;&#x0a;I'm a software engineer, mostly working in C# and Python. I like concise, direct answers without unnecessary padding.&#x0a;&#x0a;Current project: a WPF desktop AI chat app called Axiom. I'm working on improving the inference pipeline.&#x0a;&#x0a;Preferences: always use code blocks, avoid bullet overuse, assume I know the basics."/>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" Width="90" Height="34" Style="{StaticResource PremiumButtonStyle}"/>
                        <TextBlock Text="{Binding WordCountLabel}" Margin="12,8,0,0" Foreground="{DynamicResource DarkSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Status}" Margin="12,8,0,0" Foreground="{DynamicResource DarkSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- NEURON VIEW -->
            <DockPanel x:Name="NeuronView" Visibility="Collapsed" Opacity="0" Background="{DynamicResource NotebookBackgroundBrush}">
                <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="32,20" Background="{DynamicResource NotebookSurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Neuron" FontSize="28" FontWeight="Normal" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Georgia"/>
                        <TextBlock x:Name="NeuronSummaryText" Text="Live graph of your activity across Chat and Workplace." FontSize="12" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Grid Margin="24">
                    <Border Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                        <Canvas x:Name="NeuronCanvas" Background="{DynamicResource NotebookBackgroundBrush}" MinHeight="460"/>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- Global Settings Panel Overlay -->
            <Border x:Name="SettingsPanel" Panel.ZIndex="100" Visibility="Collapsed" Background="#CC171615" Opacity="0">
                <Grid>
                    <Border x:Name="SettingsPanelCard" CornerRadius="16" MaxWidth="980" BorderThickness="1" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="24,18" Margin="28,26,28,26" Background="{DynamicResource NotebookSurfaceBrush}" Effect="{StaticResource SoftShadow}">
                        <Border.RenderTransform>
                            <TranslateTransform X="28"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Settings" FontSize="28" FontWeight="Normal" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Georgia" Margin="0,0,0,12"/>

                                <!-- Settings category menu -->
                                <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,16" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SettingsNavInferenceButton" Content="Inference" Click="SettingsNavButton_Click" Tag="Inference"
                                                MinWidth="88" Height="30" Margin="0,0,4,0" Style="{StaticResource SubtleButtonStyle}" FontSize="11"/>
                                        <Button x:Name="SettingsNavCloudButton" Content="Cloud AI" Click="SettingsNavButton_Click" Tag="Cloud"
                                                MinWidth="88" Height="30" Margin="0,0,4,0" Style="{StaticResource SubtleButtonStyle}" FontSize="11"/>
                                        <Button x:Name="SettingsNavConnectorsButton" Content="Connectors" Click="SettingsNavButton_Click" Tag="Connectors"
                                                MinWidth="96" Height="30" Margin="0,0,4,0" Style="{StaticResource SubtleButtonStyle}" FontSize="11"/>
                                        <Button x:Name="SettingsNavGeneralButton" Content="General" Click="SettingsNavButton_Click" Tag="General"
                                                MinWidth="88" Height="30" Style="{StaticResource SubtleButtonStyle}" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ INFERENCE ═══ -->
                                <StackPanel x:Name="SettingsPageInference">
                                <TextBlock Text="Inference Settings" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Temperature" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                        <Slider x:Name="TemperatureSlider" Minimum="0" Maximum="2" Value="0.7" TickFrequency="0.1" Height="24"/>
                                        <TextBlock x:Name="TemperatureValueText" Text="{Binding ElementName=TemperatureSlider, Path=Value, StringFormat={}{0:F1}}" FontSize="12" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Segoe UI" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="Min-P" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                        <Slider x:Name="TopPSlider" Minimum="0" Maximum="1" Value="0.05" TickFrequency="0.05" Height="24"/>
                                        <TextBlock x:Name="TopPValueText" Text="{Binding ElementName=TopPSlider, Path=Value, StringFormat={}{0:F2}}" FontSize="12" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Segoe UI" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Context Length" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                        <Slider x:Name="CtxSlider" Minimum="512" Maximum="32768" Value="8192" TickFrequency="512" Height="24"/>
                                        <TextBlock x:Name="ContextLengthValueText" Text="{Binding ElementName=CtxSlider, Path=Value, StringFormat={}{0:F0} tokens}" FontSize="12" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="Segoe UI" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="InferenceSettingsSourceText"
                                           Text="Local mode active. These controls affect the loaded on-device model."
                                           FontSize="10"
                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                           FontFamily="Segoe UI"
                                           TextWrapping="Wrap"
                                           Margin="0,-10,0,18"/>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,16">
                                    <StackPanel>
                                        <TextBlock Text="System Prompt" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                        <TextBox x:Name="SystemPromptBox" Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" Padding="8" FontFamily="Segoe UI" FontSize="11" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="You are a helpful AI assistant and expert software engineer. Provide clear, concise, and accurate responses. Execute tasks directly and provide final output unless explicitly asked for step-by-step guidance."/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Processing Mode" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="ProcessingModeCombo" SelectionChanged="ProcessingModeCombo_SelectionChanged" Height="30" Width="220" Style="{StaticResource DarkComboBoxStyle}">
                                            <ComboBoxItem Content="CPU Only"/>
                                            <ComboBoxItem Content="GPU Accelerated"/>
                                        </ComboBox>
                                        <TextBlock x:Name="ProcessingRecommendationBlock" Text="Recommended: Detecting hardware..." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,16">
                                    <StackPanel>
                                         <TextBlock Text="Inference Source" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,10"/>
                                         <Border Height="34" Padding="2" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left">
                                             <Border.Resources>
                                                 <Style x:Key="ModeSelectorPillButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
                                                     <Setter Property="Height" Value="28"/>
                                                     <Setter Property="Padding" Value="14,0,14,0"/>
                                                     <Setter Property="FontSize" Value="12"/>
                                                     <Setter Property="FontWeight" Value="Medium"/>
                                                     <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                     <Setter Property="Background" Value="Transparent"/>
                                                     <Setter Property="BorderBrush" Value="Transparent"/>
                                                     <Setter Property="BorderThickness" Value="0"/>
                                                     <Setter Property="Cursor" Value="Hand"/>
                                                     <Setter Property="Template">
                                                         <Setter.Value>
                                                             <ControlTemplate TargetType="Button">
                                                                 <Border x:Name="border"
                                                                         Background="{TemplateBinding Background}"
                                                                         BorderBrush="{TemplateBinding BorderBrush}"
                                                                         BorderThickness="{TemplateBinding BorderThickness}"
                                                                         CornerRadius="6">
                                                                     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                 </Border>
                                                                 <ControlTemplate.Triggers>
                                                                     <Trigger Property="IsPressed" Value="True">
                                                                         <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                                                     </Trigger>
                                                                     <Trigger Property="IsEnabled" Value="False">
                                                                         <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                                                     </Trigger>
                                                                 </ControlTemplate.Triggers>
                                                             </ControlTemplate>
                                                         </Setter.Value>
                                                     </Setter>
                                                 </Style>
                                             </Border.Resources>
                                             <StackPanel Orientation="Horizontal">
                                                 <Button x:Name="LocalModeButton" Content="Local" Click="LocalModeButton_Click" Style="{StaticResource ModeSelectorPillButtonStyle}" ToolTip="Use the local on-device model" Margin="0,0,2,0"/>
                                                 <Button x:Name="HybridLocalModeButton" Content="Hybrid Local" Click="HybridLocalModeButton_Click" Style="{StaticResource ModeSelectorPillButtonStyle}" ToolTip="Configure a custom endpoint in Settings to enable Hybrid Local" Margin="0,0,2,0"/>
                                                 <Button x:Name="CloudModeButton" Content="Cloud" Click="CloudModeButton_Click" Style="{StaticResource ModeSelectorPillButtonStyle}" ToolTip="Add an OpenRouter API key in Settings to enable cloud mode"/>
                                             </StackPanel>
                                         </Border>
                                         <TextBlock Text="Local runs on-device. Hybrid Local sends compute to your own self-hosted inference server. Cloud uses the configured OpenRouter model." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                     </StackPanel>
                                 </Border>
                                </StackPanel>

                                <!-- ═══ CLOUD AI ═══ -->
                                <StackPanel x:Name="SettingsPageCloud" Visibility="Collapsed">
                                 <Border BorderThickness="0,0,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,0,0,16">
                                     <StackPanel>
                                        <TextBlock Text="Cloud AI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,10"/>
                                        <TextBlock Text="OpenRouter API Key" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                                        <PasswordBox x:Name="OpenRouterApiKeyPasswordBox" Height="32" Padding="8,6" Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" PasswordChanged="OpenRouterApiKeyPasswordBox_PasswordChanged"/>
                                        <TextBlock Text="Your key is stored locally. Cloud conversations are subject to the selected model/provider via OpenRouter." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                            <Button x:Name="SaveOpenRouterKeyButton" Content="Save Key" Click="SaveOpenRouterKeyButton_Click" Height="32" MinWidth="100" Style="{StaticResource PremiumButtonStyle}" Background="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}"/>
                                            <Button x:Name="ClearOpenRouterKeyButton" Content="Clear Key" Click="ClearOpenRouterKeyButton_Click" Height="32" MinWidth="90" Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                            <TextBlock x:Name="OpenRouterKeyTestingText" Text="Testing" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <TextBlock x:Name="OpenRouterKeyStatusText" Text="" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                         <StackPanel x:Name="OpenRouterUsagePanel" Margin="0,12,0,0" Visibility="Collapsed">
                                             <Grid Margin="0,0,0,6">
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="Auto"/>
                                                 </Grid.ColumnDefinitions>
                                                 <TextBlock Text="API key usage" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                                 <Button x:Name="RefreshOpenRouterUsageButton"
                                                         Grid.Column="1"
                                                         Width="22"
                                                         Height="22"
                                                         Margin="8,0,0,0"
                                                         Click="RefreshOpenRouterUsageButton_Click"
                                                         Style="{StaticResource ChatInputIconButtonStyle}"
                                                         ToolTip="Refresh usage">
                                                     <TextBlock Text="↻" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                 </Button>
                                             </Grid>
                                             <!-- Pill-shaped usage meter: color-coded fill behind a centered
                                                  "used / limit · remaining" label. Fill is deliberately translucent
                                                  so the label stays readable at any fill level. -->
                                             <Border x:Name="OpenRouterUsageTrack" Height="24" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Stretch" SizeChanged="OpenRouterUsageTrack_SizeChanged">
                                                 <Grid>
                                                     <Border x:Name="OpenRouterUsageFillBar" Width="0" Background="#22C55E" Opacity="0.38" CornerRadius="11" HorizontalAlignment="Left" Margin="1"/>
                                                     <TextBlock x:Name="OpenRouterUsageText"
                                                                Text="0 / 0 requests"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource NotebookTextBrush}"
                                                                FontFamily="Segoe UI"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"/>
                                                 </Grid>
                                             </Border>
                                             <TextBlock x:Name="OpenRouterUsageHintText"
                                                        Text=""
                                                        FontSize="10"
                                                        Foreground="{DynamicResource DarkSecondaryBrush}"
                                                        FontFamily="Segoe UI"
                                                        Margin="0,5,0,0"
                                                        TextWrapping="Wrap"
                                                        Visibility="Collapsed"/>
                                         </StackPanel>
                                         <TextBlock Text="Active cloud model" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,14,0,8"/>
                                         <TextBlock x:Name="OpenRouterDetectedModelText" Text="Edios 1.5" FontSize="11" Foreground="{DynamicResource NotebookTextBrush}" TextWrapping="Wrap"/>
                                         <TextBlock x:Name="OpenRouterDetectedModelIdText" Text="General reasoning profile tuned for Axiom's tool pipeline." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Custom Endpoint" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,10"/>
                                        <TextBlock Text="Base URL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                                        <TextBox x:Name="CustomEndpointBaseUrlBox" Height="32" Padding="8,6" Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" Text="https://your-server.example.com/v1"/>
                                        <TextBlock Text="Model Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,12,0,6"/>
                                        <TextBox x:Name="CustomEndpointModelIdBox" Height="32" Padding="8,6" Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"/>
                                        <TextBlock Text="API Key" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,12,0,6"/>
                                        <PasswordBox x:Name="CustomEndpointApiKeyPasswordBox" Height="32" Padding="8,6" Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"/>
                                        <TextBlock Text="Points at your own OpenAI-compatible server (e.g. a self-hosted proxy). Stored locally." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                            <Button x:Name="SaveCustomEndpointButton" Content="Save" Click="SaveCustomEndpointButton_Click" Height="32" MinWidth="100" Style="{StaticResource PremiumButtonStyle}" Background="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}"/>
                                            <Button x:Name="ClearCustomEndpointButton" Content="Clear" Click="ClearCustomEndpointButton_Click" Height="32" MinWidth="90" Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                            <TextBlock x:Name="CustomEndpointTestingText" Text="Testing" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <TextBlock x:Name="CustomEndpointStatusText" Text="" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ═══ CONNECTORS ═══ -->
                                <StackPanel x:Name="SettingsPageConnectors" Visibility="Collapsed">
                                    <TextBlock Text="Connectors" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="McpConnectorsCloudHintText"
                                               Text="Connect third-party accounts for Cloud Mode. Click Connect, sign in with your browser, then return here. In chat, type @ to mention a connector (e.g. @Gmail, @GitHub, @Todoist)."
                                               FontSize="10"
                                               Foreground="{DynamicResource DarkSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                    <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="OAuth app setup" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="McpOAuthAppStatusText"
                                                       Text=""
                                                       FontSize="10"
                                                       Foreground="{DynamicResource DarkSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"/>
                                            <Button Content="Open OAuth app folder"
                                                    Click="McpOpenOAuthFolderButton_Click"
                                                    Height="30"
                                                    MinWidth="170"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTip="Opens the shared folder for Google/GitHub/Todoist client id + secret files used by Connect."/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Google account (Gmail + Drive) -->
                                    <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Google" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                <TextBlock x:Name="McpGoogleAccountStatusText"
                                                           Text="Not connected — opens your browser to sign in"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock Text="Gmail · Google Drive" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button x:Name="McpConnectGoogleButton"
                                                        Content="Connect"
                                                        Click="McpConnectGoogleButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Style="{StaticResource PremiumButtonStyle}"
                                                        Background="{DynamicResource PrimaryAccentBrush}"
                                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                                        ToolTip="Sign in with Google in your browser"/>
                                                <Button x:Name="McpDisconnectGoogleButton"
                                                        Content="Disconnect"
                                                        Click="McpDisconnectGoogleButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Visibility="Collapsed"
                                                        ToolTip="Disconnect Gmail and Google Drive"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- GitHub account (device flow) -->
                                    <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="GitHub" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                <TextBlock x:Name="McpGitHubAccountStatusText"
                                                           Text="Not connected — opens browser device login"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock Text="Repos · issues · PRs · code" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button x:Name="McpConnectGitHubButton"
                                                        Content="Connect"
                                                        Click="McpConnectGitHubButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Style="{StaticResource PremiumButtonStyle}"
                                                        Background="{DynamicResource PrimaryAccentBrush}"
                                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                                        ToolTip="Sign in with GitHub (device code in browser)"/>
                                                <Button x:Name="McpDisconnectGitHubButton"
                                                        Content="Disconnect"
                                                        Click="McpDisconnectGitHubButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Visibility="Collapsed"
                                                        ToolTip="Disconnect GitHub"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Todoist -->
                                    <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Todoist" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                <TextBlock x:Name="McpTodoistAccountStatusText"
                                                           Text="Not connected — opens browser to sign in"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock Text="Tasks · projects · labels" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button x:Name="McpConnectTodoistButton"
                                                        Content="Connect"
                                                        Click="McpConnectTodoistButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Style="{StaticResource PremiumButtonStyle}"
                                                        Background="{DynamicResource PrimaryAccentBrush}"
                                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                                        ToolTip="Sign in with Todoist in your browser"/>
                                                <Button x:Name="McpDisconnectTodoistButton"
                                                        Content="Disconnect"
                                                        Click="McpDisconnectTodoistButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Visibility="Collapsed"
                                                        ToolTip="Disconnect Todoist"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Dropbox (hidden until McpFeatureFlags.DropboxConnectorEnabled = true) -->
                                    <Border x:Name="McpDropboxConnectorCard"
                                            Background="{DynamicResource NotebookBackgroundBrush}"
                                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Margin="0,0,0,10"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Dropbox" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                <TextBlock x:Name="McpDropboxAccountStatusText"
                                                           Text="Coming soon — pending Dropbox review"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock Text="Files · folders · share" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button x:Name="McpConnectDropboxButton"
                                                        Content="Connect"
                                                        IsEnabled="False"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Style="{StaticResource PremiumButtonStyle}"
                                                        Background="{DynamicResource PrimaryAccentBrush}"
                                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                                        Opacity="0.55"
                                                        ToolTip="Dropbox will unlock after App Console approval"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="McpConnectProgressText"
                                               Text=""
                                               FontSize="10"
                                               Foreground="{DynamicResource PrimaryAccentBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"
                                               Visibility="Collapsed"/>

                                    <TextBlock Text="Active services" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,4,0,8"/>
                                    <StackPanel x:Name="McpConnectorsPanel"/>
                                </StackPanel>

                                <!-- ═══ GENERAL ═══ -->
                                <StackPanel x:Name="SettingsPageGeneral" Visibility="Collapsed">
                                <TextBlock Text="General" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,12"/>

                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,0,0,16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Theme" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                        <TextBlock Text="Recolours every screen. The choice is remembered and applies immediately — no restart."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Grid HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ThemeSelectorCombo"
                                                      Width="240"
                                                      Height="32"
                                                      SelectionChanged="ThemeSelectorCombo_SelectionChanged"
                                                      AutomationProperties.Name="Theme"
                                                      ToolTip="Choose the colour theme for the whole app"/>
                                            <!-- Live swatches: accent, background and foreground of the selected theme,
                                                 so the palette is visible before committing to it. -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Border x:Name="ThemeSwatchAccent" Width="20" Height="20" CornerRadius="6" Margin="0,0,6,0"
                                                        BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" ToolTip="Accent"/>
                                                <Border x:Name="ThemeSwatchBackground" Width="20" Height="20" CornerRadius="6" Margin="0,0,6,0"
                                                        BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" ToolTip="Background"/>
                                                <Border x:Name="ThemeSwatchForeground" Width="20" Height="20" CornerRadius="6"
                                                        BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" ToolTip="Foreground"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="ThemeStatusText"
                                                   Text=""
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderThickness="0,0,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Background &amp; system tray" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="BackgroundExecutionToggle"
                                                  Content="Allow Axiom to continue running after its window is closed"
                                                  IsChecked="False"
                                                  Checked="BackgroundExecutionToggle_Changed"
                                                  Unchecked="BackgroundExecutionToggle_Changed"
                                                  Foreground="{DynamicResource NotebookTextBrush}"
                                                  FontSize="11"/>
                                        <TextBlock x:Name="BackgroundExecutionStatusText"
                                                   Text="Disabled. Closing Axiom fully stops the process."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                        <CheckBox x:Name="SystemTrayToggle"
                                                  Content="Keep Axiom in the Windows system tray"
                                                  IsChecked="False"
                                                  IsEnabled="False"
                                                  Checked="SystemTrayToggle_Changed"
                                                  Unchecked="SystemTrayToggle_Changed"
                                                  Foreground="{DynamicResource NotebookTextBrush}"
                                                  FontSize="11"/>
                                        <TextBlock x:Name="SystemTrayStatusText"
                                                   Text="Enable background operation first."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Workplace notifications" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="CouncilCompletionToastToggle"
                                                  Content="Notify me when a council run finishes while Axiom is in the background"
                                                  IsChecked="True"
                                                  Checked="CouncilCompletionToastToggle_Changed"
                                                  Unchecked="CouncilCompletionToastToggle_Changed"
                                                  Foreground="{DynamicResource NotebookTextBrush}"
                                                  FontSize="11"/>
                                        <TextBlock Text="Clicking the Windows notification restores and focuses Axiom. No notification is shown while this window is active."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Smart Context Compaction" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="SmartCompactionToggle" Content="Enable automatic context optimization" IsChecked="True" Checked="SmartCompactionToggle_Changed" Unchecked="SmartCompactionToggle_Changed" Foreground="{DynamicResource NotebookTextBrush}" FontSize="11"/>
                                        <TextBlock Text="Automatically compresses low-priority messages when context usage reaches 80% of the model's reliability ceiling." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,0" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Application updates" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                                        <TextBlock Text="Axiom checks the official YoMosa2009/Axiom GitHub releases. New ZIP releases can be downloaded, verified, installed, and restarted from inside the app."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="UpdateCheckStatusText"
                                                   Text="Axiom will check GitHub shortly."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Button x:Name="CheckForUpdatesButton"
                                                Content="Check for updates"
                                                Click="CheckForUpdatesButton_Click"
                                                Height="32"
                                                MinWidth="150"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource SubtleButtonStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,0" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Local data" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="AppDataProfilePathText"
                                                   Text=""
                                                   FontSize="10"
                                                   Foreground="{DynamicResource DarkSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Chats, Workplace sessions, settings, API keys, and connectors live only in this machine profile folder — never inside the published app package. Other PCs start fully empty. Debug (VS) uses Axiom-Dev; Release/published builds use Axiom (or AXIOM_DATA_DIR)."
                                                   FontSize="10"
                                                   Foreground="{DynamicResource DarkSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Before shipping a build, run scripts\Publish-CleanRelease.ps1 (or Publish with FolderProfile). To preview the package as a new user on this PC, use RUN-CLEAN-SMOKE-TEST.cmd next to the published exe."
                                                   FontSize="10"
                                                   Foreground="{DynamicResource DarkSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Open data folder"
                                                    Click="OpenLocalAppDataFolderButton_Click"
                                                    Height="32"
                                                    MinWidth="140"
                                                    Margin="0,0,8,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTip="Opens the active profile folder in Explorer."/>
                                            <Button Content="Reset all local app data…"
                                                    Click="ResetLocalAppDataButton_Click"
                                                    Height="32"
                                                    MinWidth="180"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTip="Deletes chats, Workplace sessions, settings, connectors, API keys, and caches for this app profile only. Restart Axiom afterward."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,12,0,0" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AppVersionLabel" Text="Version 1.9.10" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <Button Grid.Column="1" Content="Close Settings" Click="Settings_Click" Height="32" Style="{StaticResource SubtleButtonStyle}" Foreground="{DynamicResource DarkSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Width="120"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Update notification banner: shown on startup when a newer GitHub release exists.
             Slides down + fades in; click downloads and runs the installer; ✕ dismisses. -->
        <Border x:Name="UpdateBannerBorder" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                Panel.ZIndex="9000" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,56,0,0" Visibility="Collapsed" Opacity="0"
                Background="#26231F" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="12"
                Padding="16,10">
            <Border.RenderTransform>
                <TranslateTransform Y="-24"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⬆" FontSize="15" Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateBannerTitleText" Text="Update available" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="UpdateBannerDetailText" Text="" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Segoe UI"
                               Margin="0,2,0,0" MaxWidth="560" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="UpdateBannerActionButton" Content="Update now" Click="UpdateBannerActionButton_Click" Height="30" MinWidth="92" Margin="14,0,0,0"
                        Style="{StaticResource SubtleButtonStyle}" Foreground="{DynamicResource NotebookTextBrush}" Cursor="Hand" VerticalAlignment="Center"/>
                <Button x:Name="UpdateBannerCloseButton" Content="✕" Click="UpdateBannerClose_Click" Width="22" Height="22" Margin="14,0,0,0"
                        Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Cursor="Hand" VerticalAlignment="Center"
                        ToolTip="Dismiss"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
