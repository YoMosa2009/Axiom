                                            </WrapPanel>
                                            <StackPanel x:Name="AxiomAccountSignInForm">
                                                <TextBlock Text="Email" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="AxiomAccountEmailBox" Grid.Column="0" AutomationProperties.Name="Axiom account email"
                                                             Height="32" Padding="8,6" Margin="0,0,8,0"
                                                             Background="{DynamicResource NotebookSurfaceBrush}"
                                                             Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}"/>
                                                    <Button Grid.Column="1" Content="Send sign-in code" Click="SendAxiomAccountCode_Click" Height="32"
                                                            Padding="12,0" Style="{StaticResource SubtleButtonStyle}"/>
                                                </Grid>
                                                <TextBlock Text="Email verification code" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,0,0,4"/>
                                                <PasswordBox x:Name="AxiomAccountCodeBox" AutomationProperties.Name="Axiom email verification code"
                                                             Height="32" Padding="8,6" Margin="0,0,0,8"
                                                             Background="{DynamicResource NotebookSurfaceBrush}"
                                                             Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}"/>
                                                <StackPanel x:Name="AxiomRecoveryKeyEntry" Visibility="Collapsed">
                                                    <TextBlock Text="Saved recovery key" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,0,0,4"/>
                                                    <PasswordBox x:Name="AxiomRecoveryKeyBox" AutomationProperties.Name="Saved Axiom recovery key"
                                                                 Height="32" Padding="8,6" Margin="0,0,0,8"
                                                                 Background="{DynamicResource NotebookSurfaceBrush}"
                                                                 Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}"/>
                                                </StackPanel>
                                                <WrapPanel Margin="0,2,0,0" VerticalAlignment="Center">
                                                    <Button x:Name="AxiomConfirmAccountButton" Content="Create account or sign in"
                                                            Click="ConfirmAxiomAccountCode_Click" Height="32" Margin="0,0,8,4"
                                                            Padding="14,0" Style="{StaticResource PremiumButtonStyle}"
                                                            Background="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}"/>
                                                    <Button x:Name="AxiomRecoveryToggle" Content="Recover with key" Click="ToggleAxiomRecovery_Click"
                                                            Background="Transparent" BorderThickness="0" Padding="4,2" Margin="0,0,8,4"
                                                            FontSize="11" Foreground="{DynamicResource DarkSecondaryBrush}" Cursor="Hand" VerticalAlignment="Center"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <Border x:Name="AxiomSubscriptionPanel" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Margin="0,4,0,0" Padding="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="AxiomCloudPlanTitleText" Text="Sandbox mode" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrightBrush}" Margin="0,0,0,4" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="AxiomSubscriptionStatusText" TextWrapping="Wrap" FontSize="11.5"
                                                               Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,0,0,10"/>
                                                    <WrapPanel x:Name="AxiomSubscriptionActions">
                                                        <Button x:Name="AxiomSubscribeButton" Content="Subscribe — $9/mo" Click="AxiomSubscribeButton_Click"
                                                                Height="34" Padding="18,0" Margin="0,0,8,4" Style="{StaticResource PremiumButtonStyle}"
                                                                Background="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}"/>
                                                        <Button x:Name="AxiomAccountEndpointToggle" Click="ToggleAxiomAccountEndpoint_Click"
                                                                Height="32" Padding="14,0" Margin="0,0,8,4" Style="{StaticResource SubtleButtonStyle}"
                                                                Visibility="Collapsed"/>
                                                        <Button x:Name="AxiomManageSubscriptionButton" Content="Manage billing"
                                                                Click="AxiomManageSubscriptionButton_Click" Height="32" Padding="14,0" Margin="0,0,8,4"
                                                                Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed"/>
                                                        <Button x:Name="AxiomRefreshSubscriptionButton" Content="Refresh billing"
                                                                Click="AxiomRefreshSubscriptionButton_Click" Height="32" Padding="14,0" Margin="0,0,8,4"
                                                                Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                            <Button x:Name="AxiomViewUsageButton" Content="View Usage" Click="OpenUsageFromCloudAi_Click"
                                                    Background="Transparent" BorderThickness="0" Padding="0,2" Cursor="Hand"
                                                    FontSize="10.5" Foreground="{DynamicResource PrimaryAccentBrush}" Visibility="Collapsed"/>
                                            <TextBlock x:Name="AxiomPaidLinksSeparator" Text=" · " FontSize="10.5" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" Visibility="Collapsed"/>
                                            <Button x:Name="CopyAxiomRecoveryKeyButton" Content="Recovery key" Click="CopyAxiomRecoveryKey_Click"
                                                    Background="Transparent" BorderThickness="0" Padding="0,2" Cursor="Hand"
                                                    FontSize="10.5" Foreground="{DynamicResource DarkSecondaryBrush}" Visibility="Collapsed"/>
                                            <TextBlock x:Name="AxiomRecoverySeparator" Text=" · " FontSize="10.5" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" Visibility="Collapsed"/>
                                            <Button Content="Terms of Service" Click="OpenTermsOfService_Click" Background="Transparent" BorderThickness="0" Padding="0,2" Cursor="Hand"
                                                    FontSize="10.5" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                            <TextBlock Text=" · " FontSize="10.5" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" Margin="6,0"/>
                                            <Button Content="Privacy Policy" Click="OpenPrivacyPolicy_Click" Background="Transparent" BorderThickness="0" Padding="0,2" Cursor="Hand"
                                                    FontSize="10.5" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Bring Your Own Key (OpenRouter) -->
                                <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="OpenRouter (Bring Your Own Key)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,10"/>
                                        <TextBlock Text="OpenRouter API Key" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,6"/>
                                        <PasswordBox x:Name="OpenRouterApiKeyPasswordBox" Height="32" Padding="8,6" Background="{DynamicResource NotebookSurfaceBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" PasswordChanged="OpenRouterApiKeyPasswordBox_PasswordChanged"/>
                                        <TextBlock Text="Your key is stored locally. Cloud conversations are subject to the selected model/provider via OpenRouter." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                            <Button x:Name="SaveOpenRouterKeyButton" Content="Save Key" Click="SaveOpenRouterKeyButton_Click" Height="32" MinWidth="100" Style="{StaticResource PremiumButtonStyle}" Background="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}"/>
                                            <Button x:Name="ClearOpenRouterKeyButton" Content="Clear Key" Click="ClearOpenRouterKeyButton_Click" Height="32" MinWidth="90" Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                            <TextBlock x:Name="OpenRouterKeyTestingText" Text="Testing" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <TextBlock x:Name="OpenRouterKeyStatusText" Text="" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <StackPanel x:Name="OpenRouterUsagePanel" Margin="0,12,0,0" Visibility="Collapsed">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Daily free-model requests" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" VerticalAlignment="Center"/>
                                                <Button x:Name="RefreshOpenRouterUsageButton"
                                                        Grid.Column="1"
                                                        Width="22"
                                                        Height="22"
                                                        Margin="8,0,0,0"
                                                        Click="RefreshOpenRouterUsageButton_Click"
                                                        Style="{StaticResource ChatInputIconButtonStyle}"
                                                        ToolTip="Refresh usage">
                                                    <TextBlock Text="↻" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                            <!-- The fill and label both represent remaining daily requests. -->
                                            <Border x:Name="OpenRouterUsageTrack" Height="24" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Stretch" SizeChanged="OpenRouterUsageTrack_SizeChanged">
                                                <Grid>
                                                    <Border x:Name="OpenRouterUsageFillBar" Width="0" Background="{DynamicResource PrimaryAccentBrush}" Opacity="0.45" CornerRadius="11" HorizontalAlignment="Left" Margin="1"/>
                                                    <TextBlock x:Name="OpenRouterUsageText"
                                                               Text="No usage data yet"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource NotebookTextBrush}"
                                                               FontFamily="{DynamicResource AppUiFont}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="OpenRouterUsageHintText"
                                                       Text=""
                                                       FontSize="10"
                                                       Foreground="{DynamicResource DarkSecondaryBrush}"
                                                       FontFamily="{DynamicResource AppUiFont}"
                                                       Margin="0,5,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed"/>
                                        </StackPanel>
                                        <TextBlock Text="Active cloud model" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,14,0,6"/>
                                        <TextBlock x:Name="OpenRouterDetectedModelText" Text="Edios 1.5" FontSize="11" Foreground="{DynamicResource NotebookTextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="OpenRouterDetectedModelIdText" Text="General reasoning profile tuned for Axiom's tool pipeline." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Custom Endpoint (Self-Hosted / Hybrid Local) -->
                                <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Custom Endpoint (Hybrid Local)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Base URL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="CustomEndpointBaseUrlBox" Height="32" Padding="8,6" Background="{DynamicResource NotebookSurfaceBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" Text="https://your-server.example.com/v1"/>
                                        <TextBlock Text="Model Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,12,0,6"/>
                                        <TextBox x:Name="CustomEndpointModelIdBox" Height="32" Padding="8,6" Background="{DynamicResource NotebookSurfaceBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"/>
                                        <TextBlock Text="API Key" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,12,0,6"/>
                                        <PasswordBox x:Name="CustomEndpointApiKeyPasswordBox" Height="32" Padding="8,6" Background="{DynamicResource NotebookSurfaceBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"/>
                                        <TextBlock Text="Points at your own OpenAI-compatible server (e.g. Ollama, LM Studio, or self-hosted vLLM). Stored locally." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                            <Button x:Name="SaveCustomEndpointButton" Content="Save" Click="SaveCustomEndpointButton_Click" Height="32" MinWidth="100" Style="{StaticResource PremiumButtonStyle}" Background="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}"/>
                                            <Button x:Name="ClearCustomEndpointButton" Content="Clear" Click="ClearCustomEndpointButton_Click" Height="32" MinWidth="90" Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                            <TextBlock x:Name="CustomEndpointTestingText" Text="Testing" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <TextBlock x:Name="CustomEndpointStatusText" Text="" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ═══ CONNECTORS ═══ -->
                                <StackPanel x:Name="SettingsPageConnectors" Visibility="Collapsed">
                                    <TextBlock Text="Connectors" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="McpConnectorsCloudHintText"
                                               Text="Connect third-party accounts for Cloud Mode. Click Connect, sign in with your browser, then return here. In chat, type @ to mention a connector (e.g. @Gmail, @GitHub, @Todoist)."
                                               FontSize="10"
                                               Foreground="{DynamicResource DarkSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                    <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="OAuth app setup" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="McpOAuthAppStatusText"
                                                       Text=""
                                                       FontSize="10"
                                                       Foreground="{DynamicResource DarkSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"/>
                                            <Button Content="Open OAuth app folder"
                                                    Click="McpOpenOAuthFolderButton_Click"
                                                    Height="30"
                                                    MinWidth="170"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTip="Opens the shared folder for Google/GitHub/Todoist client id + secret files used by Connect."/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Google account (Gmail + Drive) -->
                                    <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Google" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                <TextBlock x:Name="McpGoogleAccountStatusText"
                                                           Text="Not connected — opens your browser to sign in"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock Text="Gmail · Google Drive" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button x:Name="McpConnectGoogleButton"
                                                        Content="Connect"
                                                        Click="McpConnectGoogleButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Style="{StaticResource PremiumButtonStyle}"
                                                        Background="{DynamicResource PrimaryAccentBrush}"
                                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                                        ToolTip="Sign in with Google in your browser"/>
                                                <Button x:Name="McpDisconnectGoogleButton"
                                                        Content="Disconnect"
                                                        Click="McpDisconnectGoogleButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Visibility="Collapsed"
                                                        ToolTip="Disconnect Gmail and Google Drive"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- GitHub account (device flow) -->
                                    <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="GitHub" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                <TextBlock x:Name="McpGitHubAccountStatusText"
                                                           Text="Not connected — opens browser device login"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock Text="Repos · issues · PRs · code" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button x:Name="McpConnectGitHubButton"
                                                        Content="Connect"
                                                        Click="McpConnectGitHubButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Style="{StaticResource PremiumButtonStyle}"
                                                        Background="{DynamicResource PrimaryAccentBrush}"
                                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                                        ToolTip="Sign in with GitHub (device code in browser)"/>
                                                <Button x:Name="McpDisconnectGitHubButton"
                                                        Content="Disconnect"
                                                        Click="McpDisconnectGitHubButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Visibility="Collapsed"
                                                        ToolTip="Disconnect GitHub"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Todoist -->
                                    <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Todoist" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                <TextBlock x:Name="McpTodoistAccountStatusText"
                                                           Text="Not connected — opens browser to sign in"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock Text="Tasks · projects · labels" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button x:Name="McpConnectTodoistButton"
                                                        Content="Connect"
                                                        Click="McpConnectTodoistButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Style="{StaticResource PremiumButtonStyle}"
                                                        Background="{DynamicResource PrimaryAccentBrush}"
                                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                                        ToolTip="Sign in with Todoist in your browser"/>
                                                <Button x:Name="McpDisconnectTodoistButton"
                                                        Content="Disconnect"
                                                        Click="McpDisconnectTodoistButton_Click"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Visibility="Collapsed"
                                                        ToolTip="Disconnect Todoist"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Dropbox (hidden until McpFeatureFlags.DropboxConnectorEnabled = true) -->
                                    <Border x:Name="McpDropboxConnectorCard"
                                            Background="{DynamicResource NotebookBackgroundBrush}"
                                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Margin="0,0,0,10"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Dropbox" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                <TextBlock x:Name="McpDropboxAccountStatusText"
                                                           Text="Coming soon — pending Dropbox review"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock Text="Files · folders · share" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button x:Name="McpConnectDropboxButton"
                                                        Content="Connect"
                                                        IsEnabled="False"
                                                        MinWidth="100"
                                                        Height="32"
                                                        Style="{StaticResource PremiumButtonStyle}"
                                                        Background="{DynamicResource PrimaryAccentBrush}"
                                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                                        Opacity="0.55"
                                                        ToolTip="Dropbox will unlock after App Console approval"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="McpConnectProgressText"
                                               Text=""
                                               FontSize="10"
                                               Foreground="{DynamicResource PrimaryAccentBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"
                                               Visibility="Collapsed"/>

                                    <TextBlock Text="Active services" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,4,0,8"/>
                                    <StackPanel x:Name="McpConnectorsPanel"/>
                                </StackPanel>

                                <!-- ═══ GENERAL ═══ -->
                                <StackPanel x:Name="SettingsPageGeneral" Visibility="Collapsed">
                                <TextBlock Text="General" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,12"/>

                                <!-- Your Profile card (Requirement #15) -->
                                <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource AxiomIconFont}" FontSize="15" LineHeight="Auto"
                                                       Foreground="{DynamicResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="ProfileCardTitleText" Text="Your Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" LineHeight="16"/>
                                            <TextBlock x:Name="ProfileCardSubtitleText" Text="0 lifetime tokens · 0 day streak" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,12,0" LineHeight="14"/>
                                        </StackPanel>
                                        <Button x:Name="OpenYourProfileButton" Grid.Column="2" Content="Your Profile" Click="OpenYourProfileButton_Click"
                                                Height="30" MinWidth="120" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xED15;" FontFamily="{StaticResource AxiomIconFont}" FontSize="18" LineHeight="Auto"
                                                   Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Send feedback or report a problem" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}"/>
                                            <TextBlock Text="Found a bug or have an idea? Tell the developer directly. Chats, files and keys are never included."
                                                       FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,12,0"/>
                                        </StackPanel>
                                        <Button x:Name="SendFeedbackButton" Grid.Column="2" Content="Send feedback…" Click="SendFeedbackButton_Click"
                                                Height="32" MinWidth="140" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,0,0,16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Theme" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Recolours every screen. The choice is remembered and applies immediately — no restart."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Grid HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ThemeSelectorCombo"
                                                      Width="240"
                                                      Height="32"
                                                      SelectionChanged="ThemeSelectorCombo_SelectionChanged"
                                                      AutomationProperties.Name="Theme"
                                                      ToolTip="Choose the colour theme for the whole app"/>
                                            <!-- Live swatches: accent, background and foreground of the selected theme,
                                                 so the palette is visible before committing to it. -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Border x:Name="ThemeSwatchAccent" Width="20" Height="20" CornerRadius="6" Margin="0,0,6,0"
                                                        BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" ToolTip="Accent"/>
                                                <Border x:Name="ThemeSwatchBackground" Width="20" Height="20" CornerRadius="6" Margin="0,0,6,0"
                                                        BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" ToolTip="Background"/>
                                                <Border x:Name="ThemeSwatchForeground" Width="20" Height="20" CornerRadius="6"
                                                        BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" ToolTip="Foreground"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="ThemeStatusText"
                                                   Text=""
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderThickness="0,0,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Background &amp; system tray" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="BackgroundExecutionToggle"
                                                  Content="Allow Axiom to continue running after its window is closed"
                                                  IsChecked="False"
                                                  Checked="BackgroundExecutionToggle_Changed"
                                                  Unchecked="BackgroundExecutionToggle_Changed"
                                                  Foreground="{DynamicResource NotebookTextBrush}"
                                                  FontSize="11"/>
                                        <TextBlock x:Name="BackgroundExecutionStatusText"
                                                   Text="Disabled. Closing Axiom fully stops the process."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                        <CheckBox x:Name="SystemTrayToggle"
                                                  Content="Keep Axiom in the Windows system tray"
                                                  IsChecked="False"
                                                  IsEnabled="False"
                                                  Checked="SystemTrayToggle_Changed"
                                                  Unchecked="SystemTrayToggle_Changed"
                                                  Foreground="{DynamicResource NotebookTextBrush}"
                                                  FontSize="11"/>
                                        <TextBlock x:Name="SystemTrayStatusText"
                                                   Text="Enable background operation first."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Workplace notifications" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="CouncilCompletionToastToggle"
                                                  Content="Notify me when a Workplace run finishes in the background"
                                                  IsChecked="True"
                                                  Checked="CouncilCompletionToastToggle_Changed"
                                                  Unchecked="CouncilCompletionToastToggle_Changed"
                                                  Foreground="{DynamicResource NotebookTextBrush}"
                                                  FontSize="11"/>
                                        <TextBlock Text="Windows plays its notification sound when enabled. Click the notification to reopen Axiom."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Smart Context Compaction" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="SmartCompactionToggle" Content="Enable automatic context optimization" IsChecked="True" Checked="SmartCompactionToggle_Changed" Unchecked="SmartCompactionToggle_Changed" Foreground="{DynamicResource NotebookTextBrush}" FontSize="11"/>
                                        <TextBlock Text="Automatically compresses low-priority messages when context usage reaches 80% of the model's reliability ceiling." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,0" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Diagnostics" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="DiagnosticsToggle" Content="Send anonymous error reports and usage counts" IsChecked="True"
                                                  Checked="DiagnosticsToggle_Changed" Unchecked="DiagnosticsToggle_Changed"
                                                  Foreground="{DynamicResource NotebookTextBrush}" FontSize="11"
                                                  AutomationProperties.Name="Send anonymous error reports and usage counts"/>
                                        <TextBlock Text="Helps fix crashes and errors. Sends the error type, where in Axiom it happened (with personal details removed), the app and Windows version, and counts such as which mode you chat in. Never your chats, files, notes, keys or account. Turning this off also deletes anything not yet sent."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,0" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Application updates" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Axiom checks the official YoMosa2009/Axiom GitHub releases. New ZIP releases can be downloaded, verified, installed, and restarted from inside the app."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="UpdateCheckStatusText"
                                                   Text="Axiom will check GitHub shortly."
                                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Button x:Name="CheckForUpdatesButton"
                                                Content="Check for updates"
                                                Click="CheckForUpdatesButton_Click"
                                                Height="32"
                                                MinWidth="150"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource SubtleButtonStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,16,0,0" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Local data" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="AppDataProfilePathText"
                                                   Text=""
                                                   FontSize="10"
                                                   Foreground="{DynamicResource DarkSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Your chats, Workplace sessions, settings, API keys and connectors are stored only in this folder on this PC. They are never part of the app itself, and nothing is shared with other PCs."
                                                   FontSize="10"
                                                   Foreground="{DynamicResource DarkSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Open data folder"
                                                    Click="OpenLocalAppDataFolderButton_Click"
                                                    Height="32"
                                                    MinWidth="140"
                                                    Margin="0,0,8,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTip="Opens the active profile folder in Explorer."/>
                                            <Button Content="Reset all local app data…"
                                                    Click="ResetLocalAppDataButton_Click"
                                                    Height="32"
                                                    MinWidth="180"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTip="Deletes chats, Workplace sessions, settings, connectors, API keys, and caches for this app profile only. Restart Axiom afterward."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- ═══ YOUR PROFILE (Image 7) ═══ -->
                                <StackPanel x:Name="SettingsPageProfile" Visibility="Collapsed" Margin="0,0,0,12">
                                    <Button Content="← Back to General"
                                            Click="BackToGeneralSettings_Click"
                                            HorizontalAlignment="Left"
                                            Height="28"
                                            Padding="10,0"
                                            FontSize="11"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Margin="0,0,0,14"/>

                                    <!-- Clickable user display name ("Your Name" by default) -->
                                    <Button x:Name="ProfileDisplayNameButton"
                                            Click="EditProfileName_Click"
                                            HorizontalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="12,4"
                                            ToolTip="Click to change your name"
                                            Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ProfileDisplayNameText"
                                                       Text="Your Name"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource NotebookTextBrush}"
                                                       LineHeight="26"/>
                                            <TextBlock Text="&#xE70F;"
                                                       FontFamily="{StaticResource AxiomIconFont}"
                                                       FontSize="11"
                                                       LineHeight="Auto"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Stats pill bar (Lifetime tokens, Longest streak, Current streak) -->
                                    <Border Background="{DynamicResource NotebookBackgroundBrush}"
                                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12"
                                            Margin="0,0,0,22">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock x:Name="ProfileLifetimeTokensText" Text="0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" HorizontalAlignment="Center" LineHeight="20"/>
                                                <TextBlock Text="Lifetime tokens" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" LineHeight="14"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Width="1" Background="{DynamicResource NotebookBorderBrush}" Margin="6,2"/>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock x:Name="ProfileLongestStreakText" Text="0 days" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" HorizontalAlignment="Center" LineHeight="20"/>
                                                <TextBlock Text="Longest streak" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" LineHeight="14"/>
                                            </StackPanel>

                                            <Border Grid.Column="3" Width="1" Background="{DynamicResource NotebookBorderBrush}" Margin="6,2"/>

                                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                                <TextBlock x:Name="ProfileCurrentStreakText" Text="0 days" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" HorizontalAlignment="Center" LineHeight="20"/>
                                                <TextBlock Text="Current streak" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" LineHeight="14"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Token Activity 52-week themed heatmap -->
                                    <Grid Margin="2,0,2,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Token activity" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" VerticalAlignment="Center" LineHeight="18"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="ProfileModeDailyButton" Content="Daily" Tag="Daily" Click="ProfileModeButton_Click"
                                                    Background="Transparent" BorderThickness="0" Padding="8,3" FontSize="11" Height="24" Margin="0,0,2,0"/>
                                            <Button x:Name="ProfileModeWeeklyButton" Content="Weekly" Tag="Weekly" Click="ProfileModeButton_Click"
                                                    Background="Transparent" BorderThickness="0" Padding="8,3" FontSize="11" Height="24" Margin="0,0,2,0"/>
                                            <Button x:Name="ProfileModeCumulativeButton" Content="Cumulative" Tag="Cumulative" Click="ProfileModeButton_Click"
                                                    Background="Transparent" BorderThickness="0" Padding="8,3" FontSize="11" Height="24"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource NotebookBackgroundBrush}"
                                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,12,12,10">
                                        <StackPanel>
                                            <UniformGrid x:Name="ProfileHeatmapGrid" Columns="52" Rows="7"/>
                                            <Grid x:Name="ProfileMonthLabelsGrid" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ═══ USAGE (Subscription 3-hour session & weekly pacing) ═══ -->
                                <StackPanel x:Name="SettingsPageUsage" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Usage" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}"/>
                                            <TextBlock Text="DeepSeek 4.1F-1017 · Axiom subscription" FontSize="11" Foreground="{DynamicResource DarkSecondaryBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="RefreshAxiomUsageButton"
                                                Grid.Column="1"
                                                Click="RefreshAxiomUsageButton_Click"
                                                Height="30"
                                                Padding="12,0"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                VerticalAlignment="Center"
                                                ToolTip="Refresh subscription usage">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="↻" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Refresh" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Border x:Name="AxiomUsageNoticeBorder"
                                            Visibility="Collapsed"
                                            Background="{DynamicResource NotebookBackgroundBrush}"
                                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12"
                                            Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="AxiomUsageNoticeText"
                                                       Text="Sign in to your Axiom account in Settings → Cloud AI to view DeepSeek 4.1F-1017 usage."
                                                       FontSize="12"
                                                       Foreground="{DynamicResource DarkSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                            <Button Grid.Column="1"
                                                    Content="Open Cloud AI"
                                                    Click="OpenCloudAiFromUsage_Click"
                                                    Height="30"
                                                    Padding="12,0"
                                                    FontSize="11"
                                                    Style="{StaticResource SubtleButtonStyle}"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource NotebookBackgroundBrush}"
                                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="20,18">
                                        <StackPanel>
                                            <!-- Row 1: Current session (3-hour window) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="84"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Current session" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}"/>
                                                    <TextBlock x:Name="AxiomSessionUsageResetText" Text="Starts with your first message" FontSize="12" Foreground="{DynamicResource DarkSecondaryBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border x:Name="AxiomSessionUsageTrack"
                                                        Grid.Column="1"
                                                        Height="6"
                                                        CornerRadius="3"
                                                        Background="#2E2D2C"
                                                        ClipToBounds="True"
                                                        VerticalAlignment="Center"
                                                        Margin="18,0,18,0"
                                                        SizeChanged="AxiomUsageTrack_SizeChanged">
                                                    <Border x:Name="AxiomSessionUsageFill"
                                                            Height="6"
                                                            Width="0"
                                                            CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            Background="#3B82F6"/>
                                                </Border>
                                                <TextBlock x:Name="AxiomSessionUsagePercentText"
                                                           Grid.Column="2"
                                                           Text="0% used"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                                           FontFamily="{DynamicResource AppUiFont}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Row 2: This week (7-day window) -->
                                            <Grid Margin="0,24,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="84"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="This week" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}"/>
                                                    <TextBlock x:Name="AxiomWeeklyUsageResetText" Text="Resets every 7 days" FontSize="12" Foreground="{DynamicResource DarkSecondaryBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border x:Name="AxiomWeeklyUsageTrack"
                                                        Grid.Column="1"
                                                        Height="6"
                                                        CornerRadius="3"
                                                        Background="#2E2D2C"
                                                        ClipToBounds="True"
                                                        VerticalAlignment="Center"
                                                        Margin="18,0,18,0"
                                                        SizeChanged="AxiomUsageTrack_SizeChanged">
                                                    <Border x:Name="AxiomWeeklyUsageFill"
                                                            Height="6"
                                                            Width="0"
                                                            CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            Background="#3B82F6"/>
                                                </Border>
                                                <TextBlock x:Name="AxiomWeeklyUsagePercentText"
                                                           Grid.Column="2"
                                                           Text="0% used"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource DarkSecondaryBrush}"
                                                           FontFamily="{DynamicResource AppUiFont}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="AxiomUsageFooterText"
                                               Text="3-hour session and weekly limits help stretch your monthly DeepSeek 4.1F-1017 subscription."
                                               FontSize="10.5"
                                               Foreground="{DynamicResource DarkSecondaryBrush}"
                                               FontFamily="{DynamicResource AppUiFont}"
                                               TextWrapping="Wrap"
                                               Margin="2,10,2,0"/>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NotebookBorderBrush}" Padding="0,12,0,0" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AppVersionLabel" Text="Version 1.14.0" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" FontFamily="{DynamicResource AppUiFont}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <Button Grid.Column="1" Content="Close Settings" Click="Settings_Click" Height="32" Style="{StaticResource SubtleButtonStyle}" Foreground="{DynamicResource DarkSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Width="120"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        <!-- Update notification banner: shown on startup when a newer GitHub release exists.
             Slides down + fades in; click downloads and runs the installer; ✕ dismisses. -->
        <Border x:Name="UpdateBannerBorder" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                Panel.ZIndex="9000" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,56,0,0" Visibility="Collapsed" Opacity="0"
                Background="#26231F" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="12"
                Padding="16,10">
            <Border.RenderTransform>
                <TranslateTransform Y="-24"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⬆" FontSize="15" Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateBannerTitleText" Text="Update available" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" FontFamily="{DynamicResource AppUiFont}"/>
                    <TextBlock x:Name="UpdateBannerDetailText" Text="" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource AppUiFont}"
                               Margin="0,2,0,0" MaxWidth="560" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="UpdateBannerActionButton" Content="Update now" Click="UpdateBannerActionButton_Click" Height="30" MinWidth="92" Margin="14,0,0,0"
                        Style="{StaticResource SubtleButtonStyle}" Foreground="{DynamicResource NotebookTextBrush}" Cursor="Hand" VerticalAlignment="Center"/>
                <Button x:Name="UpdateBannerCloseButton" Content="✕" Click="UpdateBannerClose_Click" Width="22" Height="22" Margin="14,0,0,0"
                        Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Cursor="Hand" VerticalAlignment="Center"
                        ToolTip="Dismiss"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
