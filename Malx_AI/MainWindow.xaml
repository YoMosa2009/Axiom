                                        <Slider x:Name="TemperatureSlider" Minimum="0" Maximum="2" Value="0.7" TickFrequency="0.1" Height="24"/>
                                        <TextBlock x:Name="TemperatureValueText" Text="{Binding ElementName=TemperatureSlider, Path=Value, StringFormat={}{0:F1}}" FontSize="12" Foreground="{DynamicResource PrimaryAccentBrush}" FontFamily="{DynamicResource AppUiFont}" Margin="0,6,0,0" FontWeight="SemiBold"/>
