                                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" DockPanel.Dock="Left" VerticalAlignment="Center">
