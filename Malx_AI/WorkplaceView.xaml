<UserControl x:Class="Malx_AI.WorkplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Malx_AI"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="WorkplaceToolMenuRowStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="WorkplaceTokenMeterProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="{TemplateBinding Height}" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CouncilSidebarColumn" Width="0" MinWidth="0" MaxWidth="0"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="CanvasColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Configuration Popup (relocated from crowded left sidebar to keep Workplace clean like Image 13) -->
        <Popup x:Name="WorkplaceConfigPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=WorkplaceConfigButton}"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               VerticalOffset="6">
            <Border Width="310" MaxHeight="560"
                    Background="{DynamicResource NotebookSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <ScrollViewer x:Name="CouncilSidebarScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" PreviewMouseWheel="SidebarScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="14,14,14,16">
                        <Border CornerRadius="7" Padding="2"
                                Background="{DynamicResource NotebookBackgroundBrush}"
                                BorderBrush="{DynamicResource NotebookBorderBrush}"
                                BorderThickness="1">
                            <Grid Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CouncilModeSegmentButton" Grid.Column="0"
                                        Content="Builder + Critic"
                                        Click="CouncilModeSegmentButton_Click"
                                        FontSize="10.5" FontWeight="SemiBold"
                                        Cursor="Hand" Padding="6,0"
                                        ToolTip="Council mode: Builder executes directly; Extra High / Ultra add Critic verification">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="SingleModelModeSegmentButton" Grid.Column="1"
                                        Content="Single Model"
                                        Click="SingleModelModeSegmentButton_Click"
                                        FontSize="10.5" FontWeight="SemiBold"
                                        Cursor="Hand" Padding="6,0"
                                        ToolTip="Single Model mode: one agentic model handles the whole workplace chat">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Builder -->
                        <Border x:Name="RoleContextControlsCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Builder" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BuilderModelBlock" Text="No model selected" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,8"/>
                                <Button x:Name="LoadBuilderModelButton" Content="Load Builder Model" Click="LoadBuilderModel_Click" Height="28" Style="{StaticResource SubtleButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Critic -->
                        <Border x:Name="ManualRoleContextControlsCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Critic (Extra High / Ultra)" FontSize="11" FontWeight="SemiBold"/>
                                    <Border Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="6,1" Margin="6,0,0,0" DockPanel.Dock="Right">
                                        <TextBlock x:Name="CriticSensitivityBadgeText" Text="Standard" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                    </Border>
                                </DockPanel>
                                <TextBlock x:Name="CriticModelBlock" Text="No model selected" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,8"/>
                                <Button x:Name="LoadCriticModelButton" Content="Load Critic Model" Click="LoadCriticModel_Click" Height="28" Style="{StaticResource SubtleButtonStyle}"/>
                                <TextBlock Text="Critic Sensitivity" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,6,0,3"/>
                                <ComboBox x:Name="CriticSensitivityCombo" SelectionChanged="CriticSensitivityCombo_SelectionChanged" Height="24" SelectedIndex="0">
                                    <ComboBoxItem Content="Standard"/>
                                    <ComboBoxItem Content="Strict"/>
                                    <ComboBoxItem Content="Critical Only"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Single Model -->
                        <Border x:Name="SingleModelModelCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Single Model" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SingleModelModelBlock" Text="No model selected" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,8"/>
                                <Button x:Name="LoadSingleModelButton" Content="Load Single Model" Click="LoadSingleModel_Click" Height="28" Style="{StaticResource SubtleButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SingleModelContextCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Model Context" FontSize="11" FontWeight="SemiBold"/>
                                <Slider x:Name="SingleModelContextSlider" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" Value="8192" ValueChanged="SingleModelContextSlider_ValueChanged"/>
                                <TextBlock x:Name="SingleModelContextValueText" Text="8192 tokens" FontSize="10" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CouncilContextControlsCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="CouncilContextControlsTitle" Text="Context Controls" FontSize="11" FontWeight="SemiBold"/>
                                <CheckBox x:Name="AutoOptimizeContextToggle" Content="Auto optimize (model-aware)" IsChecked="True" Margin="0,6,0,6" Checked="AutoOptimizeContextToggle_Changed" Unchecked="AutoOptimizeContextToggle_Changed"/>
                                <TextBlock x:Name="CloudContextInfoBlock" Visibility="Collapsed" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <Button x:Name="WorkplaceHybridToggleButton" Content="Use Hybrid Local (Kestral 1)" Click="WorkplaceHybridToggleButton_Click"
                                        Visibility="Collapsed" HorizontalAlignment="Left" FontSize="10" Padding="8,3" Margin="0,0,0,6"
                                        Style="{StaticResource SubtleButtonStyle}" ToolTip="Route Workplace through your self-hosted endpoint instead of OpenRouter"/>

                                <StackPanel x:Name="ContextSlidersPanel">
                                    <TextBlock Text="Global Context" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                    <Slider x:Name="GlobalContextSlider" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" Value="8192" ValueChanged="GlobalContextSlider_ValueChanged"/>
                                    <TextBlock x:Name="GlobalContextValueText" Text="8192 tokens" FontSize="10" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,2,0,6"/>

                                    <TextBlock Text="Builder Context" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                    <Slider x:Name="BuilderContextSlider" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" Value="8192" ValueChanged="RoleContextSlider_ValueChanged"/>
                                    <TextBlock x:Name="BuilderContextValueText" Text="8192 tokens" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,6"/>

                                    <TextBlock Text="Critic Context" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                    <Slider x:Name="CriticContextSlider" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" Value="4096" ValueChanged="RoleContextSlider_ValueChanged"/>
                                    <TextBlock x:Name="CriticContextValueText" Text="4096 tokens" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Computer Agent controls (also mirrored in composer pills) -->
                        <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Computer Agent" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <Border x:Name="AgentStateBadge" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="6,1" Margin="6,0,0,0" DockPanel.Dock="Right">
                                        <TextBlock x:Name="AgentStateText" Text="Off" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                    </Border>
                                </DockPanel>
                                <Button x:Name="AgentEnableButton" Content="Enable Computer Agent" Click="AgentEnableButton_Click" Height="28" Margin="0,6,0,0" Style="{StaticResource PremiumButtonStyle}"/>
                                <TextBlock Text="Scope" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,3"/>
                                <ComboBox x:Name="AgentScopeCombo" Height="26" SelectionChanged="AgentScopeCombo_SelectionChanged" IsEnabled="False">
                                    <ComboBoxItem Content="A folder I choose" Tag="folder" IsSelected="True"/>
                                    <ComboBoxItem Content="The entire computer" Tag="all"/>
                                </ComboBox>
                                <Button x:Name="AgentChooseFolderButton" Content="Choose Folder…" Click="AgentChooseFolderButton_Click" Height="26" Margin="0,5,0,0" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"/>
                                <TextBlock x:Name="AgentScopeDetailText" Text="No folder chosen yet." FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Approval" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,3"/>
                                <UniformGrid Columns="2">
                                    <Button x:Name="AgentManualModeButton" Content="Manual" Click="AgentApprovalMode_Click" Tag="manual" Height="26" Margin="0,0,3,0" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"/>
                                    <Button x:Name="AgentAutoModeButton" Content="Auto" Click="AgentApprovalMode_Click" Tag="auto" Height="26" Margin="3,0,0,0" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"/>
                                </UniformGrid>
                                <TextBlock x:Name="AgentApprovalHintText" Text="Manual: you approve each command before it runs." FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Project Knowledge Base -->
                        <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Project Knowledge Base" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button x:Name="ProjectKnowledgeBaseButton" Content="Manage" Click="OpenProjectKnowledgeBase_Click" DockPanel.Dock="Right"
                                            Style="{StaticResource SubtleButtonStyle}" Padding="8,2" FontSize="10"/>
                                </DockPanel>
                                <TextBlock x:Name="ProjectKnowledgeBaseSummaryBlock" Text="No project files yet." FontSize="9.5" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,6" TextWrapping="Wrap"/>
                                <Border x:Name="DropZone" Background="{DynamicResource NotebookSurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource NotebookBorderBrush}"
                                        CornerRadius="8" Padding="8" Margin="0,0,0,8" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver">
                                    <TextBlock Text="Drop files or a project folder here" FontSize="10" Foreground="{DynamicResource PrimaryAccentBrush}" TextAlignment="Center"/>
                                </Border>
                                <UniformGrid Columns="2">
                                    <Button Content="+ Add files" Click="BrowseFiles_Click" Height="28" Margin="0,0,4,0" Style="{StaticResource PremiumButtonStyle}"/>
                                    <Button Content="+ Add folder" Click="BrowseProjectFolder_Click" Height="28" Margin="4,0,0,0" Style="{StaticResource SubtleButtonStyle}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Preserved inert controls for backward persistence bindings -->
                        <Expander IsExpanded="False" Visibility="Collapsed">
                            <StackPanel>
                                <Button Click="ClearTaskHistory_Click"/>
                                <Button Click="CompareTaskHistory_Click"/>
                                <ListBox x:Name="TaskHistoryListBox" SelectionChanged="TaskHistoryListBox_SelectionChanged"/>
                                <TextBlock x:Name="TaskHistoryDetailBlock"/>
                                <Button Click="ReplayTaskHistory_Click"/>
                                <TextBlock x:Name="PerformanceAggregateBlock"/>
                                <Button Click="ExportPerformanceLog_Click"/>
                                <ListBox x:Name="PerformanceLogListBox" SelectionChanged="PerformanceLogListBox_SelectionChanged"/>
                                <TextBlock x:Name="PerformanceLogDetailBlock"/>
                                <Button Click="CreateWorkspaceTemplate_Click"/>
                                <Button Click="DeleteWorkspaceTemplate_Click"/>
                                <ListBox x:Name="WorkspaceTemplateListBox" SelectionChanged="WorkspaceTemplateListBox_SelectionChanged"/>
                                <Button Click="LoadWorkspaceTemplate_Click"/>
                                <Button Click="EditWorkspaceTemplate_Click"/>
                                <ItemsControl x:Name="ConceptCloudItemsControl"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- Collapsed left spacer -->
        <Border Grid.Column="0" Visibility="Collapsed"/>

        <!-- ═══════════════════════════════════════════ -->
        <!-- CENTER — Header + Chat + Input              -->
        <!-- ═══════════════════════════════════════════ -->
        <DockPanel Grid.Column="1" Background="{DynamicResource NotebookBackgroundBrush}">
            <!-- Header bar: clickable session title, status chips, config trigger & 2 right-sidebar icon toggles (Images 1 & 2) -->
            <Border x:Name="WorkplaceHeaderBorder" DockPanel.Dock="Top" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,0,0,1" Padding="20,7" Background="{DynamicResource NotebookBackgroundBrush}"
                    SizeChanged="WorkplaceHeaderBorder_SizeChanged">
                <Border.Resources>
                    <Style x:Key="HeaderStatusTextStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="LineHeight" Value="14"/>
                    </Style>
                    <Style x:Key="HeaderStatusSeparatorStyle" TargetType="TextBlock" BasedOn="{StaticResource HeaderStatusTextStyle}">
                        <Setter Property="Text" Value="·"/>
                        <Setter Property="Foreground" Value="{DynamicResource NotebookBorderBrush}"/>
                        <Setter Property="Margin" Value="6,0,6,0"/>
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <!-- Right side: Setup popover trigger + System Log toggle + Image 1 Diff toggle + Image 2 Context/Env toggle -->
                    <StackPanel x:Name="WorkplaceHeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border x:Name="WorkplaceTokenUsagePanel"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <Grid x:Name="AgentTokenUsageRow" Width="0">
                                    <DockPanel>
                                        <TextBlock x:Name="BuilderTokenUsageTitle" Text="Builder"/>
                                        <TextBlock x:Name="BuilderTokenUsageLabel" Text="0 / 0"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BuilderTokenUsageProgressBar" Minimum="0" Maximum="100" Value="0"/>
                                </Grid>
                                <Grid x:Name="CriticTokenUsageRow" Width="0">
                                    <DockPanel>
                                        <TextBlock x:Name="CriticTokenUsageLabel" Text="0 / 0"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="CriticTokenUsageProgressBar" Minimum="0" Maximum="100" Value="0"/>
                                </Grid>
                                <Grid x:Name="WorkplaceGenerationStatsRow" Width="0" Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock x:Name="WorkplaceGenerationStatsTitle" Text="Last reply"/>
                                        <TextBlock x:Name="WorkplaceGenerationStatsLabel" Text=""/>
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Cloud mode toggle relocated next to Setup -->
                        <Button x:Name="WorkplaceCloudModeButton"
                                Content="Cloud Off"
                                Click="WorkplaceCloudModeButton_Click"
                                Height="26"
                                Padding="8,0"
                                Margin="0,0,5,0"
                                Style="{StaticResource SubtleButtonStyle}"
                                FontSize="10.5"
                                ToolTip="Toggle cloud or local models"
                                AutomationProperties.Name="Cloud mode"/>
                        <ComboBox x:Name="WorkplaceCloudModelCombo"
                                  Height="26"
                                  MinWidth="112"
                                  FontSize="10.5"
                                  Padding="6,2"
                                  Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  SelectionChanged="WorkplaceCloudModelCombo_SelectionChanged"
                                  ToolTip="Select OpenRouter cloud model"
                                  AutomationProperties.Name="Workplace cloud model">
                            <ComboBoxItem Content="Threnody 1.0" Tag="threnody-1.0" ToolTip="DeepSeek: DeepSeek V4.1 Flash"/>
                            <ComboBoxItem Content="Edios 1.5" Tag="edios-1.5" ToolTip="Google Gemma 4 31B (free)"/>
                            <ComboBoxItem Content="Hepha 2.5 Coder" Tag="hepha-2.5-coder" ToolTip="NVIDIA Nemotron 3 Ultra (free)"/>
                            <ComboBoxItem Content="Dots3-Note" Tag="workplace-gpt-oss-20b" ToolTip="Dots Studio: Dots3-Note Preview (free)"/>
                        </ComboBox>

                        <Button x:Name="WorkplaceConfigButton"
                                Click="WorkplaceConfigButton_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                Height="26"
                                Padding="8,0"
                                Margin="0,0,5,0"
                                ToolTip="Configure models, agent mode, and knowledge base"
                                AutomationProperties.Name="Models and setup">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" LineHeight="Auto"
                                           Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WorkplaceConfigButtonLabel" Text="Setup" FontSize="10.5" FontWeight="Medium" LineHeight="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Relocated & redesigned compact System Log popup toggle next to Diff & Context -->
                        <Button x:Name="NotificationToggleButton"
                                Click="NotificationToggle_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="Auto"
                                Height="26"
                                Padding="8,0"
                                Margin="0,0,5,0"
                                ToolTip="Toggle system activity log"
                                AutomationProperties.Name="System Log">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10.5" LineHeight="Auto"
                                           Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="System Log" FontSize="10.5" FontWeight="Medium" LineHeight="14" VerticalAlignment="Center"/>
                                <Border x:Name="NotificationBadge" Background="{DynamicResource PrimaryAccentBrush}" CornerRadius="6" MinWidth="14" Height="14" Margin="5,0,0,0" Padding="4,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="NotificationBadgeText" Text="0" FontSize="8.5" LineHeight="11" Foreground="{DynamicResource NotebookBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="NotificationDropdownPopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=NotificationToggleButton}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               VerticalOffset="6"
                               Closed="NotificationDropdownPopup_Closed">
                            <Border x:Name="NotificationDropdownPanel"
                                    Width="360" MaxHeight="280"
                                    Background="{DynamicResource NotebookSurfaceBrush}"
                                    BorderBrush="{DynamicResource NotebookBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.45"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="2,0,2,8">
                                        <TextBlock Text="System Log" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" VerticalAlignment="Center" LineHeight="14"/>
                                        <Button Content="Clear" Click="ClearNotifications_Click" DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" FontSize="9.5" Height="22"/>
                                    </DockPanel>
                                    <ScrollViewer Grid.Row="1" MaxHeight="210" VerticalScrollBarVisibility="Auto" Padding="0">
                                        <ItemsControl x:Name="NotificationList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2" Padding="8,5" CornerRadius="6"
                                                            Background="{Binding CardBackground}"
                                                            BorderBrush="{Binding AccentBrush}" BorderThickness="2,0,0,0">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding TimestampLabel}" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Top" Width="52" Margin="0,0,6,0" LineHeight="12"/>
                                                            <TextBlock Text="{Binding RoleLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Top" Width="46" Margin="0,0,6,0" LineHeight="12"/>
                                                            <TextBlock Text="{Binding FormattedContent}" TextWrapping="Wrap" FontSize="10" FontFamily="Segoe UI" Foreground="{DynamicResource DarkSecondaryBrush}" LineHeight="14"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>

                        <!-- Image 1 attached button: Square with + / - diff viewer toggle -->
                        <Button x:Name="WorkplaceDiffSidebarButton"
                                Click="WorkplaceDiffSidebarButton_Click"
                                Style="{StaticResource PanelToggleButtonStyle}"
                                Width="26" Height="26"
                                Margin="0,0,5,0"
                                ToolTip="Show changed files &amp; code diffs"
                                AutomationProperties.Name="Show diffs">
                            <Grid Width="13" Height="13">
                                <Border CornerRadius="2.5" BorderThickness="1.3" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M4.2,4.5 L8.8,4.5 M6.5,2.4 L6.5,6.6 M4.2,9.2 L8.8,9.2"/>
                            </Grid>
                        </Button>

                        <!-- Image 2 attached button: 3-bullet context & environment toggle -->
                        <Button x:Name="WorkplaceContextSidebarButton"
                                Click="WorkplaceContextSidebarButton_Click"
                                Style="{StaticResource PanelToggleButtonStyle}"
                                Width="26" Height="26"
                                Margin="0,0,5,0"
                                ToolTip="Show session context, environment &amp; background tasks"
                                AutomationProperties.Name="Show context and environment">
                            <Path Width="13" Height="11" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M1.2,2 A0.9,0.9 0 1 0 3,2 A0.9,0.9 0 1 0 1.2,2 Z M5,2 L12.2,2 M1.2,6 A0.9,0.9 0 1 0 3,6 A0.9,0.9 0 1 0 1.2,6 Z M5,6 L12.2,6 M1.2,10 A0.9,0.9 0 1 0 3,10 A0.9,0.9 0 1 0 1.2,10 Z M5,10 L12.2,10"/>
                        </Button>

                        <!-- Canvas toggle button relocated next to Context -->
                        <Button x:Name="WorkplaceCanvasSidebarButton"
                                Click="WorkplaceCanvasSidebarButton_Click"
                                Style="{StaticResource PanelToggleButtonStyle}"
                                Width="26" Height="26"
                                ToolTip="Show Project Canvas"
                                AutomationProperties.Name="Show canvas">
                            <Grid Width="13" Height="11">
                                <Border CornerRadius="2.2" BorderThickness="1.3"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Border Width="4" HorizontalAlignment="Right" Margin="0,1.3,1.3,1.3" CornerRadius="0,1.2,1.2,0" Opacity="0.65"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="WorkplaceHeaderIdentity" VerticalAlignment="Center">
                        <DockPanel Margin="0,0,0,2">
                            <Button x:Name="WorkplaceSessionTitleButton"
                                    Click="WorkplaceSessionTitleButton_Click"
                                    Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Cursor="Hand"
                                    ToolTip="Click to rename this Workplace session">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="WorkplaceSessionTitleText" Text="New session" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" LineHeight="18" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" LineHeight="Auto"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="PipelineProgressBlock" Text="" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" LineHeight="14"/>
                        </DockPanel>
                        <DockPanel ToolTipService.InitialShowDelay="250" Background="Transparent">
                            <DockPanel.ToolTip>
                                <StackPanel MaxWidth="420">
                                    <TextBlock x:Name="ContextInfoBlock" Text="Context: Ready" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource NotebookTextBrush}"/>
                                    <TextBlock x:Name="MemoryFocusBlock" Text="Memory: None" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="ContextPressureBlock" Text="Context pressure: --" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel.ToolTip>
                            <TextBlock x:Name="RelayStatusBlock" DockPanel.Dock="Left" Text="Relay: Idle" Style="{StaticResource HeaderStatusTextStyle}" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource HeaderStatusSeparatorStyle}"/>
                            <TextBlock x:Name="TaskTypeBadgeText" DockPanel.Dock="Left" Text="General Task" Style="{StaticResource HeaderStatusTextStyle}"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource HeaderStatusSeparatorStyle}"/>
                            <TextBlock x:Name="HardwareInfoBlock" Text="Adaptive mode" Style="{StaticResource HeaderStatusTextStyle}" MaxWidth="320" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="WorkplaceErrorNotificationBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="24,8" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="WorkplaceErrorNotificationText" Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="11" FontFamily="Segoe UI"/>
            </Border>

            <!-- Run confidence banner. Previously lived at the bottom of the left sidebar where
                 DockPanel.Dock had no effect inside the StackPanel and the result was never seen. -->
            <Border x:Name="CouncilConfidenceBanner" DockPanel.Dock="Top" Visibility="Collapsed" Padding="24,8" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock x:Name="CouncilConfidenceText" Text="Confidence: Moderate" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="RefineButton" DockPanel.Dock="Right" Content="Refine" Click="RefineButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="10,2" FontSize="10" Margin="8,0,0,0" Visibility="Collapsed" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Composer: one flat card (no box-in-a-box) with a tighter radius. Prompt on top,
                 tool toggles on the left of the control row, Stop/Run on the right. Run status
                 lives in the header (Relay line + context meters), not in here. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="24,6,24,14" Width="{Binding ActualWidth, ElementName=WorkplaceConversationLane}" MaxWidth="960" HorizontalAlignment="Center">
                <Button x:Name="ComputerUseContextButton" Content="Computer Use · follow-ups stay on the desktop   ×" Visibility="Collapsed"
                        Click="ComputerUseContextButton_Click" HorizontalAlignment="Left" Margin="0,0,0,5" Padding="8,3"
                        FontSize="10" Style="{StaticResource SubtleButtonStyle}" ToolTip="Return to Agent Access"/>
                <Border x:Name="InputAreaContainer" CornerRadius="12" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" Padding="8,6" Background="{DynamicResource NotebookSurfaceBrush}"
                        MaxWidth="960" HorizontalAlignment="Stretch"
                        AllowDrop="True" PreviewDragOver="InputAreaContainer_PreviewDragOver" PreviewDrop="InputAreaContainer_PreviewDrop">
                    <StackPanel>
                        <!-- Attachment preview tray: thumbnail chips for the files loaded into this
                             workplace, built in code-behind and numbered to match the prompt index. -->
                        <WrapPanel x:Name="WorkplaceAttachmentTrayPanel" Orientation="Horizontal"
                                   Margin="2,2,2,4" Visibility="Collapsed"/>
                        <!-- Approval gate: Manual mode parks the run here until the user answers. -->
                        <Border x:Name="AgentApprovalBar" Visibility="Collapsed" Background="{DynamicResource NotebookBackgroundBrush}"
                                BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock x:Name="AgentApprovalTitleText" Text="Run this command?" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                <TextBox x:Name="AgentApprovalDetailText" Text="" FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace"
                                         Margin="0,5,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         Foreground="{DynamicResource NotebookTextBrush}" MaxHeight="90" VerticalScrollBarVisibility="Auto"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="AgentApproveButton" Content="Approve" Click="AgentApprove_Click" Height="26" Padding="12,0" Style="{StaticResource PremiumButtonStyle}" FontSize="11"/>
                                    <Button x:Name="AgentApproveAlwaysButton" Content="Always allow this" Click="AgentApproveAlways_Click" Height="26" Padding="10,0" Margin="6,0,0,0" Style="{StaticResource SubtleButtonStyle}" FontSize="11"/>
                                    <Button x:Name="AgentDenyButton" Content="Deny" Click="AgentDeny_Click" Height="26" Padding="12,0" Margin="6,0,0,0" Style="{StaticResource SubtleButtonStyle}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- After an Agent Access run that changed files: one click puts them back. -->
                        <Border x:Name="AgentUndoBar" Visibility="Collapsed" Background="{DynamicResource NotebookBackgroundBrush}"
                                BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5,5,5" Margin="0,0,0,6">
                            <DockPanel>
                                <Button x:Name="AgentUndoDismissButton" DockPanel.Dock="Right" Click="AgentUndoDismiss_Click" Width="26" Height="26" Margin="4,0,0,0"
                                        Style="{StaticResource SubtleButtonStyle}" Background="Transparent" BorderBrush="Transparent" Padding="0"
                                        ToolTip="Keep the changes and hide this" AutomationProperties.Name="Keep the changes">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" LineHeight="Auto"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                </Button>
                                <Button x:Name="AgentUndoButton" DockPanel.Dock="Right" Click="AgentUndo_Click" Height="26" Padding="10,0"
                                        Style="{StaticResource SubtleButtonStyle}" FontSize="11" AutomationProperties.Name="Undo these changes">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" LineHeight="Auto"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Undo these changes" LineHeight="Auto" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="AgentUndoText" Text="" FontSize="11" LineHeight="Auto" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DarkSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>

                        <!-- Borderless concise status line (Image 6 blue circle: "<status>  <Ns> ›") -->
                        <Border x:Name="AgentActivityLine" Visibility="Collapsed" HorizontalAlignment="Left"
                                Margin="6,0,6,4" Padding="2,1"
                                Background="Transparent" BorderThickness="0">
                            <TextBlock x:Name="AgentActivityText" Text="" FontSize="11.5" FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DarkSecondaryBrush}"
                                       LineHeight="16"
                                       TextTrimming="CharacterEllipsis" MaxWidth="620"/>
                        </Border>

                        <Border x:Name="RefinementModeBanner" Visibility="Collapsed" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                            <TextBlock Text="Refinement Mode" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock x:Name="RevisionNoticeBlock" Margin="8,2,8,2" Text="Issues were found and the output was revised." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource DarkSecondaryBrush}" Visibility="Collapsed"/>

                        <Grid>
                            <avalonedit:TextEditor x:Name="QueryInput"
                                     Background="Transparent" Foreground="{DynamicResource NotebookTextBrush}"
                                     FontFamily="Segoe UI" FontSize="12.5" KeyDown="QueryInput_KeyDown" PreviewKeyDown="QueryInput_PreviewKeyDown"
                                     WordWrap="True" ShowLineNumbers="False"
                                     HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                     Margin="6,4,6,3" MinHeight="30" MaxHeight="140"/>
                            <Popup x:Name="WorkplaceMentionPopup"
                                   Placement="Top"
                                   PlacementTarget="{Binding ElementName=QueryInput}"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   HorizontalOffset="8"
                                   VerticalOffset="-6">
                                <Border Background="{DynamicResource NotebookSurfaceBrush}"
                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6"
                                        MinWidth="240"
                                        MaxWidth="340"
                                        MaxHeight="180">
                                    <ListBox x:Name="WorkplaceMentionList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontFamily="Segoe UI"
                                             FontSize="12"
                                             Foreground="{DynamicResource NotebookTextBrush}"
                                             MouseLeftButtonUp="WorkplaceMentionList_MouseLeftButtonUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,4">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#D5DAD3"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <DockPanel Margin="2,2,2,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,2,0,2">
                                <local:EffortSelector x:Name="WorkplaceEffortSelector" IsCompact="True" Height="28" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Button x:Name="StopButton" Content="■" Click="StopMessage_Click" Width="28" Height="26" Padding="0"
                                        Foreground="{DynamicResource PrimaryAccentBrush}" IsEnabled="False" Margin="0,0,5,0" ToolTip="Stop current run">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="SendButton" Click="SendMessage_Click" Width="28" Height="26" Padding="0"
                                        Style="{StaticResource PremiumButtonStyle}" FontSize="13" FontWeight="Bold" ToolTip="Run task" AutomationProperties.Name="Send message">
                                    <Grid Width="16" Height="16">
                                        <Path x:Name="WorkplaceSendArrow" Data="M8,14 V2 M3,7 L8,2 L13,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <Grid x:Name="WorkplaceSendSpinner" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform><RotateTransform x:Name="WorkplaceSendRotation"/></Grid.RenderTransform>
                                            <Ellipse Margin="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Opacity="0.22"/>
                                            <Path Data="M8,1.5 A6.5,6.5 0 0 1 14.5,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- '+' menu: Select Project (strict confinement) + Attach Files -->
                                <Button x:Name="WorkplaceAttachFileButton" Width="26" Height="26" Margin="0,2,5,2" Click="WorkplacePlusButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="0" AutomationProperties.Name="Attachments and tools" ToolTip="Add files, select a project, or configure tools" BorderThickness="0" Background="Transparent">
                                    <Path Width="11" Height="11" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M5,0 L7,0 L7,5 L12,5 L12,7 L7,7 L7,12 L5,12 L5,7 L0,7 L0,5 L5,5 Z"/>
                                </Button>

                                <!-- Project badge / quick selector -->
                                <Button x:Name="WorkplaceProjectBadgeButton" Click="OpenSelectProjectPopup_Click" Height="26" Padding="8,0" Margin="0,2,5,2"
                                        Style="{StaticResource SubtleButtonStyle}" BorderThickness="0" Background="Transparent" ToolTip="Strict project folder scope (click to choose)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10.5" LineHeight="Auto"
                                                   Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="WorkplaceProjectBadgeText" Text="This computer" FontSize="10.5" LineHeight="14" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="CouncilPetToggleButton" Content="Bit" Click="CouncilPetToggleButton_Click" Height="26" Padding="7,0"
                                        Style="{StaticResource SubtleButtonStyle}" FontSize="10.5" Margin="0,2,4,2" ToolTip="Toggle draggable companion" Visibility="Collapsed"/>

                                <!-- '+' Menu Popup -->
                                <Popup x:Name="WorkplacePlusPopup" Placement="Top" PlacementTarget="{Binding ElementName=WorkplaceAttachFileButton}"
                                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" VerticalOffset="-6">
                                    <Border Width="280" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.45"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button x:Name="WorkplaceSelectProjectMenuButton" Click="WorkplaceSelectProjectMenu_Click"
                                                    HorizontalContentAlignment="Left" Padding="9,6" Height="30" Background="Transparent" BorderThickness="0" Margin="0,0,0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5" LineHeight="Auto" Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Select Project" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="WorkplaceAttachFilesMenu_Click"
                                                    HorizontalContentAlignment="Left" Padding="9,6" Height="30" Background="Transparent" BorderThickness="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5" LineHeight="Auto" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Attach Files…" FontSize="11.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                                                                    <Border Height="1" Background="{DynamicResource NotebookBorderBrush}" Margin="6,7"/>
                                            <TextBlock Text="Tools" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="10,2,10,4"/>
                                            <Button x:Name="CommandReviewSelectorButton" Click="CommandReviewSelectorButton_Click" Style="{StaticResource WorkplaceToolMenuRowStyle}" ToolTip="Command safety review and interception mode">
                                                <DockPanel>
                                                    <TextBlock Text="Command review"/>
                                                    <TextBlock x:Name="CommandReviewSelectorText" Text="Auto-Review" Foreground="{DynamicResource DarkSecondaryBrush}" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                                </DockPanel>
                                            </Button>
                                            <Button x:Name="WebSearchToggleButton" Click="WebSearchToggleButton_Click" Style="{StaticResource WorkplaceToolMenuRowStyle}" AutomationProperties.Name="Web search">
                                                <TextBlock x:Name="WebSearchMenuStateText" Text="Web search · On"/>
                                            </Button>
                                            <Button x:Name="WorkplaceSkillsButton" Click="WorkplaceOpenSkills_Click" Style="{StaticResource WorkplaceToolMenuRowStyle}" ToolTip="Active skills for this session" AutomationProperties.Name="Skills">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Skills"/>
                                                    <Border x:Name="WorkplaceSkillsBadge" Margin="8,0,0,0" Padding="5,1" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed">
                                                        <TextBlock x:Name="WorkplaceSkillsCountText" Text="0" FontSize="10" Foreground="{DynamicResource AccentMutedBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Select Project strict-confinement popup (Requirement #4) -->
                                <Popup x:Name="SelectProjectPopup" Placement="Top" PlacementTarget="{Binding ElementName=WorkplaceAttachFileButton}"
                                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" VerticalOffset="-6">
                                    <Border Width="310" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Select Project Directory" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" LineHeight="16"/>
                                                <Button Content="×" Click="CloseSelectProjectPopup_Click" DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Style="{StaticResource SubtleButtonStyle}"/>
                                            </DockPanel>
                                            <TextBlock Text="The model will work strictly inside the chosen folder or drive and cannot touch paths outside it." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,8"/>
                                            <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,0,8">
                                                <TextBlock x:Name="SelectProjectCurrentPathText" Text="Not restricted yet (This computer)" FontSize="10.5" Foreground="{DynamicResource NotebookTextBrush}" TextWrapping="Wrap" LineHeight="14"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="Browse Folder / Drive…" Click="BrowseStrictProjectFolder_Click" Height="28" Padding="10,0" Style="{StaticResource PremiumButtonStyle}" Margin="0,0,6,0"/>
                                                <Button Content="Clear Restriction" Click="ClearStrictProjectFolder_Click" Height="28" Padding="8,0" Style="{StaticResource SubtleButtonStyle}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SelectProjectRecentHeader" Text="Recent folders" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,4" Visibility="Collapsed"/>
                                            <StackPanel x:Name="SelectProjectRecentList"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Command Review Options Popup (Requirement #13) -->
                                <Popup x:Name="CommandReviewPopup" Placement="Top" PlacementTarget="{Binding ElementName=WorkplaceAttachFileButton}"
                                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" VerticalOffset="-6">
                                    <Border Width="278" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.45"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Command Review Policy" FontSize="11" FontWeight="SemiBold" Margin="4,2,4,6" LineHeight="15"/>
                                            <Button Click="SelectCommandReviewOption_Click" Tag="AutoReview" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1" Style="{StaticResource SubtleButtonStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Auto-Review (Recommended)" FontSize="11" FontWeight="SemiBold" LineHeight="14"/>
                                                    <TextBlock Text="Approves safe project work; intercepts deletes, system edits &amp; network installs" FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="13"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="SelectCommandReviewOption_Click" Tag="ManualReview" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2" Style="{StaticResource SubtleButtonStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Review Every Command" FontSize="11" FontWeight="SemiBold" LineHeight="14"/>
                                                    <TextBlock Text="Pauses so you inspect and approve every command &amp; write before execution" FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="13"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="SelectCommandReviewOption_Click" Tag="AutoApprove" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2" Style="{StaticResource SubtleButtonStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Auto-Run Scoped" FontSize="11" FontWeight="SemiBold" LineHeight="14"/>
                                                    <TextBlock Text="Runs project commands automatically while blocking drive wipes &amp; out-of-scope paths" FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="13"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Zero-size while closed, so they sit in the toggle row without affecting its layout. -->
                                <Popup x:Name="WorkplaceSkillsPopup" Placement="Top" PlacementTarget="{Binding ElementName=WorkplaceAttachFileButton}"
                                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" VerticalOffset="-10"
                                       Opened="WorkplaceSkillsPopup_Opened">
                                    <Border x:Name="WorkplaceSkillsFlyoutCard" Width="460" MaxHeight="480" Padding="16" Background="{DynamicResource NotebookSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" Effect="{StaticResource SoftShadow}">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Skills" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                    <TextBlock x:Name="WorkplaceSkillsSummaryText" Text="Reusable procedures for specialized work" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Width="24" Height="24" Padding="0" Click="WorkplaceCloseSkills_Click" Style="{StaticResource SubtleButtonStyle}" ToolTip="Close">
                                                    <TextBlock Text="&#215;" FontSize="14" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Margin="0,10,0,10" Text="Skills are shared across Axiom modes. Detailed instructions load when relevant." TextWrapping="Wrap" FontSize="10.5" LineHeight="15" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <ScrollViewer Grid.Row="2" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="WorkplaceSkillsListPanel"/>
                                            </ScrollViewer>
                                            <Button Grid.Row="3" Margin="0,12,0,0" Height="32" Click="WorkplaceCreateCustomSkill_Click" Background="{DynamicResource PrimaryAccentBrush}" Foreground="{DynamicResource NotebookBackgroundBrush}" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Content="&#65291;  Create custom Skill"/>
                                        </Grid>
                                    </Border>
                                </Popup>

                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- System Log moved to compact header button + popup next to Diff & Context -->

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- Agentic Pause live status bar                              -->
            <!-- Floats just above the chat area; collapsed when idle.      -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border x:Name="AgenticPauseBanner"
                    DockPanel.Dock="Top"
                    Visibility="Collapsed"
                    Opacity="0"
                    Padding="14,5,14,5"
                    Background="{DynamicResource NotebookBackgroundBrush}"
                    BorderBrush="{DynamicResource PrimaryAccentBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Left: animated pulse dot (accent gold — this is activity, not an error) -->
                    <Border x:Name="AgenticPulseDot"
                            Width="7" Height="7"
                            CornerRadius="4"
                            Background="{DynamicResource PrimaryAccentBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            DockPanel.Dock="Left"/>
                    <!-- Right: pause budget indicator (e.g. 2/3) -->
                    <Border Background="{DynamicResource NotebookSurfaceBrush}"
                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,2"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right">
                        <TextBlock x:Name="AgenticPauseBudgetText"
                                   Text="0 / 3"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Centre: descriptive status text -->
                    <TextBlock x:Name="AgenticPauseStatusBlock"
                               Text=""
                               FontSize="10"
                               FontStyle="Italic"
                               Foreground="{DynamicResource NotebookTextBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Opacity="1"
                               Visibility="Visible"/>
                </DockPanel>
            </Border>

            <!-- Chat display (fills remaining space — shows only user/architect/builder/critic/sandbox) -->
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource NotebookBackgroundBrush}" Padding="24,14" PreviewMouseWheel="ChatScrollViewer_PreviewMouseWheel">
                <StackPanel x:Name="WorkplaceConversationLane" MaxWidth="960" HorizontalAlignment="Stretch">
                <Button x:Name="ShowEarlierWorkplaceMessagesButton"
                        Content="Show earlier messages"
                        Click="ShowEarlierWorkplaceMessages_Click"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8"
                        Padding="12,5"
                        FontSize="10"
                        Foreground="{DynamicResource DarkSecondaryBrush}"
                        Style="{StaticResource SubtleButtonStyle}"/>
                <ItemsControl x:Name="ChatCardsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Clean structured card for AI/agent output; compact right-aligned surface bubble for user -->
                            <Border x:Name="CardShell" Margin="4,6,20,6" Padding="16,12" CornerRadius="12"
                                    HorizontalAlignment="Stretch" MinWidth="0" MaxWidth="960"
                                    Background="#1C1A18" BorderBrush="#2C2926" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel x:Name="CardMetaRow" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding RoleLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" LineHeight="14"/>
                                        </StackPanel>
                                        <Button x:Name="CopyWorkplaceMessageButton" Content="Copy" Click="CopyWorkplaceMessage_Click" Tag="{Binding}" FontSize="9.5" Padding="8,2" DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBlock Text="{Binding TimestampLabel}" FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center" LineHeight="12"/>
                                    </DockPanel>
                                    <local:ShimmerTextBlock x:Name="WorkplaceCardGenerationStatusText"
                                                            Text="{Binding GenerationStatusText}"
                                                            FontSize="11.5"
                                                            FontWeight="SemiBold"
                                                            BaseColor="#A1A1AA"
                                                            HighlightColor="#FFFFFF"
                                                            ShimmerDurationSeconds="2"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="Collapsed"/>
                                    <ItemsControl ItemsSource="{Binding ViewedImages}"
                                                  Visibility="{Binding HasViewedImages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Margin="0,0,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander IsExpanded="True" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                    <Expander.Template>
                                                        <ControlTemplate TargetType="Expander">
                                                            <StackPanel>
                                                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                              HorizontalAlignment="Left" AutomationProperties.Name="Viewed an image" FocusVisualStyle="{x:Null}">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <ContentPresenter Opacity="0.75"/>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Viewed an image" FontSize="12" LineHeight="Auto" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                                                        <TextBlock Text="⌄" FontSize="12" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="7,0,0,0"/>
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                                <ContentPresenter x:Name="ScreenshotContent" ContentSource="Content" HorizontalAlignment="Left" Margin="0,7,0,0" Visibility="Collapsed"/>
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsExpanded" Value="True">
                                                                    <Setter TargetName="ScreenshotContent" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Expander.Template>
                                                    <Border Width="80" Height="80" CornerRadius="8" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" Background="{DynamicResource NotebookSurfaceBrush}" ClipToBounds="True">
                                                        <Image Source="{Binding}" Stretch="Uniform" AutomationProperties.Name="Work screenshot"/>
                                                    </Border>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding AttachedImages}"
                                                  Visibility="{Binding HasAttachedImages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Margin="0,0,0,6">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" Margin="0,0,6,6" ClipToBounds="True">
                                                    <Image Source="{Binding}" MaxWidth="220" MaxHeight="160" Stretch="Uniform"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <FlowDocumentScrollViewer x:Name="WorkplaceCardContentText"
                                                              Document="{Binding FormattedDocument}"
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              Padding="0"
                                                              Margin="0,2,0,0"
                                                              FontSize="12.5"
                                                              FontFamily="Segoe UI"
                                                              Foreground="{DynamicResource NotebookTextBrush}"
                                                              IsToolBarVisible="False"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              IsTabStop="False"/>
                                    <Expander x:Name="WorkplaceExecutionSteps" IsExpanded="False" Margin="0,12,0,0"
                                              Visibility="{Binding HasExecutionSteps, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Foreground="{DynamicResource DarkSecondaryBrush}" AutomationProperties.Name="Run activity details">
                                        <Expander.Template>
                                            <ControlTemplate TargetType="Expander">
                                                <StackPanel>
                                                    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                  Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left" Cursor="Hand"
                                                                  ToolTip="Expand or collapse run activity"
                                                                  FocusVisualStyle="{StaticResource AxiomFocusVisual}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="ActivityHeaderShell" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="2,2,10,2">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Border x:Name="ActivityBadge" Width="24" Height="24" CornerRadius="7" Margin="0,0,9,0"
                                                                                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                                                            <Path Data="M0,0 L4,4 L0,8" Width="4" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                                  RenderTransformOrigin="0.5,0.5">
                                                                                <Path.RenderTransform><RotateTransform x:Name="ActivityChevronRotation"/></Path.RenderTransform>
                                                                            </Path>
                                                                        </Border>
                                                                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="ActivityBadge" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="ActivityChevronRotation" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.16"/>
                                                                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="ActivityChevronRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.16"/>
                                                                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ActivityHeaderShell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                        <Setter TargetName="ActivityHeaderShell" Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActivityHeaderShell" Property="Opacity" Value="0.8"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="ActivityContent" ContentSource="Content" Visibility="Collapsed"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ActivityContent" Property="Visibility" Value="Visible"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Expander.Template>
                                        <Expander.Header>
                                            <TextBlock Text="{Binding ExecutionStepsLabel}" FontFamily="Segoe UI" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                        </Expander.Header>
                                        <Border Margin="0,8,0,0" Padding="10" CornerRadius="8" Background="{DynamicResource NotebookBackgroundBrush}"
                                                BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1">
                                            <FlowDocumentScrollViewer Document="{Binding ExecutionStepsDocument}" MaxHeight="260" Background="Transparent" BorderThickness="0" Padding="0"
                                                                      FontFamily="Segoe UI" Foreground="{DynamicResource NotebookTextBrush}"
                                                                      IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="user">
                                    <Setter TargetName="CardShell" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="CardShell" Property="MinWidth" Value="0"/>
                                    <Setter TargetName="CardShell" Property="MaxWidth" Value="640"/>
                                    <Setter TargetName="CardShell" Property="Margin" Value="80,4,8,4"/>
                                    <Setter TargetName="CardShell" Property="Padding" Value="12,8"/>
                                    <Setter TargetName="CardShell" Property="CornerRadius" Value="12"/>
                                    <Setter TargetName="CardShell" Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
                                    <Setter TargetName="CardShell" Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
                                    <Setter TargetName="CardShell" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="CardMetaRow" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="CopyWorkplaceMessageButton" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowGeneratingStatusInCard}" Value="True">
                                    <Setter TargetName="WorkplaceCardGenerationStatusText" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="WorkplaceCardContentText" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGeneratingStatus}" Value="True">
                                    <Setter TargetName="WorkplaceCardContentText" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ═══════════════════════════════════════════ -->
        <!-- RIGHT SIDEBAR — Diff / Context & Env / Canvas -->
        <!-- ═══════════════════════════════════════════ -->
        <Border x:Name="ProjectCanvasPane" Grid.Column="2" MinWidth="290" MaxWidth="620" Width="360" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1,0,0,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Output identity and actions. Sidebar mode buttons live in the Workplace header. -->
                <Border x:Name="RightSidebarHeaderBorder" Grid.Row="0" Margin="2,1,2,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock x:Name="CanvasTitleBlock" Text="Project Canvas" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" LineHeight="20" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <TextBlock x:Name="CanvasSubtitleBlock" FontSize="12" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="17" Visibility="Collapsed"/>
                                <TextBlock x:Name="CanvasDiffSummaryBlock" FontSize="12" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,3,0,0" Visibility="Collapsed" TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                              <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                                <Button x:Name="RightTabDiffButton" Content="Diff" Click="WorkplaceDiffSidebarButton_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="9.5" Padding="7,0" Height="24" Margin="0,0,4,0"/>
                                <Button x:Name="RightTabContextButton" Content="Context" Click="WorkplaceContextSidebarButton_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="9.5" Padding="7,0" Height="24" Margin="0,0,4,0"/>
                                <Button x:Name="RightTabCanvasButton" Content="Canvas" Click="RightTabCanvasButton_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="9.5" Padding="7,0" Height="24" Margin="0,0,6,0"/>
                              </StackPanel>
                                <Button x:Name="ProjectCanvasToggleButton" Content="›" Click="ProjectCanvasToggleButton_Click" Style="{StaticResource PanelToggleButtonStyle}" ToolTip="Hide project canvas" AutomationProperties.Name="Hide project canvas" FontSize="17" Width="28" Height="28"/>
                            </StackPanel>
                        </Grid>

                        <!-- Contextual toolbar for Canvas / Codebase patches -->
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0" x:Name="CanvasActionsRow">
                            <WrapPanel.Resources>
                                <Style x:Key="CanvasActionStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="MinHeight" Value="28"/>
                                    <Setter Property="Padding" Value="9,3"/>
                                    <Setter Property="Margin" Value="0,0,5,4"/>
                                    <Style.Triggers>
                                        <Trigger Property="Tag" Value="Selected">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Resources>
                            <StackPanel x:Name="CanvasArtifactTogglePanel" Orientation="Horizontal" Margin="0,0,4,0" Visibility="Collapsed">
                                <Button x:Name="CanvasPreviewViewButton" Content="Preview" Click="CanvasPreviewViewButton_Click" Style="{StaticResource CanvasActionStyle}"/>
                                <Button x:Name="CanvasCodeViewButton" Content="Source" Click="CanvasCodeViewButton_Click" Style="{StaticResource CanvasActionStyle}"/>
                            </StackPanel>
                            <Button x:Name="CopyCanvasButton" Click="CopyCanvasButton_Click" Style="{StaticResource CanvasActionStyle}" ToolTip="Copy source" AutomationProperties.Name="Copy source" Visibility="Collapsed">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" LineHeight="Auto"/>
                            </Button>
                            <Button x:Name="CopyCanvasArtifactSourceButton" Click="CopyCanvasArtifactSourceButton_Click" Style="{StaticResource CanvasActionStyle}" ToolTip="Copy artifact source" AutomationProperties.Name="Copy artifact source" Visibility="Collapsed">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" LineHeight="Auto"/>
                            </Button>
                            <Button x:Name="SaveCanvasArtifactButton" Content="Save" Click="SaveCanvasArtifactButton_Click" Style="{StaticResource CanvasActionStyle}" ToolTip="Save artifact to a file" Visibility="Collapsed"/>
                            <Button x:Name="RunCodeButton" Content="Run" Click="RunCodeButton_Click" Style="{StaticResource CanvasActionStyle}" ToolTip="Execute code in sandbox" Visibility="Collapsed"/>
                            <Button x:Name="ShowDiffButton" Content="Diff" Click="ShowDiffButton_Click" Style="{StaticResource CanvasActionStyle}" Visibility="Collapsed"/>
                            <Button x:Name="CodeOutputToggleButton" Content="⌄" Margin="0,0,5,0" Click="CodeOutputToggleButton_Click" Style="{StaticResource PanelToggleButtonStyle}" Width="24" Height="24" Visibility="Collapsed"/>
                            <Button x:Name="UndoCodebaseChangesButton" Content="Undo" Click="UndoCodebaseChanges_Click" Style="{StaticResource CanvasActionStyle}" Visibility="Collapsed" IsEnabled="False"/>
                            <Button x:Name="AcceptCodebaseChangesButton" Content="Accept" Margin="0,0,5,4" Click="AcceptCodebaseChanges_Click" Style="{StaticResource PremiumButtonStyle}" FontSize="12" MinHeight="28" Padding="9,3" Visibility="Collapsed" IsEnabled="False"/>
                            <Button x:Name="RejectCodebaseChangesButton" Content="Reject" Click="RejectCodebaseChanges_Click" Style="{StaticResource CanvasActionStyle}" Visibility="Collapsed" IsEnabled="False"/>
                            <Button x:Name="CanvasMoreActionsButton" Content="..." Margin="0,0,4,0" Click="CanvasMoreActionsButton_Click" Style="{StaticResource PanelToggleButtonStyle}" Width="24" Height="24" Visibility="Collapsed">
                                <Button.ContextMenu>
                                    <ContextMenu Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" Foreground="{DynamicResource NotebookTextBrush}" BorderThickness="1" Padding="4">
                                        <MenuItem x:Name="CanvasMoreCopyItem" Header="Copy source" Click="CanvasMoreCopyItem_Click"/>
                                        <MenuItem x:Name="CanvasMoreDiffItem" Header="Show diff" Click="CanvasMoreDiffItem_Click"/>
                                        <MenuItem x:Name="CanvasMoreOutputItem" Header="Hide output" Click="CanvasMoreOutputItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Right Sidebar Content Views -->
                <Grid Grid.Row="1">
                    <!-- VIEW A: Context & Environment + Background Tasks (Images 3 & 4) -->
                    <ScrollViewer x:Name="ContextEnvironmentPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">                        <ScrollViewer.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="LineHeight" Value="19"/>
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="4,6,8,16">
                            <!-- Environment (Image 3 top) -->
                            <TextBlock Text="Environment" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" LineHeight="21"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" LineHeight="Auto" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="This computer" FontSize="13" LineHeight="19" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="Save" Click="ExportContextEnvironment_Click" Background="Transparent" BorderThickness="0" Padding="4,1" FontSize="13" Foreground="{DynamicResource DarkSecondaryBrush}" Cursor="Hand"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" LineHeight="Auto" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EnvProjectPathText" Grid.Column="1" Text="Unscoped" FontSize="13" LineHeight="19" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" LineHeight="Auto" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EnvGitBranchText" Grid.Column="1" Text="No git repo" FontSize="13" Foreground="{DynamicResource DarkSecondaryBrush}" LineHeight="19" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource NotebookBorderBrush}" Margin="0,8,0,16"/>

                            <!-- Context Breakdown (Image 3 center) -->
                            <TextBlock Text="Context" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" LineHeight="21"/>
                            <Grid Margin="0,0,0,5">
                                <TextBlock x:Name="ContextUsedPercentText" Text="0% used" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" HorizontalAlignment="Left" LineHeight="19"/>
                                <TextBlock x:Name="ContextUsedFractionText" Text="0 / 128k" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" LineHeight="19"/>
                            </Grid>
                            <!-- Multi-color segmented progress bar -->
                            <Border CornerRadius="4" Height="8" Background="{DynamicResource NotebookBackgroundBrush}" ClipToBounds="True" Margin="0,0,0,10">
                                <Grid x:Name="ContextSegmentedBarGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CtxBarMessagesCol" Width="0*"/>
                                        <ColumnDefinition x:Name="CtxBarSystemToolsCol" Width="0*"/>
                                        <ColumnDefinition x:Name="CtxBarMcpToolsCol" Width="0*"/>
                                        <ColumnDefinition x:Name="CtxBarOverheadCol" Width="0*"/>
                                        <ColumnDefinition x:Name="CtxBarFreeCol" Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#3B82F6"/>
                                    <Border Grid.Column="1" Background="#F97316"/>
                                    <Border Grid.Column="2" Background="#10B981"/>
                                    <Border Grid.Column="3" Background="#6B7280"/>
                                    <Border Grid.Column="4" Background="#272422"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="ContextBreakdownRowsPanel" Margin="0,0,0,8"/>

                            <TextBlock x:Name="CtxExpandMcpText" Text="> MCP tools  0" FontSize="13" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,2" LineHeight="19"/>
                            <TextBlock x:Name="CtxExpandMemoryText" Text="> Memory files (.md tracker)  0" FontSize="13" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,0,0,10" LineHeight="19"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CtxUntilCompactText" Text="Compact ready" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" LineHeight="19" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Compact session" Click="CompactSessionNow_Click" Height="32" Padding="12,0" FontSize="13" Style="{StaticResource SubtleButtonStyle}"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource NotebookBorderBrush}" Margin="0,8,0,16"/>

                            <!-- Outputs section (Image 4) -->
                            <TextBlock Text="Outputs" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" LineHeight="21"/>
                            <StackPanel x:Name="RightSidebarOutputsPanel" Margin="0,0,0,10">
                                <TextBlock Text="No files modified yet." FontSize="13" Foreground="{DynamicResource MutedTextBrush}" LineHeight="19"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{DynamicResource NotebookBorderBrush}" Margin="0,8,0,16"/>

                            <!-- Background tasks section (Image 4 red circle) -->
                            <TextBlock Text="Background tasks" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" LineHeight="21"/>
                            <StackPanel x:Name="RightSidebarBackgroundTasksPanel"/>
                            <Button x:Name="BackgroundFinishedToggleButton" Click="BackgroundFinishedToggle_Click"
                                    Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0,4" HorizontalContentAlignment="Left" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" LineHeight="Auto" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BackgroundFinishedCountText" Text="0 finished" FontSize="13" Foreground="{DynamicResource DarkSecondaryBrush}" LineHeight="19" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="RightSidebarFinishedTasksPanel" Visibility="Collapsed" Margin="14,2,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- VIEW B & C: Diff Viewer & Code/Preview Canvas -->
                    <Border x:Name="CodeOutputPanel" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <ScrollViewer x:Name="CanvasEmptyState" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                <StackPanel Margin="19,54" MaxWidth="260">
                                    <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                                            HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="&#xE8A1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21"
                                                   Foreground="{DynamicResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="Auto"/>
                                    </Border>
                                    <TextBlock Text="No canvas output yet" FontSize="16" FontWeight="SemiBold" LineHeight="22"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,13,0,0"/>
                                    <TextBlock Text="Ask in chat for a document, a webpage, or a code file. Generated output opens here so you can preview it or inspect its source."
                                               FontSize="13" LineHeight="19" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                </StackPanel>
                            </ScrollViewer>
                            <avalonedit:TextEditor x:Name="ProjectCanvasEditor"
                                               Background="Transparent"
                                               Foreground="{DynamicResource NotebookTextBrush}"
                                               LineNumbersForeground="{DynamicResource MutedTextBrush}"
                                               FontFamily="Consolas"
                                               FontSize="12.5"
                                               Margin="6,8,6,8"
                                               Visibility="Collapsed"
                                               AutomationProperties.Name="Canvas source"
                                               ShowLineNumbers="True"
                                               IsReadOnly="True"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto"/>
                            <Grid x:Name="CanvasArtifactPreviewHost" Background="{DynamicResource NotebookBackgroundBrush}" Visibility="Collapsed" Margin="1">
                                <wv2:WebView2 x:Name="CanvasArtifactWebView"
                                              Grid.Row="0"
                                              DefaultBackgroundColor="#00000000"
                                              Margin="0"
                                              Visibility="Visible"/>
                            </Grid>
                            <ScrollViewer x:Name="SessionDiffScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="5,8">
                                <StackPanel>
                                    <TextBlock x:Name="DiffViewerEmptyText" Text="File edits and canvas revisions will appear here." FontSize="13" LineHeight="19" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="8,5" TextWrapping="Wrap" Visibility="Collapsed"/>
                                    <ItemsControl x:Name="SessionDiffLines"/>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer x:Name="DiffViewerScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="5,8">
                                <ItemsControl x:Name="DiffViewerLines"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Project-scoped attachment manager.  It intentionally lives above the workspace grid so
             it behaves as a focused screen rather than another narrow sidebar list. -->
        <Popup x:Name="ProjectKnowledgeBasePopup" Placement="Center" PlacementTarget="{Binding ElementName=ProjectKnowledgeBaseButton}"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="720" Height="520" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="Project Knowledge Base" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProjectKnowledgeBaseDialogSummaryBlock" Text="Files are retained with this Workplace project." FontSize="11"
                                       Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="×" Click="CloseProjectKnowledgeBase_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="28" FontSize="16" Style="{StaticResource SubtleButtonStyle}" ToolTip="Close"/>
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,16,0,12" LastChildFill="False">
                        <Button Content="+ Files" Click="BrowseFiles_Click" Padding="12,5" Margin="0,0,8,0" Style="{StaticResource PremiumButtonStyle}"/>
                        <Button Content="+ Folder" Click="BrowseProjectFolder_Click" Padding="12,5" Style="{StaticResource SubtleButtonStyle}"/>
                        <TextBlock Text="All file types are retained; unsupported binaries remain attached as metadata." DockPanel.Dock="Right"
                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Width="290" TextAlignment="Right"/>
                    </DockPanel>

                    <Border Grid.Row="2" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ListBox x:Name="ProjectKnowledgeDocumentListBox" Background="Transparent" BorderThickness="0" Padding="8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Type}" FontSize="8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding RelativePath}" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Info}" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="×" Tag="{Binding}" Click="RemoveProjectKnowledgeDocument_Click" Width="24" Height="24" Padding="0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SubtleButtonStyle}" ToolTip="Remove this file from the project"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Grid.Row="3" Text="Retrieved passages are cited by file and chunk in the model context." FontSize="10"
                               Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
