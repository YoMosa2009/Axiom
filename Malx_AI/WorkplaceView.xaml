<UserControl x:Class="Malx_AI.WorkplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Malx_AI"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource NotebookBackgroundBrush}" Foreground="{DynamicResource NotebookTextBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="WorkplaceTokenMeterProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="{TemplateBinding Height}" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CouncilSidebarColumn" Width="300" MinWidth="270" MaxWidth="380"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="CanvasColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- LEFT SIDEBAR — Council + Knowledge Base     -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource NotebookSurfaceBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource NotebookBorderBrush}">
            <ScrollViewer x:Name="CouncilSidebarScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" PreviewMouseWheel="SidebarScrollViewer_PreviewMouseWheel">
                <StackPanel Margin="16,16,16,20">
                    <Button x:Name="SingleModelModeToggleButton" Click="SingleModelModeToggleButton_Click"
                            Style="{StaticResource SubtleButtonStyle}" Height="42" Padding="12,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            ToolTip="Switch between Council mode (Architect/Builder/Critic) and Single Model mode (one agent)">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="MODE" FontSize="8" FontWeight="SemiBold" Opacity="0.55"
                                           Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                <TextBlock x:Name="SingleModelModeValueText" Text="Council" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Border x:Name="SingleModelModePill" DockPanel.Dock="Right" VerticalAlignment="Center"
                                    CornerRadius="7" Padding="8,2"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1">
                                <TextBlock x:Name="SingleModelModePillText" Text="3 roles" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DarkSecondaryBrush}"/>
                            </Border>
                        </DockPanel>
                    </Button>
                    <TextBlock x:Name="CouncilSubtitleText" Text="Configure models for Architect/Builder/Critic" FontSize="11" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SingleModelSubtitleText" Text="One agentic model handles the whole workplace chat" FontSize="11" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- Architect -->
                    <Border x:Name="ArchitectModelCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Architect" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ArchitectModelBlock" Text="No model selected" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,8"/>
                            <ComboBox x:Name="ArchitectFormatCombo" SelectedIndex="0" Height="28" Margin="0,0,0,8">
                                <ComboBoxItem Content="ChatML"/>
                                <ComboBoxItem Content="Llama 3"/>
                                <ComboBoxItem Content="Alpaca"/>
                            </ComboBox>
                            <Button x:Name="LoadArchitectModelButton" Content="Load Architect Model" Click="LoadArchitectModel_Click" Height="32" Style="{StaticResource SubtleButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Builder -->
                    <Border x:Name="RoleContextControlsCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Builder" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BuilderModelBlock" Text="No model selected" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,8"/>
                            <ComboBox x:Name="BuilderFormatCombo" SelectedIndex="0" Height="28" Margin="0,0,0,8">
                                <ComboBoxItem Content="ChatML"/>
                                <ComboBoxItem Content="Llama 3"/>
                                <ComboBoxItem Content="Alpaca"/>
                            </ComboBox>
                            <Button x:Name="LoadBuilderModelButton" Content="Load Builder Model" Click="LoadBuilderModel_Click" Height="32" Style="{StaticResource SubtleButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Critic -->
                    <Border x:Name="ManualRoleContextControlsCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Critic" FontSize="11" FontWeight="SemiBold"/>
                                <Border Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="6,1" Margin="6,0,0,0" DockPanel.Dock="Right">
                                    <TextBlock x:Name="CriticSensitivityBadgeText" Text="Standard" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="CriticModelBlock" Text="No model selected" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,8"/>
                            <ComboBox x:Name="CriticFormatCombo" SelectedIndex="0" Height="28" Margin="0,0,0,8">
                                <ComboBoxItem Content="ChatML"/>
                                <ComboBoxItem Content="Llama 3"/>
                                <ComboBoxItem Content="Alpaca"/>
                            </ComboBox>
                            <Button x:Name="LoadCriticModelButton" Content="Load Critic Model" Click="LoadCriticModel_Click" Height="32" Style="{StaticResource SubtleButtonStyle}"/>
                            <TextBlock Text="Critic Sensitivity" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,8,0,4"/>
                            <ComboBox x:Name="CriticSensitivityCombo" SelectionChanged="CriticSensitivityCombo_SelectionChanged" Height="26" SelectedIndex="0">
                                <ComboBoxItem Content="Standard"/>
                                <ComboBoxItem Content="Strict"/>
                                <ComboBoxItem Content="Critical Only"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Single Model -->
                    <Border x:Name="SingleModelModelCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Single Model" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SingleModelModelBlock" Text="No model selected" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,8"/>
                            <ComboBox x:Name="SingleModelFormatCombo" SelectedIndex="0" Height="28" Margin="0,0,0,8">
                                <ComboBoxItem Content="ChatML"/>
                                <ComboBoxItem Content="Llama 3"/>
                                <ComboBoxItem Content="Alpaca"/>
                                <ComboBoxItem Content="Gemma 4"/>
                            </ComboBox>
                            <Button x:Name="LoadSingleModelButton" Content="Load Single Model" Click="LoadSingleModel_Click" Height="32" Style="{StaticResource SubtleButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SingleModelContextCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Model Context" FontSize="11" FontWeight="SemiBold"/>
                            <Slider x:Name="SingleModelContextSlider" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" Value="8192" ValueChanged="SingleModelContextSlider_ValueChanged"/>
                            <TextBlock x:Name="SingleModelContextValueText" Text="8192 tokens" FontSize="10" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CouncilContextControlsCard" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="CouncilContextControlsTitle" Text="Role Context Controls" FontSize="11" FontWeight="SemiBold"/>
                            <CheckBox x:Name="AutoOptimizeContextToggle" Content="Auto optimize (model-aware)" IsChecked="True" Margin="0,8,0,8" Checked="AutoOptimizeContextToggle_Changed" Unchecked="AutoOptimizeContextToggle_Changed"/>

                            <!-- Cloud mode info panel (visible only when cloud council is active) -->
                            <TextBlock x:Name="CloudContextInfoBlock" Visibility="Collapsed" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>

                            <!-- Cloud sub-mode: OpenRouter vs self-hosted Hybrid Local (visible only when cloud council is active) -->
                            <Button x:Name="WorkplaceHybridToggleButton" Content="Use Hybrid Local (Kestral 1)" Click="WorkplaceHybridToggleButton_Click"
                                    Visibility="Collapsed" HorizontalAlignment="Left" FontSize="10" Padding="8,4" Margin="0,0,0,8"
                                    Style="{StaticResource SubtleButtonStyle}" ToolTip="Route the Council through your self-hosted endpoint instead of OpenRouter"/>

                            <!-- Local slider controls (hidden in cloud mode) -->
                            <StackPanel x:Name="ContextSlidersPanel">
                                <TextBlock Text="Global Context" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                <Slider x:Name="GlobalContextSlider" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" Value="8192" ValueChanged="GlobalContextSlider_ValueChanged"/>
                                <TextBlock x:Name="GlobalContextValueText" Text="8192 tokens" FontSize="10" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,2,0,8"/>

                                <TextBlock Text="Architect Context" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                <Slider x:Name="ArchitectContextSlider" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" Value="6144" ValueChanged="RoleContextSlider_ValueChanged"/>
                                <TextBlock x:Name="ArchitectContextValueText" Text="6144 tokens" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,6"/>

                                <TextBlock Text="Builder Context" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                <Slider x:Name="BuilderContextSlider" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" Value="8192" ValueChanged="RoleContextSlider_ValueChanged"/>
                                <TextBlock x:Name="BuilderContextValueText" Text="8192 tokens" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,6"/>

                                <TextBlock Text="Critic Context" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                <Slider x:Name="CriticContextSlider" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" Value="4096" ValueChanged="RoleContextSlider_ValueChanged"/>
                                <TextBlock x:Name="CriticContextValueText" Text="4096 tokens" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Rectangle Height="1" Fill="{DynamicResource NotebookBorderBrush}" Margin="0,16,0,16"/>

                    <!-- Computer Agent -->
                    <TextBlock Text="Computer Agent" FontSize="12" FontWeight="SemiBold"/>
                    <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Agent Access" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <Border x:Name="AgentStateBadge" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="6,1" Margin="6,0,0,0" DockPanel.Dock="Right">
                                    <TextBlock x:Name="AgentStateText" Text="Off" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="Lets the model run commands and read or change files on this computer, the way a terminal coding agent does." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                            <Button x:Name="AgentEnableButton" Content="Enable Computer Agent" Click="AgentEnableButton_Click" Height="32" Style="{StaticResource PremiumButtonStyle}"/>

                            <TextBlock Text="Scope" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <ComboBox x:Name="AgentScopeCombo" Height="30" SelectionChanged="AgentScopeCombo_SelectionChanged" IsEnabled="False"
                                      ToolTip="Which part of the computer the agent may touch">
                                <ComboBoxItem Content="A folder I choose" Tag="folder" IsSelected="True"/>
                                <ComboBoxItem Content="The entire computer" Tag="all"/>
                            </ComboBox>
                            <Button x:Name="AgentChooseFolderButton" Content="Choose Folder…" Click="AgentChooseFolderButton_Click" Height="30" Margin="0,6,0,0" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"/>
                            <TextBlock x:Name="AgentScopeDetailText" Text="No folder chosen yet." FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="Approval" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <UniformGrid Columns="2">
                                <Button x:Name="AgentManualModeButton" Content="Manual" Click="AgentApprovalMode_Click" Tag="manual" Height="30" Margin="0,0,3,0" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"
                                        ToolTip="Every command and file change waits for your approval"/>
                                <Button x:Name="AgentAutoModeButton" Content="Auto" Click="AgentApprovalMode_Click" Tag="auto" Height="30" Margin="3,0,0,0" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"
                                        ToolTip="The agent runs without stopping to ask"/>
                            </UniformGrid>
                            <TextBlock x:Name="AgentApprovalHintText" Text="Manual: you approve each command before it runs." FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Height="1" Fill="{DynamicResource NotebookBorderBrush}" Margin="0,16,0,16"/>

                    <Rectangle Height="1" Fill="{DynamicResource NotebookBorderBrush}" Margin="0,16,0,16"/>

                    <!-- Project Knowledge Base -->
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Project Knowledge Base" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="ProjectKnowledgeBaseButton" Content="Manage" Click="OpenProjectKnowledgeBase_Click" DockPanel.Dock="Right"
                                Style="{StaticResource SubtleButtonStyle}" Padding="8,3" FontSize="10"
                                ToolTip="View, add, or remove files kept with this Workplace project"/>
                    </DockPanel>
                    <TextBlock x:Name="ProjectKnowledgeBaseSummaryBlock" Text="No project files yet." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <Border x:Name="DropZone" Background="{DynamicResource NotebookBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource NotebookBorderBrush}"
                            CornerRadius="12" Padding="16" Margin="0,12,0,12" AllowDrop="True"
                            Drop="DropZone_Drop" DragOver="DropZone_DragOver">
                        <StackPanel>
                            <TextBlock Text="Drop files or a project folder here" FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Axiom keeps a project-owned copy and indexes extractable content." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <UniformGrid Columns="2">
                        <Button Content="+ Add files" Click="BrowseFiles_Click" Height="34" Margin="0,0,4,0" Style="{StaticResource PremiumButtonStyle}"/>
                        <Button Content="+ Add folder" Click="BrowseProjectFolder_Click" Height="34" Margin="4,0,0,0" Style="{StaticResource SubtleButtonStyle}"/>
                    </UniformGrid>

                    <Rectangle Height="1" Fill="{DynamicResource NotebookBorderBrush}" Margin="0,16,0,16"/>

                    <Expander Header="Task History" IsExpanded="False" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                                <Button Content="Clear History" Click="ClearTaskHistory_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" FontSize="10" Margin="0,0,6,0"/>
                                <Button Content="Compare Selected" Click="CompareTaskHistory_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" FontSize="10"/>
                            </StackPanel>
                            <ListBox x:Name="TaskHistoryListBox" Height="150" SelectionMode="Extended" SelectionChanged="TaskHistoryListBox_SelectionChanged"/>
                            <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,8,0,0">
                                <TextBlock x:Name="TaskHistoryDetailBlock" Text="Select a task history entry to view details." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Replay" Click="ReplayTaskHistory_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" FontSize="10" Margin="0,0,6,0"/>
                                <Button Content="Compare" Click="CompareTaskHistory_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Performance Log" IsExpanded="False" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="PerformanceAggregateBlock" Text="No runs logged yet." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap"/>
                            <Button Content="Export Log" Click="ExportPerformanceLog_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" FontSize="10" Margin="0,8,0,8"/>
                            <ListBox x:Name="PerformanceLogListBox" Height="130" SelectionChanged="PerformanceLogListBox_SelectionChanged"/>
                            <TextBlock x:Name="PerformanceLogDetailBlock" Text="" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Workspace Templates" IsExpanded="False" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                                <Button Content="Create New Template" Click="CreateWorkspaceTemplate_Click" Style="{StaticResource PremiumButtonStyle}" Padding="8,2" FontSize="10" Margin="0,0,6,0"/>
                                <Button Content="Delete" Click="DeleteWorkspaceTemplate_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" FontSize="10"/>
                            </StackPanel>
                            <ListBox x:Name="WorkspaceTemplateListBox" Height="120" SelectionChanged="WorkspaceTemplateListBox_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Load" Click="LoadWorkspaceTemplate_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" FontSize="10" Margin="0,0,6,0"/>
                                <Button Content="Edit" Click="EditWorkspaceTemplate_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Rectangle Height="1" Fill="{DynamicResource NotebookBorderBrush}" Margin="0,16,0,16" Visibility="Collapsed"/>

                    <!-- Semantic Memory -->
                    <TextBlock Text="Semantic Project Memory" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed"/>
                    <Border Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,12,0,0" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                            <ItemsControl x:Name="ConceptCloudItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayLabel}" Tag="{Binding Name}" Click="ConceptTag_Click"
                                                Margin="4" Padding="10,4" FontSize="10" Foreground="{DynamicResource NotebookTextBrush}"
                                                Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1"
                                                Style="{StaticResource SubtleButtonStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- CENTER — Header + Chat + Input              -->
        <!-- ═══════════════════════════════════════════ -->
        <DockPanel Grid.Column="1" Background="{DynamicResource NotebookBackgroundBrush}">
            <!-- Header bar: title + status chips. Chips replace the old dot-separated status
                 string, which read as one long mushed line once several statuses were active. -->
            <Border x:Name="WorkplaceHeaderBorder" DockPanel.Dock="Top" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,0,0,1" Padding="24,8" Background="{DynamicResource NotebookSurfaceBrush}"
                    SizeChanged="WorkplaceHeaderBorder_SizeChanged">
                <Border.Resources>
                    <!-- Status now reads as one quiet line rather than a grid of boxes. Each box
                         cost a border, padding and its own wrap row, so six of them pushed the
                         chat down by three lines' worth of chrome to say what fits on one. -->
                    <Style x:Key="HeaderStatusTextStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                    <Style x:Key="HeaderStatusSeparatorStyle" TargetType="TextBlock" BasedOn="{StaticResource HeaderStatusTextStyle}">
                        <Setter Property="Text" Value="·"/>
                        <Setter Property="Foreground" Value="{DynamicResource NotebookBorderBrush}"/>
                        <Setter Property="Margin" Value="7,0,7,0"/>
                    </Style>
                </Border.Resources>
                <DockPanel>
                    <!-- Context meters. Sit in the header beside the run status instead of taking a
                         row inside the composer. Width is fixed per role so the numbers updating
                         mid-run never shift the layout. When the header is too narrow to hold the
                         title and all meters side by side, UpdateHeaderMeterPlacement drops them
                         to their own row under the status line. -->
                    <Border x:Name="WorkplaceTokenUsagePanel"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            Padding="16,2,0,2"
                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                            BorderThickness="1,0,0,0"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Grid x:Name="ArchitectTokenUsageRow" Width="104" Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Architect" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                    <TextBlock x:Name="ArchitectTokenUsageLabel" Text="0 / 0" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                </DockPanel>
                                <ProgressBar x:Name="ArchitectTokenUsageProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Style="{StaticResource WorkplaceTokenMeterProgressBarStyle}"/>
                            </Grid>
                            <Grid x:Name="AgentTokenUsageRow" Width="104" Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="BuilderTokenUsageTitle" Text="Builder" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                    <TextBlock x:Name="BuilderTokenUsageLabel" Text="0 / 0" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                </DockPanel>
                                <ProgressBar x:Name="BuilderTokenUsageProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Style="{StaticResource WorkplaceTokenMeterProgressBarStyle}"/>
                            </Grid>
                            <Grid x:Name="CriticTokenUsageRow" Width="104">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Critic" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                    <TextBlock x:Name="CriticTokenUsageLabel" Text="0 / 0" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                </DockPanel>
                                <ProgressBar x:Name="CriticTokenUsageProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Style="{StaticResource WorkplaceTokenMeterProgressBarStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="Axiom Workplace" FontSize="17" FontFamily="Georgia" FontWeight="Normal" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PipelineProgressBlock" Text="" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="10,1,0,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <!-- One line, no boxes. The three statuses worth a glance stay visible; the
                             diagnostic ones are still live and still update, just behind the hover
                             tooltip instead of occupying permanent screen space. The last item
                             fills and trims so a narrow header ellipsizes instead of clipping. -->
                        <DockPanel ToolTipService.InitialShowDelay="250" Background="Transparent">
                            <DockPanel.ToolTip>
                                <StackPanel MaxWidth="420">
                                    <TextBlock x:Name="ContextInfoBlock" Text="Context: Ready" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource NotebookTextBrush}"/>
                                    <TextBlock x:Name="MemoryFocusBlock" Text="Memory: None" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="ContextPressureBlock" Text="Context pressure: --" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource NotebookTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel.ToolTip>
                            <TextBlock x:Name="RelayStatusBlock" DockPanel.Dock="Left" Text="Relay: Idle" Style="{StaticResource HeaderStatusTextStyle}" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource HeaderStatusSeparatorStyle}"/>
                            <TextBlock x:Name="TaskTypeBadgeText" DockPanel.Dock="Left" Text="General Task" Style="{StaticResource HeaderStatusTextStyle}"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource HeaderStatusSeparatorStyle}"/>
                            <TextBlock x:Name="HardwareInfoBlock" Text="Adaptive mode" Style="{StaticResource HeaderStatusTextStyle}" MaxWidth="320" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="WorkplaceErrorNotificationBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="24,8" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="WorkplaceErrorNotificationText" Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="11" FontFamily="Segoe UI"/>
            </Border>

            <!-- Run confidence banner. Previously lived at the bottom of the left sidebar where
                 DockPanel.Dock had no effect inside the StackPanel and the result was never seen. -->
            <Border x:Name="CouncilConfidenceBanner" DockPanel.Dock="Top" Visibility="Collapsed" Padding="24,8" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock x:Name="CouncilConfidenceText" Text="Confidence: Moderate" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="RefineButton" DockPanel.Dock="Right" Content="Refine" Click="RefineButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="10,2" FontSize="10" Margin="8,0,0,0" Visibility="Collapsed" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Composer: one flat card (no box-in-a-box) with a tighter radius. Prompt on top,
                 tool toggles on the left of the control row, Stop/Run on the right. Run status
                 lives in the header (Relay line + context meters), not in here. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="16,6,16,12">
                <Border x:Name="InputAreaContainer" CornerRadius="10" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" Padding="6" Background="{DynamicResource NotebookSurfaceBrush}"
                        AllowDrop="True" PreviewDragOver="InputAreaContainer_PreviewDragOver" PreviewDrop="InputAreaContainer_PreviewDrop">
                    <StackPanel>
                        <!-- Attachment preview tray: thumbnail chips for the files loaded into this
                             workplace, built in code-behind and numbered to match the prompt index. -->
                        <WrapPanel x:Name="WorkplaceAttachmentTrayPanel" Orientation="Horizontal"
                                   Margin="2,2,2,4" Visibility="Collapsed"/>
                        <!-- Approval gate: Manual mode parks the run here until the user answers. -->
                        <Border x:Name="AgentApprovalBar" Visibility="Collapsed" Background="{DynamicResource NotebookBackgroundBrush}"
                                BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock x:Name="AgentApprovalTitleText" Text="Run this command?" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                <TextBox x:Name="AgentApprovalDetailText" Text="" FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace"
                                         Margin="0,5,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         Foreground="{DynamicResource NotebookTextBrush}" MaxHeight="90" VerticalScrollBarVisibility="Auto"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="AgentApproveButton" Content="Approve" Click="AgentApprove_Click" Height="26" Padding="12,0" Style="{StaticResource PremiumButtonStyle}" FontSize="11"/>
                                    <Button x:Name="AgentApproveAlwaysButton" Content="Always allow this" Click="AgentApproveAlways_Click" Height="26" Padding="10,0" Margin="6,0,0,0" Style="{StaticResource SubtleButtonStyle}" FontSize="11"/>
                                    <Button x:Name="AgentDenyButton" Content="Deny" Click="AgentDeny_Click" Height="26" Padding="12,0" Margin="6,0,0,0" Style="{StaticResource SubtleButtonStyle}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quiet running-step line. Present only while a step is in flight. -->
                        <Border x:Name="AgentActivityLine" Visibility="Collapsed" HorizontalAlignment="Left"
                                Margin="8,0,8,5" Padding="8,3" CornerRadius="9"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="AgentActivityText" Text="" FontSize="10.5" FontWeight="Medium"
                                           Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource NotebookTextBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RefinementModeBanner" Visibility="Collapsed" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                            <TextBlock Text="Refinement Mode" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock x:Name="RevisionNoticeBlock" Margin="8,2,8,2" Text="Issues were found and the output was revised." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource DarkSecondaryBrush}" Visibility="Collapsed"/>

                        <Grid>
                            <!-- Starts at about two lines and grows with the prompt up to MaxHeight,
                                 then scrolls. -->
                            <avalonedit:TextEditor x:Name="QueryInput"
                                     Background="Transparent" Foreground="{DynamicResource NotebookTextBrush}"
                                     FontFamily="Segoe UI" FontSize="13" KeyDown="QueryInput_KeyDown" PreviewKeyDown="QueryInput_PreviewKeyDown"
                                     WordWrap="True" ShowLineNumbers="False"
                                     HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                     Margin="8,6,8,4" MinHeight="40" MaxHeight="168"/>
                            <Popup x:Name="WorkplaceMentionPopup"
                                   Placement="Top"
                                   PlacementTarget="{Binding ElementName=QueryInput}"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   HorizontalOffset="8"
                                   VerticalOffset="-6">
                                <Border Background="{DynamicResource NotebookSurfaceBrush}"
                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6"
                                        MinWidth="240"
                                        MaxWidth="340"
                                        MaxHeight="180">
                                    <ListBox x:Name="WorkplaceMentionList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontFamily="Segoe UI"
                                             FontSize="13"
                                             Foreground="{DynamicResource NotebookTextBrush}"
                                             MouseLeftButtonUp="WorkplaceMentionList_MouseLeftButtonUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,4">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#D5DAD3"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Items carry 2px vertical margin so that, when a narrow column forces the
                             tool toggles to wrap, the rows keep a gap instead of touching. -->
                        <DockPanel Margin="0,0,0,-2">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,2,0,2">
                                <Button x:Name="StopButton" Content="⏹ Stop" Click="StopMessage_Click" Width="64" Height="30" Padding="8,2"
                                        Style="{StaticResource SubtleButtonStyle}" Foreground="{DynamicResource PrimaryAccentBrush}" IsEnabled="False" Margin="0,0,6,0"/>
                                <Button x:Name="SendButton" Content="Run Council" Click="SendMessage_Click" Width="94" Height="30" Padding="8,2"
                                        Style="{StaticResource PremiumButtonStyle}"/>
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="WorkplaceCloudModeButton" Content="Cloud Off" Click="WorkplaceCloudModeButton_Click" Width="78" Height="30" Padding="8,2"
                                        Style="{StaticResource SubtleButtonStyle}" Margin="0,2,6,2" ToolTip="Use local council models"/>
                                <Button x:Name="WebSearchToggleButton" Content="Web" Click="WebSearchToggleButton_Click" Width="46" Height="30" Padding="8,2"
                                        Style="{StaticResource SubtleButtonStyle}" Margin="0,2,6,2" ToolTip="Web Search tool enabled"/>
                                <Button x:Name="WorkplaceSkillsButton" Click="WorkplaceOpenSkills_Click" MinWidth="72" Height="30" Padding="9,2"
                                        Style="{StaticResource SubtleButtonStyle}" Margin="0,2,6,2" ToolTip="Attach reusable Skills to every Axiom model and mode">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Skills" VerticalAlignment="Center"/>
                                        <Border x:Name="WorkplaceSkillsBadge" Margin="6,0,0,0" Padding="5,1" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed">
                                            <TextBlock x:Name="WorkplaceSkillsCountText" Text="0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentMutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CouncilPetToggleButton" Content="Bit" Click="CouncilPetToggleButton_Click" Width="42" Height="30" Padding="8,2"
                                        Style="{StaticResource SubtleButtonStyle}" Margin="0,2,6,2" ToolTip="Show the draggable Council Bit status companion"/>
                                <local:EffortSelector x:Name="WorkplaceEffortSelector" Height="30" Margin="0,2,6,2" VerticalAlignment="Center"/>
                                <Button x:Name="WorkplaceAttachFileButton" Width="30" Height="30" Margin="0,2,6,2" Click="WorkplaceAttachFileButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="0" AutomationProperties.Name="Attach files" ToolTip="Attach files (documents, spreadsheets, presentations, e-books, code, images)">
                                    <Path Width="13" Height="13" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M6,0 L8,0 L8,6 L14,6 L14,8 L8,8 L8,14 L6,14 L6,8 L0,8 L0,6 L6,6 Z"/>
                                </Button>

                                <!-- Zero-size while closed, so they sit in the toggle row without affecting its layout. -->
                                <Popup x:Name="WorkplaceSkillsPopup" Placement="Top" PlacementTarget="{Binding ElementName=WorkplaceSkillsButton}"
                                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" VerticalOffset="-10"
                                       Opened="WorkplaceSkillsPopup_Opened">
                                    <Border x:Name="WorkplaceSkillsFlyoutCard" Width="500" MaxHeight="520" Padding="18" Background="{DynamicResource NotebookSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16" Effect="{StaticResource SoftShadow}">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Skills" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
                                                    <TextBlock x:Name="WorkplaceSkillsSummaryText" Text="Reusable procedures for specialized work" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource DarkSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Width="28" Height="28" Padding="0" Click="WorkplaceCloseSkills_Click" Style="{StaticResource SubtleButtonStyle}" ToolTip="Close">
                                                    <TextBlock Text="&#215;" FontSize="16" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Margin="0,12,0,12" Text="Skills are attached globally: the same choice applies in Normal Chat and here, across Council and Single Model runs. Skills that render a deliverable send it to the Builder's Project Canvas." TextWrapping="Wrap" FontSize="11" LineHeight="16" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <ScrollViewer Grid.Row="2" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="WorkplaceSkillsListPanel"/>
                                            </ScrollViewer>
                                            <Button Grid.Row="3" Margin="0,14,0,0" Height="38" Click="WorkplaceCreateCustomSkill_Click" Background="{DynamicResource PrimaryAccentBrush}" Foreground="{DynamicResource NotebookBackgroundBrush}" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Content="&#65291;  Create custom Skill"/>
                                        </Grid>
                                    </Border>
                                </Popup>

                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="Architect and Critic reply in chat — the Builder's deliverable renders in the Project Canvas" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="6,6,6,0"/>
            </StackPanel>

            <!-- System notifications dropdown (compact, non-intrusive) -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,0,0,1" Padding="12,4">
                <DockPanel>
                    <Button x:Name="NotificationToggleButton" Click="NotificationToggle_Click" DockPanel.Dock="Left" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="22">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▸" x:Name="NotificationToggleArrow" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="System Log" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="NotificationBadge" Background="{DynamicResource PrimaryAccentBrush}" CornerRadius="7" MinWidth="14" Height="14" Margin="6,0,0,0" Padding="3,0" Visibility="Collapsed">
                                <TextBlock x:Name="NotificationBadgeText" Text="0" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Content="Clear" Click="ClearNotifications_Click" DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" Padding="6,1" FontSize="9" Height="20" Margin="0,0,2,0"/>
                </DockPanel>
            </Border>
            <Border x:Name="NotificationDropdownPanel" DockPanel.Dock="Top" Visibility="Collapsed" MaxHeight="180" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,0,0,1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                    <ItemsControl x:Name="NotificationList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,1" Padding="8,4" CornerRadius="6"
                                        Background="{Binding CardBackground}"
                                        BorderBrush="{Binding AccentBrush}" BorderThickness="2,0,0,0">
                                    <DockPanel>
                                        <TextBlock Text="{Binding TimestampLabel}" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Top" Width="52" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding RoleLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Top" Width="46" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FormattedContent}" TextWrapping="Wrap" FontSize="10" FontFamily="Segoe UI" Foreground="{DynamicResource DarkSecondaryBrush}" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- Agentic Pause live status bar                              -->
            <!-- Floats just above the chat area; collapsed when idle.      -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border x:Name="AgenticPauseBanner"
                    DockPanel.Dock="Top"
                    Visibility="Collapsed"
                    Opacity="0"
                    Padding="14,5,14,5"
                    Background="{DynamicResource NotebookBackgroundBrush}"
                    BorderBrush="{DynamicResource PrimaryAccentBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Left: animated pulse dot (accent gold — this is activity, not an error) -->
                    <Border x:Name="AgenticPulseDot"
                            Width="7" Height="7"
                            CornerRadius="4"
                            Background="{DynamicResource PrimaryAccentBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            DockPanel.Dock="Left"/>
                    <!-- Right: pause budget indicator (e.g. 2/3) -->
                    <Border Background="{DynamicResource NotebookSurfaceBrush}"
                            BorderBrush="{DynamicResource NotebookBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,2"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right">
                        <TextBlock x:Name="AgenticPauseBudgetText"
                                   Text="0 / 3"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Centre: descriptive status text -->
                    <TextBlock x:Name="AgenticPauseStatusBlock"
                               Text=""
                               FontSize="10"
                               FontStyle="Italic"
                               Foreground="{DynamicResource NotebookTextBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Opacity="1"
                               Visibility="Visible"/>
                </DockPanel>
            </Border>

            <!-- Chat display (fills remaining space — shows only user/architect/builder/critic/sandbox) -->
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource NotebookBackgroundBrush}" Padding="16,14" PreviewMouseWheel="ChatScrollViewer_PreviewMouseWheel">
                <StackPanel>
                <Button x:Name="ShowEarlierWorkplaceMessagesButton"
                        Content="Show earlier messages"
                        Click="ShowEarlierWorkplaceMessages_Click"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8"
                        Padding="12,5"
                        FontSize="10"
                        Foreground="{DynamicResource DarkSecondaryBrush}"
                        Style="{StaticResource SubtleButtonStyle}"/>
                <ItemsControl x:Name="ChatCardsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card: soft surface with a slim rounded role-accent rail on the left.
                                 Cards get real vertical separation and inner breathing room so the
                                 relay reads as distinct turns instead of a stacked wall of text. -->
                            <Border Margin="0,5" CornerRadius="12"
                                    Background="{Binding CardBackground}"
                                    BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{Binding AccentBrush}" Margin="10,12,0,12"/>
                                    <StackPanel Grid.Column="1" Margin="12,10,14,11">
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding RoleLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                            <Button x:Name="CopyWorkplaceMessageButton" Content="Copy" Click="CopyWorkplaceMessage_Click" Tag="{Binding}" FontSize="9" Padding="8,2" DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TimestampLabel}" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <local:ShimmerTextBlock x:Name="WorkplaceCardGenerationStatusText"
                                                                Text="{Binding GenerationStatusText}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                BaseColor="#A1A1AA"
                                                                HighlightColor="#FFFFFF"
                                                                ShimmerDurationSeconds="2"
                                                                TextTrimming="CharacterEllipsis"
                                                                Visibility="Collapsed"/>
                                        <!-- Native markdown rendering (headings, lists, code) inside the
                                             redesigned card layout. -->
                                        <FlowDocumentScrollViewer x:Name="WorkplaceCardContentText"
                                                                  Document="{Binding FormattedDocument}"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  Padding="0"
                                                                  FontSize="12.5"
                                                                  FontFamily="Segoe UI"
                                                                  Foreground="{DynamicResource NotebookTextBrush}"
                                                                  IsToolBarVisible="False"
                                                                  VerticalScrollBarVisibility="Disabled"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  IsTabStop="False"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="user">
                                    <Setter TargetName="CopyWorkplaceMessageButton" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowGeneratingStatusInCard}" Value="True">
                                    <Setter TargetName="WorkplaceCardGenerationStatusText" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="WorkplaceCardContentText" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGeneratingStatus}" Value="True">
                                    <Setter TargetName="WorkplaceCardContentText" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ═══════════════════════════════════════════ -->
        <!-- RIGHT — Project Canvas                      -->
        <!-- ═══════════════════════════════════════════ -->
        <!-- No collapsed rail: when hidden, the canvas takes no width at all and is reopened from
             the Project Canvas toggle in the main window's tab bar. -->
        <Border x:Name="ProjectCanvasPane" Grid.Column="2" MinWidth="320" MaxWidth="640" Width="500" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1,0,0,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Canvas header -->
                <Border Grid.Row="0" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock x:Name="CanvasTitleBlock" Text="Project Canvas" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="CanvasSubtitleBlock" Text="Builder output rendered here." FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="CanvasDiffSummaryBlock" Text="" FontSize="9" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel x:Name="CanvasArtifactTogglePanel" Orientation="Horizontal" Margin="0,0,8,0" Visibility="Collapsed">
                                <Button x:Name="CanvasCodeViewButton" Content="Code" Click="CanvasCodeViewButton_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" MinWidth="58" Height="30" Padding="10,0" Margin="0,0,4,0"/>
                                <Button x:Name="CanvasPreviewViewButton" Content="Preview" Click="CanvasPreviewViewButton_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" MinWidth="78" Height="30" Padding="12,0"/>
                            </StackPanel>
                            <Button x:Name="CopyCanvasButton" Click="CopyCanvasButton_Click" Style="{StaticResource PanelToggleButtonStyle}" ToolTip="Copy to clipboard" Margin="0,0,8,0" Width="30" Height="30">
                                <Canvas Width="14" Height="14">
                                    <Rectangle Canvas.Left="0" Canvas.Top="3" Width="9" Height="9" Stroke="{DynamicResource DarkSecondaryBrush}" StrokeThickness="1.4" RadiusX="1.5" RadiusY="1.5"/>
                                    <Rectangle Canvas.Left="4" Canvas.Top="0" Width="9" Height="9" Stroke="{DynamicResource NotebookTextBrush}" StrokeThickness="1.4" Fill="{DynamicResource NotebookBackgroundBrush}" RadiusX="1.5" RadiusY="1.5"/>
                                </Canvas>
                            </Button>
                            <Button x:Name="RunCodeButton" Content="▶ Run" Margin="0,0,8,0" Click="RunCodeButton_Click" Style="{StaticResource PremiumButtonStyle}" FontSize="10" MinWidth="72" Height="30" Padding="10,0" ToolTip="Execute code in sandbox"/>
                            <Button x:Name="ShowDiffButton" Content="Diff" Margin="0,0,8,0" Click="ShowDiffButton_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" MinWidth="52" Height="30" Padding="10,0" ToolTip="Compare the current canvas source with its previous generated version" Visibility="Collapsed"/>
                            <Button x:Name="CodeOutputToggleButton" Content="⌄" Margin="0,0,8,0" Click="CodeOutputToggleButton_Click" Style="{StaticResource PanelToggleButtonStyle}" ToolTip="Hide code output" Width="30" Height="30"/>
                            <Button x:Name="UndoCodebaseChangesButton" Content="Undo" Margin="0,0,8,0" Click="UndoCodebaseChanges_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" MinWidth="62" Height="30" Padding="10,0" ToolTip="Undo the last applied codebase patch" Visibility="Collapsed" IsEnabled="False"/>
                            <Button x:Name="AcceptCodebaseChangesButton" Content="Accept" Margin="0,0,8,0" Click="AcceptCodebaseChanges_Click" Style="{StaticResource PremiumButtonStyle}" FontSize="10" MinWidth="64" Height="30" Padding="10,0" ToolTip="Accept proposed codebase changes" Visibility="Collapsed" IsEnabled="False"/>
                            <Button x:Name="RejectCodebaseChangesButton" Content="Reject" Margin="0,0,8,0" Click="RejectCodebaseChanges_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" MinWidth="62" Height="30" Padding="10,0" ToolTip="Reject proposed codebase changes" Visibility="Collapsed" IsEnabled="False"/>
                            <Button x:Name="CanvasMoreActionsButton" Content="..." Margin="0,0,8,0" Click="CanvasMoreActionsButton_Click" Style="{StaticResource PanelToggleButtonStyle}" ToolTip="More canvas actions" Width="30" Height="30" Visibility="Collapsed">
                                <Button.ContextMenu>
                                    <ContextMenu Background="{DynamicResource NotebookBackgroundBrush}"
                                                 BorderBrush="{DynamicResource NotebookBorderBrush}"
                                                 Foreground="{DynamicResource NotebookTextBrush}"
                                                 BorderThickness="1"
                                                 Padding="4">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="{x:Type MenuItem}">
                                                <Setter Property="Background" Value="{DynamicResource NotebookBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
                                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="12,7"/>
                                                <Setter Property="MinWidth" Value="132"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type MenuItem}">
                                                            <Border x:Name="MenuItemBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    SnapsToDevicePixels="True">
                                                                <ContentPresenter ContentSource="Header"
                                                                                  RecognizesAccessKey="True"
                                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsHighlighted" Value="True">
                                                                    <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="MenuItemBorder" Property="Opacity" Value="0.45"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                        <MenuItem x:Name="CanvasMoreCopyItem" Header="Copy source" Click="CanvasMoreCopyItem_Click"/>
                                        <MenuItem x:Name="CanvasMoreDiffItem" Header="Show diff" Click="CanvasMoreDiffItem_Click"/>
                                        <MenuItem x:Name="CanvasMoreOutputItem" Header="Hide output" Click="CanvasMoreOutputItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="ProjectCanvasToggleButton" Content="›" Click="ProjectCanvasToggleButton_Click" Style="{StaticResource PanelToggleButtonStyle}" ToolTip="Hide project canvas" Width="30" Height="30"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Code editor -->
                <Border x:Name="CodeOutputPanel" Grid.Row="1" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <avalonedit:TextEditor x:Name="ProjectCanvasEditor"
                                           Background="{DynamicResource NotebookBackgroundBrush}"
                                           Foreground="{DynamicResource NotebookTextBrush}"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           ShowLineNumbers="True"
                                           IsReadOnly="True"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"/>
                        <Grid x:Name="CanvasArtifactPreviewHost" Visibility="Collapsed" Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <wv2:WebView2 x:Name="CanvasArtifactWebView"
                                          Grid.Row="0"
                                          DefaultBackgroundColor="#00000000"
                                          Margin="0"
                                          Visibility="Visible"/>
                            <Border Grid.Row="1" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="CopyCanvasArtifactSourceButton" Content="Copy Source" Click="CopyCanvasArtifactSourceButton_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,0,8,0" Padding="8,2"/>
                                    <Button x:Name="SaveCanvasArtifactButton" Content="Save" Click="SaveCanvasArtifactButton_Click" Style="{StaticResource SubtleButtonStyle}" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" Padding="8,2"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ScrollViewer x:Name="DiffViewerScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource NotebookBackgroundBrush}">
                            <ItemsControl x:Name="DiffViewerLines">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Project-scoped attachment manager.  It intentionally lives above the workspace grid so
             it behaves as a focused screen rather than another narrow sidebar list. -->
        <Popup x:Name="ProjectKnowledgeBasePopup" Placement="Center" PlacementTarget="{Binding ElementName=ProjectKnowledgeBaseButton}"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="720" Height="520" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="Project Knowledge Base" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProjectKnowledgeBaseDialogSummaryBlock" Text="Files are retained with this Workplace project." FontSize="11"
                                       Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="×" Click="CloseProjectKnowledgeBase_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="28" FontSize="16" Style="{StaticResource SubtleButtonStyle}" ToolTip="Close"/>
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,16,0,12" LastChildFill="False">
                        <Button Content="+ Files" Click="BrowseFiles_Click" Padding="12,5" Margin="0,0,8,0" Style="{StaticResource PremiumButtonStyle}"/>
                        <Button Content="+ Folder" Click="BrowseProjectFolder_Click" Padding="12,5" Style="{StaticResource SubtleButtonStyle}"/>
                        <TextBlock Text="All file types are retained; unsupported binaries remain attached as metadata." DockPanel.Dock="Right"
                                   FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Width="290" TextAlignment="Right"/>
                    </DockPanel>

                    <Border Grid.Row="2" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ListBox x:Name="ProjectKnowledgeDocumentListBox" Background="Transparent" BorderThickness="0" Padding="8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource NotebookBackgroundBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Type}" FontSize="8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding RelativePath}" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Info}" FontSize="10" Foreground="{DynamicResource DarkSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="×" Tag="{Binding}" Click="RemoveProjectKnowledgeDocument_Click" Width="24" Height="24" Padding="0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SubtleButtonStyle}" ToolTip="Remove this file from the project"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Grid.Row="3" Text="Retrieved passages are cited by file and chunk in the model context." FontSize="10"
                               Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
