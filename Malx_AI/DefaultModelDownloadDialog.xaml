<Window x:Class="Malx_AI.DefaultModelDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download recommended model"
        Width="560" Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="{DynamicResource NotebookBackgroundBrush}"
        Foreground="{DynamicResource NotebookTextBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="{DynamicResource NotebookSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="BorderBrush" Value="#4A4641"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Margin="20" Padding="22" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="RecommendedModelNameText" Grid.Row="0" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}"/>
            <TextBlock x:Name="RecommendedModelDescriptionText" Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DarkSecondaryBrush}"/>
            <TextBlock x:Name="RecommendationReasonText" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>

            <ProgressBar x:Name="DownloadProgressBar" Grid.Row="3" Height="12" Margin="0,24,0,0"
                         Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource PrimaryAccentBrush}" Background="{DynamicResource NotebookBorderBrush}"/>
            <TextBlock x:Name="DownloadProgressText" Grid.Row="4" Margin="0,9,0,0" Foreground="{DynamicResource DarkSecondaryBrush}"
                       Text="Ready to download."/>
            <TextBlock x:Name="DownloadErrorText" Grid.Row="5" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="#C96A5B" Visibility="Collapsed"/>

            <StackPanel Grid.Row="6" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelDownloadButton" Content="Not now" Click="CancelDownloadButton_Click" Margin="0,0,10,0"/>
                <Button x:Name="StartDownloadButton" Content="Download recommended model" Click="StartDownloadButton_Click"
                        MinWidth="190" Background="{DynamicResource PrimaryAccentBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" Foreground="{DynamicResource NotebookBackgroundBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
