<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- Fresh repo-local output each publish. Do not target Downloads or any folder that
         may already contain developer runtime leftovers from previous app launches. -->
    <PublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\Axiom-Release\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Single-file publish breaks WinAppSDK SxS activation on startup
         (SessionHandleIPCProxyStub.dll duplicate name). Ship a self-contained folder. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Wipe the publish folder before each publish so no leftover chats/settings/files
         from a prior package or local run can ride along into the next zip. -->
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>