<UserControl x:Class="Malx_AI.WorkplaceChangeSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppUiFont}" FontSize="13" SizeChanged="Summary_SizeChanged"
             Foreground="{DynamicResource NotebookTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="SummaryAction" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AxiomFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border CornerRadius="11" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1">
        <StackPanel>
            <Grid Margin="12,11">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource NotebookBackgroundBrush}" VerticalAlignment="Center">
                    <Canvas Width="19" Height="20">
                        <Path Data="M4,1 L14,1 Q17,1 17,4 L17,16 Q17,19 14,19 L4,19 Q1,19 1,16 L1,4 Q1,1 4,1 Z M9,5 L9,13 M5,9 L13,9"
                              Stroke="{DynamicResource DarkSecondaryBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Border>
                <StackPanel x:Name="SummaryHeading" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" ToolTip="{Binding FileChangesScope}">
                    <TextBlock Text="{Binding FileChangesTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding AddedLinesLabel}" FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="{Binding RemovedLinesLabel}" FontSize="12" Foreground="{DynamicResource DangerBrush}" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="SummaryActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="UndoSummaryButton" Style="{StaticResource SummaryAction}" Click="Undo_Click" Margin="0,0,6,0"
                            Visibility="{Binding CanUndoFileChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Undo the latest recorded file-tool changes. Files edited afterward are left alone." AutomationProperties.Name="Undo recorded file changes">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Undo" FontSize="13"/><TextBlock Text="↶" FontSize="13" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="ReviewChangesButton" Style="{StaticResource SummaryAction}" Content="View changes" Click="Review_Click"
                            BorderBrush="{DynamicResource NotebookBorderBrush}" Background="{DynamicResource NotebookBackgroundBrush}"
                            AutomationProperties.Name="View recorded file changes"/>
                </StackPanel>
            </Grid>
            <Border BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="0,1,0,0" Padding="4,3,4,5">
                <StackPanel>
                    <ItemsControl x:Name="ChangedFilesList" ItemsSource="{Binding VisibleFileChanges}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SummaryAction}" Click="File_Click" Tag="{Binding}" Padding="8,7"
                                        HorizontalContentAlignment="Stretch" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding DisplayPath}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayPath}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="CanvasOpenHint" Text="Open formatted preview in Project Canvas" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrightBrush}" TextDecorations="Underline" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding CountsDescription}">
                                            <TextBlock Text="{Binding AddedLabel}" FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                                            <TextBlock Text="{Binding RemovedLabel}" FontSize="12" Foreground="{DynamicResource DangerBrush}" Margin="4,0,0,0"/>
                                            <TextBlock x:Name="UnknownCounts" Text="Not counted" Foreground="{DynamicResource DarkSecondaryBrush}" Visibility="Collapsed" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Additions}" Value="{x:Null}"><Setter TargetName="UnknownCounts" Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Canvas"><Setter TargetName="CanvasOpenHint" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Deleted"><Setter TargetName="CanvasOpenHint" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="MoreFilesButton" Style="{StaticResource SummaryAction}" Content="{Binding MoreFileChangesLabel}" Click="More_Click"
                            Margin="0,2,0,0" Visibility="{Binding HasMoreFileChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
