<UserControl x:Class="Malx_AI.EffortSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="116" Height="34">
    <UserControl.Resources>
        <Style x:Key="ComposerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource NotebookBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="ToggleButton" Style="{StaticResource ComposerButtonStyle}" Padding="9,0" Click="ToggleButton_Click" ToolTip="Choose response effort">
            <Grid x:Name="ToggleContentGrid" MinWidth="94">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="7" Height="7" Margin="0,0,7,0" Background="{DynamicResource PrimaryAccentBrush}" CornerRadius="3.5" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="EffortCaptionText" Text="Effort" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EffortCaptionSeparator" Text="·" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ButtonLevelText" Text="Medium" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Path Grid.Column="2" Margin="7,0,0,0" Width="8" Height="5" Fill="{DynamicResource AccentMutedBrush}" Data="M0,0 L8,0 L4,4.5 Z" VerticalAlignment="Center"/>
            </Grid>
        </Button>

        <Popup x:Name="EffortPopup" Placement="Top" PlacementTarget="{Binding ElementName=ToggleButton}" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
            <Border x:Name="PopupBorder" Width="286" Height="200" Padding="13,12" Background="{DynamicResource NotebookSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="13">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Effort" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="CloseButton" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close effort controls">
                            <Path Width="11" Height="11" Stroke="{DynamicResource DarkSecondaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L10,10 M10,1 L1,10"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Height="58" Margin="0,9,0,0" Padding="10,7" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource NotebookBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <Border x:Name="LevelAccent" Width="6" Height="30" Background="{DynamicResource PrimaryAccentBrush}" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <StackPanel Margin="14,0,18,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LevelText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentMutedBrush}"/>
                                <TextBlock x:Name="LevelDescription" FontSize="9.5" Foreground="{DynamicResource DarkSecondaryBrush}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" x:Name="SliderSurface" Height="38" Margin="0,10,0,0" SizeChanged="SliderSurface_SizeChanged">
                        <Border Background="{DynamicResource NotebookBorderBrush}" CornerRadius="19"/>
                        <Border x:Name="FillTrack" Background="{DynamicResource PrimaryAccentBrush}" HorizontalAlignment="Left" CornerRadius="19"/>
                        <Canvas IsHitTestVisible="False">
                            <Path x:Name="UltraTexture" Data="M12,24 L30,13 L48,25 L66,12 L84,24 L102,13 L120,25 L138,12 L156,24 L174,13 L192,25 L210,12 L228,24" Stroke="{DynamicResource AccentBrightBrush}" StrokeThickness="1.2" Opacity="0"/>
                        </Canvas>
                        <UniformGrid Columns="5" IsHitTestVisible="False">
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </UniformGrid>
                        <Ellipse x:Name="Thumb" Width="30" Height="30" Fill="{DynamicResource NotebookTextBrush}" Stroke="{DynamicResource AccentBrightBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Border x:Name="SliderHitTarget" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonDown="SliderHitTarget_MouseLeftButtonDown"
                                MouseMove="SliderHitTarget_MouseMove"
                                MouseLeftButtonUp="SliderHitTarget_MouseLeftButtonUp"
                                LostMouseCapture="SliderHitTarget_LostMouseCapture"/>
                    </Grid>
                    <UniformGrid Grid.Row="3" Columns="5" Margin="0,5,0,0" IsHitTestVisible="False">
                        <TextBlock Text="Light" FontSize="8" Foreground="{DynamicResource DarkSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Medium" FontSize="8" Foreground="{DynamicResource DarkSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="High" FontSize="8" Foreground="{DynamicResource DarkSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Extra High" FontSize="8" Foreground="{DynamicResource DarkSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ultra" FontSize="8" Foreground="{DynamicResource AccentMutedBrush}" HorizontalAlignment="Center"/>
                    </UniformGrid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
