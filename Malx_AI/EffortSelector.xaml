<UserControl x:Class="Malx_AI.EffortSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="96" Height="28">
    <UserControl.Resources>
        <Style x:Key="EffortTriggerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotebookBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EffortOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NotebookTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OptionShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionShell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="ToggleButton"
                Style="{StaticResource EffortTriggerButtonStyle}"
                Padding="8,0"
                PreviewMouseLeftButtonDown="ToggleButton_PreviewMouseLeftButtonDown"
                Click="ToggleButton_Click"
                ToolTip="Choose reasoning &amp; verification effort">
            <Grid x:Name="ToggleContentGrid" MinWidth="78">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 5-bar signal level glyph -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False">
                    <Border x:Name="Bar1" Width="2.5" Height="4" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,1.5,0" Background="{DynamicResource PrimaryAccentBrush}"/>
                    <Border x:Name="Bar2" Width="2.5" Height="6" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,1.5,0" Background="{DynamicResource PrimaryAccentBrush}"/>
                    <Border x:Name="Bar3" Width="2.5" Height="8" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,1.5,0" Background="{DynamicResource BorderStrongBrush}"/>
                    <Border x:Name="Bar4" Width="2.5" Height="10" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,1.5,0" Background="{DynamicResource BorderStrongBrush}"/>
                    <Border x:Name="Bar5" Width="2.5" Height="12" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderStrongBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="EffortCaptionText" Text="Effort" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource DarkSecondaryBrush}" VerticalAlignment="Center" LineHeight="14"/>
                    <TextBlock x:Name="EffortCaptionSeparator" Text="·" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="4,0" VerticalAlignment="Center" LineHeight="14"/>
                    <TextBlock x:Name="ButtonLevelText" Text="Medium" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" VerticalAlignment="Center" LineHeight="14"/>
                </StackPanel>

                <Path Grid.Column="2" Margin="6,1,0,0" Width="7" Height="4.5" Stretch="Uniform" Fill="{DynamicResource MutedTextBrush}" Data="M0,0 L8,0 L4,4.5 Z" VerticalAlignment="Center"/>
            </Grid>
        </Button>

        <Popup x:Name="EffortPopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=ToggleButton}"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               VerticalOffset="-6">
            <Border x:Name="PopupBorder"
                    Width="276"
                    Padding="10,9"
                    Background="{DynamicResource NotebookSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.45"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="2,0,0,6">
                        <TextBlock Text="Effort" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" VerticalAlignment="Center" LineHeight="16"/>
                        <Button x:Name="CloseButton" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close effort controls">
                            <Path Width="9" Height="9" Stroke="{DynamicResource DarkSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L8,8 M8,1 L1,8"/>
                        </Button>
                    </Grid>

                    <Button x:Name="OptionLight" Tag="0" Style="{StaticResource EffortOptionButtonStyle}" Click="OptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Light" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" LineHeight="15"/>
                                <TextBlock Text="Quick answers, fewer tool rounds" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" LineHeight="14"/>
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" Padding="6,2" CornerRadius="4" Background="{DynamicResource SurfaceSunkenBrush}">
                                <TextBlock Text="Builder" FontSize="9.5" Foreground="{DynamicResource DarkSecondaryBrush}" LineHeight="12"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="OptionMedium" Tag="1" Style="{StaticResource EffortOptionButtonStyle}" Click="OptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Medium" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" LineHeight="15"/>
                                <TextBlock Text="Balanced default" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" LineHeight="14"/>
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" Padding="6,2" CornerRadius="4" Background="{DynamicResource SurfaceSunkenBrush}">
                                <TextBlock Text="Builder" FontSize="9.5" Foreground="{DynamicResource DarkSecondaryBrush}" LineHeight="12"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="OptionHigh" Tag="2" Style="{StaticResource EffortOptionButtonStyle}" Click="OptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="High" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" LineHeight="15"/>
                                <TextBlock Text="Thinks first, more tool rounds" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" LineHeight="14"/>
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" Padding="6,2" CornerRadius="4" Background="{DynamicResource SurfaceSunkenBrush}">
                                <TextBlock Text="Builder" FontSize="9.5" Foreground="{DynamicResource DarkSecondaryBrush}" LineHeight="12"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="OptionExtraHigh" Tag="3" Style="{StaticResource EffortOptionButtonStyle}" Click="OptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Extra High" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource NotebookTextBrush}" LineHeight="15"/>
                                <TextBlock Text="Longer thinking, more steps, Critic check" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" LineHeight="14"/>
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" Padding="6,2" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="Builder + Critic" FontSize="9.5" Foreground="{DynamicResource AccentMutedBrush}" LineHeight="12"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="OptionUltra" Tag="4" Style="{StaticResource EffortOptionButtonStyle}" Click="OptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ultra" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" LineHeight="15"/>
                                <TextBlock Text="Longest runs; uses the most cloud credit" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" LineHeight="14"/>
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" Padding="6,2" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="Builder + Critic" FontSize="9.5" Foreground="{DynamicResource AccentBrightBrush}" LineHeight="12"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
